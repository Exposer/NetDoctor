# 安装: brew bundle --file=Brewfile
# --- 连通性 / 路由 ---
brew "mtr"            # traceroute + ping 合体,定位丢包跳点
brew "iperf3"         # 两端带宽测试
brew "fping"          # 批量 ping
brew "nmap"           # 端口扫描 / 服务探测 (含 ncat)
brew "gping"          # 带图形的 ping
brew "trippy"         # 现代化 traceroute TUI
# --- DNS ---
brew "bind"           # dig / nslookup / host
brew "doggo"          # 友好的 DNS 客户端
# --- HTTP / TLS ---
brew "curl"
brew "httpie"         # 友好的 HTTP 客户端 (命令: http)
brew "openssl@3"
brew "testssl"        # TLS 配置全面体检
# --- 抓包 / 流量 ---
brew "termshark"      # 终端版 wireshark
brew "tcpdump"
brew "ngrep"
brew "bandwhich"      # 按进程看带宽 (需 sudo)
brew "iftop"          # 按连接看带宽 (需 sudo)
# --- 杂项 ---
brew "whois"
brew "speedtest-cli"
brew "jq"
cask "wireshark"      # GUI + tshark
