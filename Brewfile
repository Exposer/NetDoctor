# Install: brew bundle --file=Brewfile
# --- Connectivity / routing ---
brew "iperf3"         # two-ended bandwidth test
brew "fping"          # ping many hosts at once
brew "nmap"           # port scan / service probing (includes ncat)
brew "gping"          # ping with a graph
brew "trippy"         # modern traceroute TUI
# --- DNS ---
brew "bind"           # dig / nslookup / host
brew "doggo"          # friendly DNS client
# --- HTTP / TLS ---
brew "curl"
brew "httpie"         # friendly HTTP client (command: http)
brew "openssl@3"
brew "testssl"        # thorough TLS configuration audit
# --- Capture / traffic ---
brew "termshark"      # terminal UI for wireshark
brew "tcpdump"
brew "ngrep"
brew "bandwhich"      # per-process bandwidth (needs sudo)
brew "iftop"          # per-connection bandwidth (needs sudo)
# --- Misc ---
brew "whois"
brew "jq"
cask "wireshark-app"  # GUI + tshark (formerly "wireshark")
