#!/bin/bash
# netdoctor - unified entry point for macOS network diagnostics (works with the stock bash 3.2)
set -u
VERSION=1.4.0
B=$'\033[1m'; G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; N=$'\033[0m'
[ -t 1 ] || [ -n "${NETDOCTOR_COLOR:-}" ] || { B=; G=; R=; Y=; N=; }
# Language: NETDOCTOR_LANG=zh|en, otherwise taken from the locale (LC_ALL / LANG)
case "${NETDOCTOR_LANG:-${LC_ALL:-${LANG:-}}}" in zh*|ZH*) ZH=1;; *) ZH=0;; esac
L() { if [ "$ZH" = 1 ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }
has() { command -v "$1" >/dev/null 2>&1; }
hdr() { printf '\n%s== %s ==%s\n' "$B" "$*" "$N"; }
ok()  { printf '%s[ OK ]%s %s\n' "$G" "$N" "$*"; }
bad() { printf '%s[FAIL]%s %s\n' "$R" "$N" "$*"; }
warn(){ printf '%s[WARN]%s %s\n' "$Y" "$N" "$*"; }

default_if()  { route -n get default 2>/dev/null | awk '/interface:/{print $2}'; }
gateway()     { route -n get default 2>/dev/null | awk '/gateway:/{print $2}'; }
# 提权: 已是 root 直接执行; 有终端时正常询问密码; 无终端(GUI 调用)或设了 NETDOCTOR_NOSUDO(如 report)用 -n, 避免卡在/弹出密码提示
priv() { if [ "$(id -u)" = 0 ]; then "$@"; elif [ -t 0 ] && [ -z "${NETDOCTOR_NOSUDO:-}" ]; then sudo "$@"; else sudo -n "$@"; fi; }
# 能否提权: root / 有终端 (sudo 会询问密码) / sudo 已缓存凭据。GUI 调用没有终端, 拿不到就别硬跑
can_priv() { [ "$(id -u)" = 0 ] && return 0; [ -t 0 ] && [ -z "${NETDOCTOR_NOSUDO:-}" ] && return 0; sudo -n true 2>/dev/null; }
need_admin() { bad "$(L "Administrator rights are required: run  sudo netdoctor $1  in a terminal" "需要管理员权限: 请在终端运行  sudo netdoctor $1")"; }
wifi_if()     { networksetup -listallhardwareports 2>/dev/null | awk '/Wi-Fi|AirPort/{getline; print $2; exit}'; }

usage() {
  if [ "$ZH" = 1 ]; then cat <<USAGE
netdoctor $VERSION - macOS 网络诊断

用法: netdoctor <命令> [参数]
  quick                 一键体检: 网卡/网关/DNS/外网/HTTP (先跑这个)
  dnsset <ip..>|restore|auto|show  修改 / 还原当前网络的 DNS (需 sudo): 改前自动备份, 改后验证能解析, 失败自动改回; dnsbench yes 可直接切到最快的
  compare [旧 新]       对比两份 report (默认最新的两份): 忽略延迟波动, 只列出真正变化的内容 (IP、DNS、网关、检查结论…)
  watch [主机] [秒]     持续 ping (默认 1.1.1.1, 60 秒): 断线 / 恢复即时提示并响铃, 结束后给出丢包、延迟、抖动和断线汇总
  doctor                智能诊断: 逐层检查并给出结论和下一步建议 (遇到问题先跑这个)
  overview              网络概览: 网卡/IP/网关/DNS/Wi-Fi/代理/公网 IP 一屏看全
  dhcp                  DHCP / IP 地址: 租约详情, 识别 169.254 自分配地址 (DHCP 失败)
  tcpping <主机> <端口> [次数]  TCP 连接延迟 (ping 被屏蔽时用; 默认 10 次)
  ports <主机> [端口]   并行检测多个端口 (默认常用端口; 如 22,80 或 1-1024)
  ipv6                  IPv6 诊断: 地址、路由器、外网、大包 (MTU)、按域名访问、与 IPv4 的速度对比, 并给出判读
  captive               检测强制门户 (连上 Wi-Fi 却打不开网页)
  dnsbench [域名]       DNS 测速: 对比系统与多家公共 DNS 的速度并给出推荐
  lan                   局域网设备发现: 扫描本网段, 列出 IP / MAC / 主机名
  wifi                  Wi-Fi 信号、信道、速率、SSID (部分信息需 sudo)
  dns <域名>            对比 系统/1.1.1.1/8.8.8.8/223.5.5.5 解析结果与耗时
  route <主机>          路由选择 + traceroute/mtr 路径
  mtr <主机> [次数]     逐跳丢包 / 延迟 (无需 root), 并判断问题出在哪一跳
  leak                  VPN 下的 DNS / IPv6 泄漏检查
  exposure              本机暴露面检查: 哪些端口对网络开放, 哪些服务不该暴露, 防火墙状态
  channels              Wi-Fi 信道拥挤分析, 推荐更空的信道 (约 15 秒)
  bonjour [秒数]        发现局域网里的 Bonjour 服务 (AirPlay、打印机、SSH、文件共享…)
  ping <主机>           持续 ping 并统计丢包/抖动 (默认 20 个包)
  port <主机> <端口>    TCP 端口连通性
  http <URL>            curl 分阶段耗时 (DNS/TCP/TLS/首字节/总计)
  tls <主机> [端口]     证书、协议版本、有效期
  mtu [主机]            探测路径 MTU (排查大包丢失/VPN 问题)
  speed                 带宽 + 响应性 (系统自带 networkQuality)
  conns                 当前连接与监听端口 (按进程)
  proxy                 系统代理 / 环境变量代理 / VPN 状态
  capture [过滤器]      tcpdump 抓包到 ~/Desktop (需 sudo)
  fixdns                刷新 DNS 缓存 (需 sudo)
  fix [yes]             诊断后自动修复: DHCP 重新获取 / 刷新 DNS / 校准时钟 / 打开登录页; 每步先确认, 修完自动复查 (yes=不再询问)
  report [html] [redact] 把诊断、概览、DHCP、Wi-Fi、DNS、IPv6、代理等保存到文件; html 存成带颜色、可折叠的网页; redact 自动隐藏 IP / MAC / Wi-Fi 名等个人信息
  tools                 检查第三方工具是否已安装
USAGE
  else cat <<USAGE
netdoctor $VERSION - macOS network diagnostics

Usage: netdoctor <command> [args]
  quick                 one-shot check: interface/gateway/DNS/internet/HTTP (run this first)
  dnsset <ip..>|restore|auto|show  change / restore the DNS of the current network (needs sudo): backs up first, verifies afterwards, rolls back on failure; dnsbench yes switches to the fastest
  compare [old new]     compare two saved reports (default: the two newest), ignoring timing noise: shows what really changed (IP, DNS, gateway, verdicts...)
  watch [host] [secs]   keep pinging (default 1.1.1.1, 60 s): tells you at once when it drops and recovers (bell), then summarises loss, latency, jitter and outages
  doctor                smart diagnosis: layer-by-layer checks with a verdict and next steps
  overview              network snapshot: interface/IP/gateway/DNS/Wi-Fi/proxy/public IP
  dhcp                  DHCP lease details; spots a self-assigned 169.254 address (DHCP failed)
  tcpping <host> <port> [count]  TCP connect latency (for when ping is blocked; 10 by default)
  ports <host> [ports]  check many ports in parallel (common ports by default; e.g. 22,80 or 1-1024)
  ipv6                  IPv6 diagnosis: address, router, internet, large packets (MTU), websites, speed vs IPv4, with a verdict
  captive               detect a captive portal (Wi-Fi connected but no web access)
  dnsbench [domain]     DNS benchmark: compare the system and public DNS servers and recommend one
  lan                   discover devices on the local network (IP / MAC / name)
  wifi                  Wi-Fi signal, channel, rate, SSID (some details need sudo)
  dns <domain>          compare system/1.1.1.1/8.8.8.8/223.5.5.5 answers and timings
  route <host>          route selection + traceroute/mtr path
  mtr <host> [count]    per-hop loss / latency (no root) and which hop the problem is at
  leak                  DNS / IPv6 leak check while a VPN is on
  exposure              what this Mac exposes to the network: open ports, risky services, firewall state
  channels              Wi-Fi channel crowding analysis and a quieter channel (about 15 s)
  bonjour [seconds]     discover Bonjour services on the LAN (AirPlay, printers, SSH, file sharing…)
  ping <host>           ping with loss/jitter stats (20 packets by default)
  port <host> <port>    TCP port reachability
  http <URL>            curl timing breakdown (DNS/TCP/TLS/first byte/total)
  tls <host> [port]     certificate, protocol version, validity
  mtu [host]            probe path MTU (large-packet loss / VPN issues)
  speed                 bandwidth + responsiveness (built-in networkQuality)
  conns                 current connections and listening ports (by process)
  proxy                 system proxy / env-var proxy / VPN status
  capture [filter]      tcpdump capture to ~/Desktop (needs sudo)
  fixdns                flush the DNS cache (needs sudo)
  fix [yes]             diagnose, then fix what can be fixed here: renew DHCP / flush DNS / sync the clock / open the login page; asks first, re-checks after (yes = do not ask)
  report [html] [redact] save diagnosis, overview, DHCP, Wi-Fi, DNS, IPv6 and proxy info to a file; "html" makes a self-contained web page; "redact" hides IP / MAC / Wi-Fi name etc.
  tools                 check whether third-party tools are installed
USAGE
  fi
}

row() { printf '  %s: %s\n' "$1" "$(printf '%s' "$2" | sed 's/[[:space:]]*$//')"; }

cmd_overview() {
  local ifc gw ip4 ip6 mac mtu dns dom wn px vpn
  hdr "$(L "Network overview" "网络概览")"
  ifc=$(default_if); gw=$(gateway)
  if [ -z "$ifc" ]; then bad "$(L "No default route (not connected?)" "没有默认路由 (未联网?)")"; return 1; fi
  ip4=$(ipconfig getifaddr "$ifc" 2>/dev/null); [ -z "$ip4" ] && ip4=$(ifconfig "$ifc" 2>/dev/null | awk '/inet /{print $2; exit}')
  ip6=$(ifconfig "$ifc" 2>/dev/null | awk '/inet6 / && $2 !~ /^fe80/{print $2; exit}')
  mac=$(ifconfig "$ifc" 2>/dev/null | awk '/ether /{print $2; exit}')
  mtu=$(ifconfig "$ifc" 2>/dev/null | sed -n 's/.*mtu \([0-9]*\).*/\1/p' | head -1)
  row "$(L "Interface" "网卡")" "$ifc${mtu:+  (MTU $mtu)}"
  row "IPv4" "${ip4:-$(L "none" "无")}"
  row "IPv6" "${ip6:-$(L "none" "无")}"
  row "MAC" "${mac:-$(L "unknown" "未知")}"
  if [ -n "$gw" ]; then
    if ping -c 1 -t 2 "$gw" >/dev/null 2>&1; then row "$(L "Gateway" "网关")" "$gw  $(L "(reachable)" "(可达)")"
    else row "$(L "Gateway" "网关")" "$gw  $(L "(unreachable)" "(不通)")"; fi
  else row "$(L "Gateway" "网关")" "$(L "none" "无")"; fi
  dns=$(scutil --dns 2>/dev/null | awk '/nameserver\[[0-9]+\]/{print $3}' | awk '!seen[$0]++' | tr '\n' ' ')
  dom=$(scutil --dns 2>/dev/null | awk '/search domain\[[0-9]+\]/{print $4}' | awk '!seen[$0]++' | tr '\n' ' ')
  row "DNS" "${dns:-$(L "unknown" "未知")}"
  [ -n "$dom" ] && row "$(L "Search domains" "搜索域")" "$dom"
  if has networksetup; then
    wn=$(networksetup -getairportnetwork "$(wifi_if)" 2>/dev/null | sed 's/^Current Wi-Fi Network: //')
    [ -n "$wn" ] && row "Wi-Fi" "$wn"
  fi
  px=$(scutil --proxy 2>/dev/null | awk '/HTTPEnable : 1/{h=1} /HTTPProxy :/{hp=$3} /HTTPPort :/{hq=$3} /HTTPSEnable : 1/{s=1} /HTTPSProxy :/{sp=$3} /HTTPSPort :/{sq=$3} /SOCKSEnable : 1/{k=1} /SOCKSProxy :/{kp=$3} /SOCKSPort :/{kq=$3} END{if(h)printf "http=%s:%s ",hp,hq; if(s)printf "https=%s:%s ",sp,sq; if(k)printf "socks=%s:%s ",kp,kq}')
  row "$(L "Proxy" "代理")" "${px:-$(L "none" "无")}"
  vpn=$(ifconfig 2>/dev/null | awk '/^[a-z0-9]+:/{n=$1; sub(":","",n)} /inet /{if (n ~ /^(utun|ppp|ipsec|tun|tap)/) printf "%s=%s ", n, $2}')
  row "$(L "VPN / tunnels" "VPN / 隧道")" "${vpn:-$(L "none" "无")}"
  local geo; geo=$(curl -s -m 6 https://api.ip.sb/geoip 2>/dev/null)
  if [ -n "$geo" ] && has jq; then row "$(L "Public IP" "公网 IP")" "$(echo "$geo" | jq -r '"\(.ip)  \(.country // "") \(.isp // .organization // "")"')"
  elif [ -n "$geo" ]; then row "$(L "Public IP" "公网 IP")" "$(echo "$geo" | tr -d '\n' | cut -c1-120)"
  else row "$(L "Public IP" "公网 IP")" "$(L "lookup failed" "获取失败")"; fi
}

svc() {
  case "$1" in 21) echo ftp;; 22) echo ssh;; 23) echo telnet;; 25) echo smtp;; 53) echo dns;; 80) echo http;; 110) echo pop3;;
    143) echo imap;; 443) echo https;; 465) echo smtps;; 587) echo submission;; 993) echo imaps;; 995) echo pop3s;;
    1433) echo mssql;; 3306) echo mysql;; 3389) echo rdp;; 5432) echo postgres;; 5900) echo vnc;; 6379) echo redis;;
    8080) echo http-alt;; 8443) echo https-alt;; 27017) echo mongodb;; *) echo "";; esac
}

cmd_ports() {
  local h=${1:-} spec=${2:-} list="" tok a b i n=0 total tmp ncopt open p closed
  [ -z "$h" ] && { echo "$(L "Usage: netdoctor ports <host> [ports]" "用法: netdoctor ports <主机> [端口]")"; return 1; }
  case "$h" in *[!A-Za-z0-9._:-]*|-*) bad "$(L "Invalid host: $h" "主机无效: $h")"; return 1;; esac
  [ -z "$spec" ] && spec="21,22,23,25,53,80,110,143,443,465,587,993,995,1433,3306,3389,5432,5900,6379,8080,8443,27017"
  case "$spec" in *[!0-9,-]*) bad "$(L "Invalid port list: $spec" "端口列表无效: $spec")"; return 1;; esac
  for tok in $(echo "$spec" | tr ',' ' '); do
    case "$tok" in
      *-*) a=${tok%%-*}; b=${tok#*-}
           if [ -z "$a" ] || [ -z "$b" ] || [ -n "${b//[0-9]/}" ]; then bad "$(L "Invalid port list: $spec" "端口列表无效: $spec")"; return 1; fi ;;
      *)   a=$tok; b=$tok ;;
    esac
    a=$((10#$a)); b=$((10#$b))
    if [ "$a" -lt 1 ] || [ "$b" -gt 65535 ]; then bad "$(L "Port out of range (1-65535): $tok" "端口超出范围 (1-65535): $tok")"; return 1; fi
    if [ "$a" -gt "$b" ]; then bad "$(L "Invalid port range (start is greater than end): $tok" "端口范围无效 (起始大于结束): $tok")"; return 1; fi
    i=$a; while [ "$i" -le "$b" ]; do list="$list $i"; i=$((i+1)); n=$((n+1)); if [ "$n" -gt 1024 ]; then bad "$(L "Too many ports (max 1024 per run)" "端口过多 (每次最多 1024 个)")"; return 1; fi; done
  done
  has nc || { bad "$(L "nc (netcat) not found" "未找到 nc (netcat)")"; return 1; }
  if cannot_resolve "$h"; then bad "$(L "Cannot resolve $h; check the host name or DNS (try: netdoctor dns $h)" "无法解析 $h, 检查域名或 DNS (可试: netdoctor dns $h)")"; return 1; fi
  ncopt="-w 2"; if ! nc -G 2 -z 127.0.0.1 9 2>&1 | grep -qiE 'illegal option|invalid option|unknown option'; then ncopt="-G 2 -w 2"; fi
  tmp=$(mktemp -d); n=0
  for p in $list; do
    ( nc -z $ncopt "$h" "$p" >/dev/null 2>&1 && : >"$tmp/$p" ) &
    n=$((n+1)); [ $((n % 40)) -eq 0 ] && wait
  done
  wait
  total=$n; open=$(ls "$tmp" | sort -n); rm -rf "$tmp"
  hdr "$(L "Ports on $h ($total checked)" "$h 的端口 (已检测 $total 个)")"
  if [ -z "$open" ]; then
    warn "$(L "No open ports found (closed, filtered, or host unreachable)" "没有发现开放端口 (关闭 / 被过滤 / 主机不可达)")"; return 0
  fi
  n=0; for p in $open; do n=$((n+1)); ok "$p/tcp  $(svc "$p")"; done
  echo "$(L "$n open, $((total - n)) closed or filtered" "$n 个开放, $((total - n)) 个关闭或被过滤")"
  if [ "$total" -le 30 ]; then
    closed=""; for p in $list; do case " $(echo $open) " in *" $p "*) ;; *) closed="$closed $p";; esac; done
    [ -n "$closed" ] && echo "$(L "Closed or filtered:" "关闭或被过滤:")$closed"
  fi
  return 0
}

# ---- dnsset: 修改 / 还原当前网络服务的 DNS ----------------------------------------------------------------
# 先备份原设置 (只备份第一次, 连续改几次也能还原到最初的样子), 改完刷新 DNS 缓存并验证能解析; 验证失败自动改回去。
net_service() { # $1=网卡 → networksetup 的服务名 (如 Wi-Fi / Ethernet)
  networksetup -listnetworkserviceorder 2>/dev/null | awk -v d="$1" '
    /^\([0-9*]+\) /{ name=$0; sub(/^\([0-9*]+\) /, "", name) }
    /Device: /{ dev=$0; sub(/.*Device: /, "", dev); sub(/\).*/, "", dev); if (dev == d) { print name; exit } }'
}
dns_service() { # 要改 DNS 的网络服务名. 默认路由走 VPN 隧道 (utun / ppp) 时 default_if 找不到服务, 改选第一个已启用且有 IP 的物理服务; 都没有就返回空, 绝不瞎猜
  local ifc svc line d
  ifc=$(default_if); [ -n "$ifc" ] && svc=$(net_service "$ifc")
  if [ -z "${svc:-}" ]; then
    while IFS='|' read -r line d; do
      case "$d" in ""|utun*|ppp*|ipsec*|lo*|gif*|stf*|bridge*) continue;; esac
      [ -n "$(ipconfig getifaddr "$d" 2>/dev/null)" ] && { svc=$line; break; }
    done <<EOF_SV
$(networksetup -listnetworkserviceorder 2>/dev/null | awk '
  /^\([0-9]+\) /{ name=$0; sub(/^\([0-9]+\) /, "", name); next }
  /^\(\*\) /{ name=""; next }
  /Device: /{ dev=$0; sub(/.*Device: /, "", dev); sub(/\).*/, "", dev); if (name != "") print name "|" dev }')
EOF_SV
  fi
  printf '%s' "${svc:-}"
}
dns_current() { networksetup -getdnsservers "$1" 2>/dev/null | grep -E '^[0-9A-Fa-f:.]+$' | tr '\n' ' ' | sed 's/ $//'; }   # 没手动设置时为空 (= 自动 / DHCP)
dns_backup_file() { printf '%s/dns-backup/%s' "${NETDOCTOR_HOME:-$HOME/.netdoctor}" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"; }
dns_valid_v6() { # 只含十六进制和冒号的串是否是合法 IPv6: 每组 1-4 位, 至多一个 "::", 无 "::" 时恰好 8 组, 有时最多 7 组
  printf '%s' "$1" | awk '{ s=$0; if (s ~ /:::/ || s ~ /^:[^:]/ || s ~ /[^:]:$/) exit 1
    d=gsub(/::/,"&",s); if (d > 1) exit 1; k=split($0,g,":"); c=0
    for (i=1;i<=k;i++) if (g[i] != "") { if (length(g[i]) > 4) exit 1; c++ }
    if (d == 1) exit !(c >= 1 && c <= 7); exit !(k == 8 && c == 8) }'
}
dns_valid_ip() { case "$1" in
    *[!0-9.]*) case "$1" in *:*) case "$1" in *[!0-9A-Fa-f:]*) return 1;; *) dns_valid_v6 "$1";; esac;; *) return 1;; esac;;
    *) printf '%s' "$1" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || return 1
       local o; for o in ${1//./ }; do [ "$((10#$o))" -le 255 ] || return 1; done; return 0;; esac; }
dns_apply() { # $1=服务名, 其余=服务器 (空 = 恢复自动)
  local svc=$1; shift
  if [ $# -gt 0 ]; then priv networksetup -setdnsservers "$svc" "$@" || return 1
  else priv networksetup -setdnsservers "$svc" empty || return 1; fi
  priv dscacheutil -flushcache 2>/dev/null; priv killall -HUP mDNSResponder 2>/dev/null; return 0
}
cmd_dnsset() {
  local sub=${1:-show} svc cur bk new list t n=0 created=0
  case "$sub" in
    show)
      svc=$(dns_service)
      if [ -z "$svc" ]; then bad "$(L "Could not tell which network service to change (no active Wi-Fi / Ethernet service found; is only a VPN connected?)" "无法确定要修改哪个网络服务 (没找到已连接的 Wi-Fi / 以太网服务, 是不是只连了 VPN?)")"; return 1; fi
      cur=$(dns_current "$svc"); bk=$(dns_backup_file "$svc")
      hdr "$(L "DNS servers of \"$svc\"" "\"$svc\" 的 DNS 服务器")"
      echo "  $(L "now" "当前"): ${cur:-$(L "automatic (from DHCP)" "自动 (来自 DHCP)")}"
      if [ -f "$bk" ]; then t=$(cat "$bk"); echo "  $(L "saved original" "已保存的原设置"): ${t:-$(L "automatic (from DHCP)" "自动 (来自 DHCP)")}"; echo "  $(L "undo with" "还原"): netdoctor dnsset restore"; fi
      return 0;;
  esac
  case "$sub" in   # 先校验输入, 再检查权限: 地址写错时直接指出, 不要先让人去 sudo
    restore|auto) ;;
    *) list=$(printf '%s ' "$@" | tr ',' ' ')
       set -f; for t in $list; do dns_valid_ip "$t" || { set +f; bad "$(L "Not an IP address: $t (usage: netdoctor dnsset <ip> [ip...] | auto | restore | show)" "不是 IP 地址: $t (用法: netdoctor dnsset <ip> [ip...] | auto | restore | show)")"; return 1; }; n=$((n+1)); new="$new $t"; done; set +f
       [ "$n" -ge 1 ] && [ "$n" -le 4 ] || { bad "$(L "Give 1 to 4 DNS server addresses" "请给 1 到 4 个 DNS 服务器地址")"; return 1; }
       new=${new# };;
  esac
  can_priv || { need_admin "dnsset $*"; return 1; }
  svc=$(dns_service)
  if [ -z "$svc" ]; then bad "$(L "Could not tell which network service to change (no active Wi-Fi / Ethernet service found; is only a VPN connected?)" "无法确定要修改哪个网络服务 (没找到已连接的 Wi-Fi / 以太网服务, 是不是只连了 VPN?)")"; return 1; fi
  cur=$(dns_current "$svc"); bk=$(dns_backup_file "$svc")
  case "$sub" in
    restore)
      [ -f "$bk" ] || { bad "$(L "No saved original DNS setting for \"$svc\" (nothing to restore). To go back to automatic DNS: netdoctor dnsset auto" "没有 \"$svc\" 的原 DNS 设置备份, 无法还原。想回到自动 DNS: netdoctor dnsset auto")"; return 1; }
      new=$(cat "$bk")
      if dns_apply "$svc" $new; then rm -f "$bk"; ok "$(L "Restored \"$svc\": ${new:-automatic (from DHCP)}" "已还原 \"$svc\": ${new:-自动 (来自 DHCP)}")"; return 0; fi
      bad "$(L "Restoring failed (wrong password or no admin rights)" "还原失败 (密码错误或没有管理员权限)")"; return 1;;
    auto) new="";;
  esac
  if [ ! -f "$bk" ]; then mkdir -p "$(dirname "$bk")" 2>/dev/null && printf '%s\n' "$cur" >"$bk" && created=1; fi
  if ! dns_apply "$svc" $new; then [ "$created" = 1 ] && rm -f "$bk"; bad "$(L "Setting DNS failed (wrong password or no admin rights)" "设置 DNS 失败 (密码错误或没有管理员权限)")"; return 1; fi
  sleep 1
  if [ -n "$new" ] && ! { resolves apple.com || resolves baidu.com; }; then
    bad "$(L "Names no longer resolve with $new; going back to the previous setting." "改成 $new 后域名无法解析, 已改回原设置。")"
    dns_apply "$svc" $cur; [ "$created" = 1 ] && rm -f "$bk"; return 1
  fi
  ok "$(L "\"$svc\" DNS: ${cur:-automatic} → ${new:-automatic}" "\"$svc\" 的 DNS: ${cur:-自动} → ${new:-自动}")"
  echo "$(L "To undo: netdoctor dnsset restore. Note: a fixed DNS overrides what the router / VPN / company network hands out (internal names may stop resolving)." "还原: netdoctor dnsset restore。注意: 手动设置的 DNS 会覆盖路由器 / VPN / 公司网络下发的 DNS (内网域名可能解析不了)。")"
}

cmd_dnsbench() {
  local extra="" apply=0 yes=0 a top1="" top2="" domains="example.com apple.com baidu.com github.com wikipedia.org"
  for a in "$@"; do case "$a" in apply|--apply) apply=1;; yes|--yes) apply=1; yes=1;; *) extra=$a;; esac; done
  local servers="system 1.1.1.1 8.8.8.8 9.9.9.9 223.5.5.5 119.29.29.29 114.114.114.114 180.76.76.76" tmp s best_line rank=0 avg srv ok n mn
  has dig || { bad "$(L "dig not found (brew install bind)" "未找到 dig (brew install bind)")"; return 1; }
  if [ -n "$extra" ]; then
    case "$extra" in *[!A-Za-z0-9.-]*|-*) bad "$(L "Invalid domain: $extra" "域名无效: $extra")"; return 1;; esac
    domains="$domains $extra"
  fi
  hdr "$(L "DNS benchmark" "DNS 测速") ($(echo $domains | wc -w | tr -d ' ') $(L "domains" "个域名"))"
  tmp=$(mktemp -d)
  for s in $servers; do
    (
      sum=0; ok=0; n=0; mn=999999; at=""; [ "$s" != system ] && at="@$s"
      for d in $domains; do
        out=$(dig $at +tries=1 +time=2 "$d" A 2>/dev/null)
        t=$(printf '%s\n' "$out" | awk '/Query time:/{print $4; exit}'); n=$((n+1))
        if [ -n "$t" ] && printf '%s\n' "$out" | grep -q 'status: NOERROR'; then ok=$((ok+1)); sum=$((sum+t)); [ "$t" -lt "$mn" ] && mn=$t; fi
      done
      if [ "$ok" -gt 0 ]; then echo "$((sum/ok)) $s $ok $n $mn" >"$tmp/$s"; else echo "999999 $s 0 $n 0" >"$tmp/$s"; fi
    ) &
  done
  wait
  printf '  %-3s %-17s %9s %9s  %s\n' "#" "Server" "Avg ms" "Min ms" "OK"
  best_line=""
  while read -r avg srv ok n mn; do
    rank=$((rank+1)); [ -z "$best_line" ] && [ "$ok" -gt 0 ] && best_line="$avg $srv"
    if [ "$ok" -gt 0 ] && [ "$srv" != system ]; then if [ -z "$top1" ]; then top1=$srv; elif [ -z "$top2" ]; then top2=$srv; fi; fi
    if [ "$ok" -gt 0 ]; then printf '  %-3s %-17s %9s %9s  %s/%s\n' "$rank" "$srv" "$avg" "$mn" "$ok" "$n"
    else printf '  %-3s %-17s %9s %9s  %s/%s\n' "$rank" "$srv" "-" "-" "$ok" "$n"; fi
  done <<EOF2
$(cat "$tmp"/* | sort -n)
EOF2
  local sysavg; sysavg=$(awk '$2=="system"{print $1}' "$tmp"/system 2>/dev/null); rm -rf "$tmp"
  [ -z "$best_line" ] && { bad "$(L "No DNS server answered (network down?)" "没有 DNS 服务器应答 (网络不通?)")"; return 1; }
  set -- $best_line
  ok "$(L "Fastest: $2 (avg $1 ms)" "最快: $2 (平均 $1 ms)")"
  if [ "$2" != system ] && [ -n "$sysavg" ] && [ "$sysavg" -lt 999999 ] && [ "$sysavg" -gt $(( $1 * 13 / 10 )) ]; then
    echo "$(L "The system DNS (avg $sysavg ms) is noticeably slower. To switch:" "系统 DNS (平均 $sysavg ms) 明显偏慢。可切换:")"
    echo "  netdoctor dnsbench yes        $(L "(switch to the fastest; asks for the administrator password)" "(切换到最快的; 会要管理员密码)")"
    echo "  netdoctor dnsset restore      $(L "(undo; goes back to the original setting)" "(撤销, 回到原来的设置)")"
  fi
  echo "$(L "Note: popular domains are usually cached, so this measures the resolver's nearest cache." "注: 热门域名通常有缓存, 测得的是解析器最近缓存的响应速度。")"
  if [ "$apply" = 1 ]; then
    local svc ans cur; svc=$(dns_service); cur=$(dns_current "$svc")
    hdr "$(L "Switch DNS" "切换 DNS")"
    if [ -z "$svc" ]; then warn "$(L "Could not tell which network service to change (is only a VPN connected?); nothing was changed." "无法确定要修改哪个网络服务 (是不是只连了 VPN?), 没有做任何修改。")"; return 1; fi
    if [ -z "$top1" ]; then warn "$(L "No public DNS server answered; nothing to switch to." "没有公共 DNS 服务器应答, 没有可切换的目标。")"; return 1
    elif [ "$2" = system ]; then ok "$(L "The system DNS is already the fastest; nothing to change." "系统 DNS 已经是最快的, 不需要改。")"; return 0
    elif [ -n "$sysavg" ] && [ "$sysavg" -lt 999999 ] && [ "$sysavg" -le $(( $1 * 13 / 10 )) ]; then ok "$(L "The system DNS (avg $sysavg ms) is not noticeably slower than $2 (avg $1 ms); nothing to change." "系统 DNS (平均 $sysavg ms) 和 $2 (平均 $1 ms) 差不多, 不需要改。")"; return 0; fi
    echo "  → $(L "Set the DNS of \"$svc\" to $top1${top2:+ $top2}   (now: ${cur:-automatic})" "把 \"$svc\" 的 DNS 设为 $top1${top2:+ $top2}   (当前: ${cur:-自动})")"
    if [ "$yes" != 1 ]; then
      if [ -t 0 ]; then printf '%s' "$(L "    Apply it? [y/N] " "    要执行吗? [y/N] ")"; read -r ans || ans=""; case "$ans" in y|Y|yes|YES) ;; *) echo "    $(L "skipped" "已跳过")"; return 0;; esac
      else echo "$(L "Nothing was changed. To apply it, run  netdoctor dnsbench yes  (in the app: tick the box)." "没有做任何修改。要执行, 请运行  netdoctor dnsbench yes  (App / 网页里勾选对应选项)。")"; return 0; fi
    fi
    cmd_dnsset $top1 $top2
  fi
}

ip2int() { local IFS=.; set -- $1; echo $(( ($1<<24) + ($2<<16) + ($3<<8) + $4 )); }
int2ip() { echo "$(( ($1>>24)&255 )).$(( ($1>>16)&255 )).$(( ($1>>8)&255 )).$(( $1&255 ))"; }

# 有 169.254.x.x 自分配地址的网卡 (DHCP 没拿到地址时系统会自己分配一个)
self_assigned_if() { ifconfig 2>/dev/null | awk '/^[a-z0-9]+:/{n=$1; sub(":","",n)} /inet 169\.254\./{print n; exit}'; }

cmd_dhcp() {
  local ifc ip pkt srv rtr dns mask lease dom gw ls
  ifc=$(default_if); [ -z "$ifc" ] && ifc=$(self_assigned_if); [ -z "$ifc" ] && ifc=$(wifi_if); ifc=${ifc:-en0}
  hdr "$(L "DHCP / IP address ($ifc)" "DHCP / IP 地址 ($ifc)")"
  ip=$(ifconfig "$ifc" 2>/dev/null | awk '/inet /{print $2; exit}')
  if [ -z "$ip" ]; then
    bad "$(L "$ifc has no IPv4 address (not connected, or DHCP has not answered yet)" "$ifc 没有 IPv4 地址 (没连上网络, 或 DHCP 还没应答)")"
    echo "$(L "Renew the lease: sudo ipconfig set $ifc DHCP   (or toggle Wi-Fi off and on)" "重新获取地址: sudo ipconfig set $ifc DHCP   (或关闭再打开 Wi-Fi)")"; return 1
  fi
  case "$ip" in
    169.254.*)
      bad "$(L "$ifc has a self-assigned address $ip: the DHCP server did not answer, so the Mac gave itself one" "$ifc 的地址 $ip 是系统自己分配的: DHCP 服务器没有应答")"
      echo "$(L "Next steps:" "建议下一步:")"
      echo "  - sudo ipconfig set $ifc DHCP   # $(L "renew the lease" "重新获取地址")"
      echo "  - $(L "Turn Wi-Fi off and on (or re-plug the cable), then run this again" "关闭再打开 Wi-Fi (或重新插拔网线), 然后再跑一次")"
      echo "  - $(L "Restart the router; check that its DHCP pool is not full" "重启路由器; 检查路由器的 DHCP 地址池是否已满")"
      return 1;;
  esac
  ok "IPv4  $ip"
  pkt=$(ipconfig getpacket "$ifc" 2>/dev/null)
  if ! echo "$pkt" | grep -q BOOTREPLY; then
    warn "$(L "No DHCP lease on $ifc: the address is set manually, or comes from a VPN / another source" "$ifc 上没有 DHCP 租约: 地址是手动设置的, 或来自 VPN / 其他来源")"; return 0
  fi
  srv=$(echo "$pkt" | sed -n 's/^server_identifier (ip): //p' | head -1)
  mask=$(echo "$pkt" | sed -n 's/^subnet_mask (ip): //p' | head -1)
  rtr=$(echo "$pkt" | sed -n 's/^router (ip_mult): {\(.*\)}/\1/p' | head -1)
  dns=$(echo "$pkt" | sed -n 's/^domain_name_server (ip_mult): {\(.*\)}/\1/p' | head -1)
  dom=$(echo "$pkt" | sed -n 's/^domain_name (string): //p' | head -1)
  lease=$(echo "$pkt" | sed -n 's/^lease_time (uint32): //p' | head -1)
  printf '  %-14s %s\n' "$(L "DHCP server" "DHCP 服务器")" "${srv:--}"
  printf '  %-14s %s\n' "$(L "Subnet mask" "子网掩码")" "${mask:--}"
  printf '  %-14s %s\n' "$(L "Router" "路由器")" "${rtr:--}"
  printf '  %-14s %s\n' "DNS" "${dns:--}"
  [ -n "$dom" ] && printf '  %-14s %s\n' "$(L "Search domain" "搜索域")" "$dom"
  if [ -n "$lease" ]; then
    ls=$((lease)) 2>/dev/null || ls=""
    if [ -n "$ls" ] && [ "$ls" -gt 0 ]; then
      if [ "$ls" -ge 3600 ]; then printf '  %-14s %s\n' "$(L "Lease time" "租期")" "$((ls/3600)) $(L "h" "小时") $((ls%3600/60)) $(L "min" "分钟")"
      else printf '  %-14s %s\n' "$(L "Lease time" "租期")" "$((ls/60)) $(L "min" "分钟")"; fi
      [ "$ls" -lt 600 ] && warn "$(L "Very short lease ($((ls/60)) min): the router renews addresses constantly, which can cause brief drops" "租期很短 ($((ls/60)) 分钟): 路由器频繁更换地址, 可能造成短暂掉线")"
    fi
  fi
  # 默认网关与 DHCP 下发的路由器不一致 → 可能被 VPN 或其他网络服务改了默认路由
  gw=$(gateway)
  if [ -n "$gw" ] && [ -n "$rtr" ]; then
    case ", $rtr, " in *", $gw, "*|*" $gw "*|*"{$gw}"*) ok "$(L "The default gateway matches the router the DHCP server offered" "默认网关与 DHCP 下发的路由器一致")";;
      *) warn "$(L "The default gateway ($gw) is not the router the DHCP server offered ($rtr): a VPN or another network service changed the default route" "默认网关 ($gw) 不是 DHCP 下发的路由器 ($rtr): 可能被 VPN 或其他网络服务改了默认路由")";; esac
  fi
  return 0
}

# MAC 地址 -> 厂商。系统没有自带 OUI 库, 所以按顺序找: ~/.netdoctor/oui.txt、nmap、Wireshark 的库 (格式: 前 6 位十六进制 + 空格/制表符 + 厂商名)。
# 都没有时只能识别"随机 MAC" (第一个字节的 0x02 位: iPhone / Android 的"私有 Wi-Fi 地址"), 不会瞎猜厂商。
oui_file() {
  local f
  for f in "$HOME/.netdoctor/oui.txt" /usr/local/share/nmap/nmap-mac-prefixes /opt/homebrew/share/nmap/nmap-mac-prefixes /usr/share/nmap/nmap-mac-prefixes; do
    [ -r "$f" ] && { echo "$f"; return; }
  done
}
mac_vendor() {   # $1=MAC (aa:bb:cc:...), $2=OUI 文件 (可空)
  local mac=$1 f=$2 first p
  case "$mac" in ""|"?"|"-") return;; esac
  case "${mac%%:*}" in *[!0-9A-Fa-f]*|"") return;; esac
  first=$((16#${mac%%:*}))
  # 第一个字节的 0x02 位 = 本地管理地址: 手机的"私有 Wi-Fi 地址"是随机生成的, 虚拟机 / 容器网卡也这样, 没有厂商可查
  if [ $(( first & 2 )) -ne 0 ]; then L "random / virtual MAC (locally administered)" "随机 / 虚拟 MAC (本地管理地址)"; return; fi
  [ -n "$f" ] || return
  p=$(printf '%s' "$mac" | tr 'a-f' 'A-F' | awk -F: '{printf "%s%s%s", (length($1)==1?"0"$1:$1), (length($2)==1?"0"$2:$2), (length($3)==1?"0"$3:$3)}')
  awk -v p="$p" 'toupper(substr($1,1,6))==p { $1=""; sub(/^[ \t]+/,""); print; exit }' "$f" 2>/dev/null
}

cmd_lan() {
  local ifc ip m mask ipi net size i addr n=0 popt gw selfmac found tmp unk=0 t
  ifc=$(default_if); gw=$(gateway)
  if [ -z "$ifc" ]; then bad "$(L "No default route (not connected?)" "没有默认路由 (未联网?)")"; return 1; fi
  ip=$(ipconfig getifaddr "$ifc" 2>/dev/null); [ -z "$ip" ] && ip=$(ifconfig "$ifc" 2>/dev/null | awk '/inet /{print $2; exit}')
  m=$(ifconfig "$ifc" 2>/dev/null | awk '/inet /{print $4; exit}')
  if [ -z "$ip" ] || [ -z "$m" ]; then bad "$(L "Cannot read the IPv4 address of $ifc" "无法读取 $ifc 的 IPv4 地址")"; return 1; fi
  case "$m" in 0x*) mask=$((16#${m#0x}));; *) mask=$(ip2int "$m");; esac
  ipi=$(ip2int "$ip"); net=$(( ipi & mask )); size=$(( (~mask) & 0xffffffff ))
  if [ "$size" -gt 1023 ]; then   # 大于 /22 的网段只扫本机所在的 /24, 避免扫描过久
    warn "$(L "Subnet is larger than /22; scanning only this Mac's /24" "子网大于 /22, 仅扫描本机所在的 /24")"
    net=$(( ipi & 0xffffff00 )); size=255
  fi
  selfmac=$(ifconfig "$ifc" 2>/dev/null | awk '/ether /{print $2; exit}')
  # 没有"本地网络"权限的进程 (网页 / App 里运行) 读到的是占位 MAC 02:00:00:00:00:00, 不是真的
  [ "$selfmac" = "02:00:00:00:00:00" ] && { selfmac="?"; unk=1; }
  hdr "$(L "Devices on the local network" "局域网设备") ($(int2ip $((net+1))) - $(int2ip $((net+size-1))))"
  echo "$(L "Scanning $((size-1)) addresses on $ifc …" "正在扫描 $ifc 上的 $((size-1)) 个地址 …")"
  popt="-W 1"; [ "$(uname)" = Darwin ] && popt="-t 1"
  tmp=$(mktemp -t netdoctor-lan)
  for ((i=1; i<size; i++)); do
    addr=$(int2ip $((net+i))); [ "$addr" = "$ip" ] && continue
    ( ping -c 1 $popt "$addr" >/dev/null 2>&1 && echo "$addr" >>"$tmp" ) &
    n=$((n+1)); [ $((n % 64)) -eq 0 ] && wait
  done
  wait
  # ARP 表 + 有应答的主机 (整表读不到时, 逐个按 IP 查询; 仍读不到 MAC 则显示 ?)
  local rows; rows=$(arp -a -i "$ifc" 2>/dev/null | awk '/ at /')
  for t in $(sort -u "$tmp" 2>/dev/null); do
    echo "$rows" | grep -q "($t)" && continue
    line=$(arp -n "$t" 2>/dev/null | grep " on $ifc " | head -1)
    [ -z "$line" ] && { line="? ($t) at ? on $ifc"; unk=1; }
    rows="$rows
$line"
  done
  rm -f "$tmp"
  found=$(echo "$rows" | awk '
      { if (!match($0, /\([0-9.]+\)/)) next
        a=substr($0, RSTART+1, RLENGTH-2); name=substr($0, 1, RSTART-2); sub(/ .*/, "", name)
        if (!match($0, / at [^ ]+/)) next
        mac=substr($0, RSTART+4, RLENGTH-4)
        if (mac=="(incomplete)" || mac ~ /ff:ff:ff:ff:ff:ff/ || a ~ /^(224|239)\./ || a ~ /\.255$/) next
        if (mac!="?") { k=split(mac,o,":"); mac=""; for(j=1;j<=k;j++){ if(length(o[j])==1) o[j]="0" o[j]; mac=mac (j>1?":":"") o[j] } }
        if (name=="" || name=="?") name="-"
        if (!(a in nm) || (nm[a]=="-" && name!="-")) { nm[a]=name; mc[a]=mac } }
      END { for (a in nm) print a, mc[a], nm[a] }' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n)
  local ouif; ouif=$(oui_file)
  # 没有名字的设备: 向网关 (路由器自带的 DNS) 做一次反向解析, 并行, 每个最多等 1 秒
  local rdir; rdir=$(mktemp -d -t netdoctor-rdns)
  if has dig; then
    while read -r a2 mac name; do
      [ -z "$a2" ] || [ "$name" != "-" ] && continue
      ( dig +short +time=1 +tries=1 -x "$a2" ${gw:+@"$gw"} 2>/dev/null | head -1 | sed 's/\.$//' >"$rdir/$a2" ) &
    done <<EOF3
$found
EOF3
    wait
  fi
  printf '  %-16s %-18s %-28s %s\n' "IP" "MAC" "$(L "Name" "名称")" "$(L "Vendor" "厂商")"
  local cnt=0 line tag vend rn
  while read -r a2 mac name; do
    [ -z "$a2" ] || [ "$a2" = "$ip" ] && continue
    case "$(int2ip $(( $(ip2int "$a2") & mask )))" in "$(int2ip $net)") ;; *) continue;; esac
    if [ "$name" = "-" ] && [ -s "$rdir/$a2" ]; then rn=$(head -1 "$rdir/$a2"); case "$rn" in *\ *|"") ;; *) name=$rn;; esac; fi
    tag=""; [ "$a2" = "$gw" ] && tag="$(L "(gateway)" "(网关)") "
    vend=$(mac_vendor "$mac" "$ouif")
    printf '  %-16s %-18s %-28s %s%s\n' "$a2" "$mac" "${name:0:28}" "$tag" "$vend"; cnt=$((cnt+1))
  done <<EOF2
$found
EOF2
  rm -rf "$rdir"
  printf '  %-16s %-18s %-28s %s\n' "$ip" "${selfmac:--}" "-" "$(L "(this Mac)" "(本机)")"
  ok "$(L "$((cnt+1)) devices (including this Mac)" "共 $((cnt+1)) 台设备 (含本机)")"
  [ "$unk" = 1 ] && warn "$(L "Some MAC addresses could not be read. If this runs inside the app or web UI, allow it under System Settings → Privacy & Security → Local Network, or run netdoctor lan in Terminal." "部分设备的 MAC 无法读取。若在 App/网页中运行, 请在 系统设置 → 隐私与安全性 → 本地网络 中允许, 或直接在终端运行 netdoctor lan。")"
  [ -z "$ouif" ] && echo "$(L "No vendor database found: only random / virtual MACs are labelled. Put an OUI list in ~/.netdoctor/oui.txt (or install nmap) to see vendors." "没有找到厂商库: 只能标出随机 / 虚拟 MAC。把 OUI 列表放到 ~/.netdoctor/oui.txt (或安装 nmap) 即可显示厂商。")"
  echo "$(L "Devices that block ping may be missing; the ARP table only lists hosts that answered recently." "屏蔽 ping 的设备可能不会出现; ARP 表只包含近期有应答的主机。")"
}

ping_stats() { # $1 = host, $2 = count -> prints "loss avg" (avg empty if nothing answered)
  local out; out=$(ping -c "${2:-3}" -t 3 "$1" 2>/dev/null)
  printf '%s %s\n' "$(echo "$out" | awk -F', ' '/packet loss/{for(i=1;i<=NF;i++) if($i ~ /packet loss/){sub(/%.*/,"",$i); print $i}}')" \
                    "$(echo "$out" | awk -F'/' '/min\/avg\/max/{print $5}')"
}
resolves() { # $1 = name, $2 = optional DNS server
  if has dig; then dig ${2:+@$2} +short +time=3 +tries=1 "$1" 2>/dev/null | grep -q .
  else dscacheutil -q host -a name "$1" 2>/dev/null | grep -q ip_address; fi
}

skipped() { printf '[ -- ] %s\n' "$(L "$1/6 $2: skipped (an earlier step failed)" "$1/6 $3: 已跳过 (前面的步骤失败)")"; }

# ---- Wi-Fi 质量 (doctor 用) ---------------------------------------------------------------------------
# 从 system_profiler SPAirPortDataType 的输出 (标准输入) 取当前网络的 "信号|噪声|速率|信道"; 取不到的字段留空。
wifi_read() {
  awk '/Current Network Information/{f=1} /Other Local Wi-Fi/{f=0}
       f && /Signal \/ Noise:/ { gsub(/dBm/, ""); n = split($0, a, /[ \t\/]+/); for (i = 1; i <= n; i++) if (a[i] ~ /^-[0-9]+$/) { if (r == "") r = a[i]; else if (nz == "") nz = a[i] } }
       f && /Transmit Rate:/ { rate = $NF }
       f && /Channel:/ && ch == "" { sub(/^[ \t]*Channel: */, ""); ch = $0 }
       END { print r "|" nz "|" rate "|" ch }'
}
# 信号弱或噪声大时返回 0 并给出原因; 经验值: RSSI > -60 好, -70 一般, < -75 差; SNR (信号 - 噪声) 至少 25 才稳, 低于 20 明确偏差
wifi_weak() { # $1=RSSI $2=噪声 (可空)
  local r=$1 n=${2:-} snr="" why=""
  case "$r" in ""|*[!0-9-]*) return 1;; esac
  case "$n" in *[!0-9-]*) n="";; esac
  [ -n "$n" ] && snr=$((r - n))
  [ "$r" -le -70 ] && why="$(L "the signal is weak ($r dBm; better than -60 is good)" "信号偏弱 ($r dBm; 好于 -60 才算好)")"
  if [ -n "$snr" ] && [ "$snr" -lt 20 ]; then why="${why:+$why; }$(L "too much noise (SNR $snr dB; 25+ is stable)" "噪声太大 (信噪比 $snr dB; 25 以上才稳)")"; fi
  [ -n "$why" ] && { printf '%s' "$why"; return 0; }
  return 1
}

cmd_doctor() {
  case "${1:-}" in --fix|fix) shift; cmd_fix "$@"; return;; esac   # netdoctor doctor --fix = netdoctor fix
  local ifc gw verdict="" l avg ip_ok="" ip dns_ok dns_pub http_ok="" code u px vpn steps="" detail
  local FAILS=0 WARNS=0 skew="" wfpid="" wftmp="" wf="" wr wn wrate wch wsnr wwhy
  hdr "$(L "Diagnosis" "智能诊断")"
  # 1. link
  ifc=$(default_if); gw=$(gateway)
  local sa; sa=$(self_assigned_if)
  if [ -n "$sa" ] && { [ -z "$ifc" ] || [ "$sa" = "$ifc" ]; }; then
    bad "$(L "1/6 Link: $sa has a self-assigned 169.254.x.x address (the DHCP server did not answer)" "1/6 链路: $sa 只有自分配的 169.254.x.x 地址 (DHCP 服务器没有应答)")"; FAILS=$((FAILS+1)); verdict=dhcp; ifc=${ifc:-$sa}
  elif [ -z "$ifc" ]; then
    bad "$(L "1/6 Link: no default route (not connected)" "1/6 链路: 没有默认路由 (未联网)")"; FAILS=$((FAILS+1)); verdict=link
  else ok "$(L "1/6 Link: $ifc is the default interface" "1/6 链路: 默认网卡为 $ifc")"; fi
  # Wi-Fi 的详细数据要 system_profiler, 很慢 (十几秒): 放到后台跑, 和后面的检查并行, 最后再收结果
  if [ -z "${NETDOCTOR_NOWIFI:-}" ] && [ -n "$ifc" ] && [ "$ifc" = "$(wifi_if)" ] && has system_profiler && wftmp=$(mktemp); then
    system_profiler SPAirPortDataType >"$wftmp" 2>/dev/null & wfpid=$!
  fi
  # 2. gateway
  if [ -z "$verdict" ] && [ -n "$gw" ]; then
    set -- $(ping_stats "$gw" 3); l=${1:-100}; avg=${2:-}
    if [ -z "$avg" ]; then
      # 有些路由器禁 ping。先探测外网: 只要外网 IP 通, 就不是链路故障, 只提示网关不回应 ping
      for ip in 1.1.1.1 223.5.5.5 8.8.8.8; do set -- $(ping_stats "$ip" 1); [ -n "${2:-}" ] && { ip_ok=$ip; break; }; done
      if [ -n "$ip_ok" ]; then
        warn "$(L "2/6 Gateway $gw: does not answer ping, but the internet is reachable (the router probably blocks ICMP)" "2/6 网关 $gw: 不回应 ping, 但外网可达 (路由器可能禁了 ICMP)")"; WARNS=$((WARNS+1)); ip_ok=""
      else
        bad "$(L "2/6 Gateway $gw: no reply (Wi-Fi / cable / router)" "2/6 网关 $gw: 无应答 (Wi-Fi / 网线 / 路由器)")"; FAILS=$((FAILS+1)); verdict=gateway
      fi
    elif [ "${l%.*}" -gt 0 ]; then warn "$(L "2/6 Gateway $gw: ${l}% packet loss (avg $avg ms)" "2/6 网关 $gw: 丢包 ${l}% (平均 $avg ms)")"; WARNS=$((WARNS+1)); verdict=${verdict:-unstable}
    else ok "$(L "2/6 Gateway $gw: reachable (avg $avg ms)" "2/6 网关 $gw: 可达 (平均 $avg ms)")"; fi
  elif [ -z "$verdict" ]; then warn "$(L "2/6 Gateway: none reported (VPN-only or unusual setup); skipped" "2/6 网关: 未取得 (仅 VPN 或特殊配置); 已跳过")"
  else skipped 2 Gateway 网关; fi
  # 3. internet by IP
  if [ "$verdict" != link ] && [ "$verdict" != dhcp ] && [ "$verdict" != gateway ]; then
    for ip in 1.1.1.1 223.5.5.5 8.8.8.8; do
      set -- $(ping_stats "$ip" 3); l=${1:-100}; avg=${2:-}
      if [ -n "$avg" ]; then ip_ok=$ip; break; fi
    done
    if [ -z "$ip_ok" ]; then bad "$(L "3/6 Internet (by IP): 1.1.1.1 / 223.5.5.5 / 8.8.8.8 all unreachable" "3/6 外网 (按 IP): 1.1.1.1 / 223.5.5.5 / 8.8.8.8 均不通")"; FAILS=$((FAILS+1)); verdict=internet
    elif [ "${l%.*}" -gt 0 ] || [ "${avg%.*}" -gt 150 ]; then warn "$(L "3/6 Internet (by IP): $ip_ok answers but is unstable (${l}% loss, avg $avg ms)" "3/6 外网 (按 IP): $ip_ok 可达但不稳定 (丢包 ${l}%, 平均 $avg ms)")"; WARNS=$((WARNS+1)); verdict=${verdict:-unstable}
    else ok "$(L "3/6 Internet (by IP): $ip_ok reachable (avg $avg ms)" "3/6 外网 (按 IP): $ip_ok 可达 (平均 $avg ms)")"; fi
  else skipped 3 "Internet (by IP)" "外网 (按 IP)"; fi
  # 4. DNS
  if [ "$verdict" != link ] && [ "$verdict" != dhcp ] && [ "$verdict" != gateway ] && [ "$verdict" != internet ]; then
    dns_ok=""; for u in apple.com baidu.com; do resolves "$u" && dns_ok=1; done
    if [ -n "$dns_ok" ]; then ok "$(L "4/6 DNS: the system resolver works" "4/6 DNS: 系统解析正常")"
    else
      dns_pub=""; resolves apple.com 1.1.1.1 && dns_pub=1; [ -z "$dns_pub" ] && resolves baidu.com 223.5.5.5 && dns_pub=1
      if [ -n "$dns_pub" ]; then bad "$(L "4/6 DNS: the system resolver fails, public DNS works" "4/6 DNS: 系统解析失败, 公共 DNS 正常")"; verdict=dns
      else bad "$(L "4/6 DNS: both the system and public resolvers fail" "4/6 DNS: 系统与公共解析均失败")"; verdict=dns_all; fi
      FAILS=$((FAILS+1))
    fi
  else skipped 4 DNS DNS; fi
  # 5. HTTP
  if [ -z "$verdict" ] || [ "$verdict" = unstable ]; then
    for u in https://www.apple.com https://www.baidu.com https://www.cloudflare.com; do
      code=$(curl -s -o /dev/null -m 8 -w '%{http_code}' "$u" 2>/dev/null)
      case "$code" in 2*|3*) http_ok=$u; break;; esac
    done
    if [ -n "$http_ok" ]; then ok "$(L "5/6 HTTPS: $http_ok answers" "5/6 HTTPS: $http_ok 可访问")"
    else
      # HTTPS 打不开: 先分辨是不是强制门户 (登录页), 再看是不是本机时钟错得离谱 (证书会校验失败), 都不是才是泛泛的 http
      FAILS=$((FAILS+1)); captive_probe; skew=""
      if [ "$CAP_STATE" = portal ]; then
        bad "$(L "5/6 HTTPS: no test site answers, and plain HTTP returns a login / redirect page (captive portal)" "5/6 HTTPS: 测试站点都打不开, 而且普通 HTTP 返回的是登录 / 跳转页 (强制门户)")"; verdict=captive
      else
        skew=$(clock_skew)
        if [ -n "$skew" ] && [ "${skew#-}" -gt 300 ]; then
          bad "$(L "5/6 HTTPS: no test site answers, and this Mac's clock is off by about $(human_secs "$skew")" "5/6 HTTPS: 测试站点都打不开, 而且这台 Mac 的时钟偏差约 $(human_secs "$skew")")"; verdict=clock
        else
          bad "$(L "5/6 HTTPS: no test site answers although DNS and IP work" "5/6 HTTPS: DNS 与 IP 均正常, 但测试站点都打不开")"; verdict=http
        fi
      fi
    fi
  else skipped 5 HTTPS HTTPS; fi
  # 6. proxy / VPN (informational)
  px=$(scutil --proxy 2>/dev/null | awk '/HTTPEnable : 1|HTTPSEnable : 1|SOCKSEnable : 1/{n++} END{print n+0}')
  vpn=$(ifconfig 2>/dev/null | awk '/^[a-z0-9]+:/{n=$1; sub(":","",n)} /inet /{if (n ~ /^(utun|ppp|ipsec|tun|tap)/) printf "%s ", n}')
  if [ "$px" -gt 0 ] || [ -n "$vpn" ]; then
    detail=""; [ "$px" -gt 0 ] && detail="$(L "$px proxy setting(s) enabled" "已启用 $px 项代理")"
    [ -n "$vpn" ] && detail="${detail:+$detail; }$(L "tunnels: $vpn" "隧道: $vpn")"
    warn "$(L "6/6 Proxy / VPN: $detail (these can change what you see)" "6/6 代理 / VPN: $detail (可能影响判断)")"; WARNS=$((WARNS+1))
  else ok "$(L "6/6 Proxy / VPN: none active" "6/6 代理 / VPN: 未启用")"; fi
  if [ -n "$wfpid" ]; then
    # system_profiler 要 10 多秒; 最多等 NETDOCTOR_WIFI_WAIT 秒 (默认 20), 超时就放弃 Wi-Fi 这一行, 不让整个诊断卡住
    local wn_loops=$(( ${NETDOCTOR_WIFI_WAIT:-20} * 2 )) wk=0
    kill -0 "$wfpid" 2>/dev/null && echo "  $(L "(reading the Wi-Fi details takes up to ~15 s more; set NETDOCTOR_NOWIFI=1 to skip it)" "(正在读取 Wi-Fi 详情, 还需要十几秒; 设置 NETDOCTOR_NOWIFI=1 可跳过)")"
    while kill -0 "$wfpid" 2>/dev/null && [ "$wk" -lt "$wn_loops" ]; do sleep 0.5; wk=$((wk+1)); done
    kill -0 "$wfpid" 2>/dev/null && kill "$wfpid" 2>/dev/null
    wait "$wfpid" 2>/dev/null; IFS='|' read -r wr wn wrate wch <<EOF_WF
$(wifi_read <"$wftmp")
EOF_WF
    if [ -n "$wr" ]; then
      wsnr=""; [ -n "$wn" ] && wsnr=", $(L "noise" "噪声") $wn dBm"
      detail="$(L "signal" "信号") $wr dBm$wsnr${wrate:+, $wrate Mbps}${wch:+, $(L "channel" "信道") $wch}"
      if wwhy=$(wifi_weak "$wr" "$wn"); then warn "$(L "Wi-Fi: $detail — $wwhy" "Wi-Fi: $detail — $wwhy")"; WARNS=$((WARNS+1)); wf=1
      else ok "$(L "Wi-Fi: $detail" "Wi-Fi: $detail")"; fi
    fi
  fi
  [ -n "$wftmp" ] && rm -f "$wftmp"
  # Wi-Fi 太弱是网络慢 / 不稳的常见原因: 其他层都没有硬故障时, 把它作为结论
  if [ -n "$wf" ] && { [ -z "$verdict" ] || [ "$verdict" = unstable ]; }; then verdict=wifi; fi

  hdr "$(L "Verdict" "结论")"
  case "$verdict" in
    link)     bad "$(L "You are not connected to any network." "当前没有连接任何网络。")"
              steps="netdoctor wifi|$(L "Check that Wi-Fi is on and joined, or the cable is plugged in" "检查 Wi-Fi 是否已开启并连接, 或网线是否插好")";;
    dhcp)     bad "$(L "The Mac did not get an IP address from the router (DHCP failed), so it gave itself a 169.254.x.x address." "这台 Mac 没有从路由器拿到 IP 地址 (DHCP 失败), 只能给自己分配 169.254.x.x 地址。")"
              steps="netdoctor dhcp|$(L "See the details" "查看详情")
sudo ipconfig set $ifc DHCP|$(L "Renew the lease" "重新获取地址")
-|$(L "Turn Wi-Fi off and on, or re-plug the cable" "关闭再打开 Wi-Fi, 或重新插拔网线")
-|$(L "Restart the router; check that its DHCP address pool is not full" "重启路由器; 检查路由器的 DHCP 地址池是否已满")";;
    gateway)  bad "$(L "The link to your router is broken or very weak." "到路由器的链路不通或很弱。")"
              steps="netdoctor wifi|$(L "Check the signal strength; move closer to the router" "查看信号强度, 靠近路由器")
netdoctor lan|$(L "See whether other devices are reachable" "看看其他设备是否可达")
-|$(L "Restart the router and re-join the network" "重启路由器并重新连接")";;
    internet) bad "$(L "The router answers but there is no internet (ISP or upstream problem)." "路由器正常, 但无法访问外网 (运营商或上游问题)。")"
              steps="netdoctor route 1.1.1.1|$(L "See where the path stops" "看路径在哪一跳中断")
-|$(L "Restart the modem / router; if it persists, contact your ISP" "重启光猫 / 路由器, 仍不行请联系运营商")";;
    dns|dns_all) bad "$(L "DNS resolution is the problem: the internet works by IP." "问题出在 DNS 解析: 按 IP 访问外网是正常的。")"
              steps="netdoctor dnsbench|$(L "Find a faster, working DNS server" "找出更快且可用的 DNS 服务器")
netdoctor fixdns|$(L "Flush the DNS cache" "刷新 DNS 缓存")
netdoctor dns apple.com|$(L "Compare what each server answers" "对比各 DNS 服务器的应答")";;
    captive)  bad "$(L "A captive portal (a Wi-Fi login page) is blocking web access." "被强制门户 (Wi-Fi 登录页) 拦住了, 网页打不开。")"
              steps="netdoctor captive|$(L "Show the login page address" "查看登录页地址")
-|$(L "Open http://captive.apple.com in a browser and sign in to the Wi-Fi" "用浏览器打开 http://captive.apple.com, 登录这个 Wi-Fi")";;
    clock)    bad "$(L "This Mac's clock is wrong by about $(human_secs "$skew"), so HTTPS certificates fail to validate." "这台 Mac 的时钟偏差约 $(human_secs "$skew"), 导致 HTTPS 证书校验失败。")"
              steps="-|$(L "System Settings → General → Date & Time: turn on Set time and date automatically" "系统设置 → 通用 → 日期与时间: 打开“自动设置时间和日期”")
sudo sntp -sS time.apple.com|$(L "Or sync the clock right now from a terminal" "或在终端里立刻同步时间")
netdoctor http https://www.apple.com|$(L "Then check HTTPS again" "然后再确认 HTTPS")";;
    http)     bad "$(L "IP and DNS work, but web access fails (proxy, firewall, captive portal or TLS interception)." "IP 与 DNS 正常, 但网页访问失败 (代理、防火墙、认证网关或 TLS 拦截)。")"
              steps="netdoctor proxy|$(L "Check proxy and VPN settings" "检查代理和 VPN 设置")
netdoctor http https://www.apple.com|$(L "See which phase fails" "看是哪个阶段失败")
netdoctor tls www.apple.com|$(L "Check for a replaced certificate" "检查证书是否被替换")";;
    wifi)     warn "$(L "Connectivity works, but the Wi-Fi link itself is weak ($wwhy); that is the likely cause of slow or unstable connections." "网络可用, 但 Wi-Fi 链路本身偏弱 ($wwhy), 这很可能就是网速慢或不稳的原因。")"
              steps="netdoctor wifi|$(L "See the full Wi-Fi details" "查看完整的 Wi-Fi 信息")
-|$(L "Move closer to the router or remove obstacles (walls, metal, microwaves)" "靠近路由器, 或移开障碍物 (墙、金属、微波炉)")
-|$(L "Noisy: change the router's Wi-Fi channel, or use the 5 GHz band when you are near it" "噪声大: 换路由器的 Wi-Fi 信道, 离得近时优先用 5 GHz 频段")
netdoctor mtr 1.1.1.1|$(L "Check whether the loss is at the first hop (your Wi-Fi)" "看丢包是不是出在第一跳 (你的 Wi-Fi)")";;
    unstable) warn "$(L "Connectivity works but is unstable (packet loss or high latency)." "网络可用, 但不稳定 (丢包或延迟高)。")"
              steps="netdoctor wifi|$(L "Check the Wi-Fi signal and noise" "检查 Wi-Fi 信号和噪声")
netdoctor route 1.1.1.1|$(L "Find the lossy hop" "找出丢包的那一跳")
netdoctor mtu|$(L "Rule out MTU problems (VPN)" "排除 MTU 问题 (VPN)")";;
    *)        ok "$(L "Everything looks healthy." "一切正常。")";;
  esac
  if [ -n "$steps" ]; then
    echo "$(L "Next steps:" "建议下一步:")"
    printf '%s\n' "$steps" | while IFS='|' read -r cmd why; do
      if [ "$cmd" = "-" ]; then echo "  - $why"; else echo "  - $cmd   # $why"; fi
    done
  fi
  DOCTOR_VERDICT=$verdict; DOCTOR_IFC=$ifc   # 给 cmd_fix 用 (cmd_doctor 不在子 shell 里运行, 全局变量可见)
  [ -n "${NETDOCTOR_VERDICT_LINE:-}" ] && echo "verdict=${verdict:-ok}"   # 给 App 的健康历史用: 结论代码 (ok / dns / wifi / ...), 不会出现在人看的输出里
  [ "$FAILS" -eq 0 ] && [ "$verdict" != unstable ] && [ "$verdict" != wifi ]
}

# ---- fix: 按 doctor 的结论执行修复动作 ------------------------------------------------------------------
# 只做几件安全、可逆、有明确对应关系的事; 其他结论 (路由器 / 运营商 / 代理 / 证书) 没法自动修, 只给建议。
# 动作清单是固定的 (不拼接任意命令): renew_dhcp / flush_dns / sync_clock / open_portal
fix_actions() { # $1=verdict
  case "$1" in
    dhcp) echo renew_dhcp;;
    dns|dns_all) echo flush_dns;;
    clock) echo sync_clock;;
    captive) echo open_portal;;
  esac
}
fix_describe() { # $1=action $2=interface
  case "$1" in
    renew_dhcp)  L "Renew the DHCP lease on $2   (sudo ipconfig set $2 DHCP)" "重新获取 $2 的 DHCP 地址   (sudo ipconfig set $2 DHCP)";;
    flush_dns)   L "Flush the DNS cache   (dscacheutil -flushcache; killall -HUP mDNSResponder)" "刷新 DNS 缓存   (dscacheutil -flushcache; killall -HUP mDNSResponder)";;
    sync_clock)  L "Set the clock from time.apple.com   (sudo sntp -sS time.apple.com)" "从 time.apple.com 校准时钟   (sudo sntp -sS time.apple.com)";;
    open_portal) L "Open the Wi-Fi login page in your browser   (open http://captive.apple.com)" "用浏览器打开 Wi-Fi 登录页   (open http://captive.apple.com)";;
  esac
}
fix_needs_priv() { case "$1" in renew_dhcp|flush_dns|sync_clock) return 0;; esac; return 1; }
fix_apply() { # $1=action $2=interface ; 返回 0=成功
  case "$1" in
    renew_dhcp)  case "$2" in ""|*[!a-z0-9]*) return 1;; esac; priv ipconfig set "$2" DHCP;;
    flush_dns)   priv dscacheutil -flushcache && priv killall -HUP mDNSResponder;;
    sync_clock)  priv sntp -sS time.apple.com;;
    open_portal) [ "$(id -u)" != 0 ] && has open && open http://captive.apple.com;;   # root (网页 / App 的管理员模式) 下 open 打不开用户的浏览器
    *) return 1;;
  esac
}

cmd_fix() {
  local yes=0 verdict ifc a act desc applied=0 failed=0 skipped=0 ans
  case "${1:-}" in yes|--yes|-y) yes=1;; esac
  cmd_doctor || true
  verdict=$DOCTOR_VERDICT; ifc=$DOCTOR_IFC; act=$(fix_actions "$verdict")
  hdr "$(L "Fix" "修复")"
  if [ -z "$act" ]; then
    if [ -z "$verdict" ]; then ok "$(L "Nothing to fix." "没有需要修复的问题。")"; return 0; fi
    if [ "$verdict" = unstable ] || [ "$verdict" = wifi ]; then warn "$(L "No automatic fix for an unstable connection or a weak Wi-Fi signal; see the suggested steps above." "网络不稳定或 Wi-Fi 信号弱没有自动修复手段, 请按上面的建议排查。")"
    else warn "$(L "This problem cannot be fixed from the Mac (router, ISP, proxy or certificate); see the suggested steps above." "这类问题无法在这台 Mac 上自动修复 (路由器、运营商、代理或证书), 请按上面的建议处理。")"; fi
    return 1
  fi
  for a in $act; do
    desc=$(fix_describe "$a" "$ifc")
    echo "  → $desc"
    if [ "$a" = open_portal ] && [ "$(id -u)" = 0 ]; then   # root 下 open 打不开用户的浏览器: 不算失败, 请用户自己打开
      warn "$(L "Running as administrator, so the browser cannot be opened from here: open http://captive.apple.com yourself." "当前是管理员身份, 无法从这里打开浏览器: 请自己打开 http://captive.apple.com 登录。")"; skipped=$((skipped+1)); continue
    fi
    if [ "$yes" != 1 ]; then
      if [ -t 0 ]; then printf '%s' "$(L "    Apply it? [y/N] " "    要执行吗? [y/N] ")"; read -r ans || ans=""; case "$ans" in y|Y|yes|YES) ;; *) skipped=$((skipped+1)); echo "    $(L "skipped" "已跳过")"; continue;; esac
      else skipped=$((skipped+1)); continue; fi
    fi
    if fix_needs_priv "$a" && ! can_priv; then bad "$(L "Needs administrator rights: run  sudo netdoctor fix yes  in a terminal (or tick Administrator rights)" "需要管理员权限: 请在终端运行  sudo netdoctor fix yes  (或勾选 管理员权限)")"; failed=$((failed+1)); continue; fi
    if fix_apply "$a" "$ifc"; then ok "$(L "Done" "已执行")"; applied=$((applied+1))
    else bad "$(L "Failed (wrong password, or no permission)" "执行失败 (密码错误或没有权限)")"; failed=$((failed+1)); fi
  done
  if [ "$applied" = 0 ]; then
    if [ "$skipped" -gt 0 ] && [ ! -t 0 ] && [ "$yes" != 1 ]; then echo "$(L "Nothing was changed. To apply the fix, run  netdoctor fix yes  (in the app: tick \"Apply without asking\")." "没有做任何修改。要执行修复, 请运行  netdoctor fix yes  (App / 网页里勾选“不再询问, 直接执行”)。")"; fi
    return 1
  fi
  sleep 3
  hdr "$(L "Checking again" "重新检查")"
  cmd_doctor
}

# ---- watch: 命令行持续监控 -------------------------------------------------------------------------------
# 每秒 ping 一次; 连续 3 次丢包记为断线 (终端响铃), 恢复时报告中断时长; 结束 (Ctrl-C 或到时) 打印汇总。
# watch_summary 读 "时间戳 毫秒" 行 (丢包写 -), 输出汇总, 单独成函数以便测试。
watch_summary() { # $1=host
  awk -v host="$1" -v zh="$ZH" '
    function p(en, cn) { print (zh == 1 ? cn : en) }
    { n++; t[n] = $1
      if ($2 == "-") { lost++; if (run == 0) first = $1; run++
        if (run == 3) { inout = 1; ostart = first } }
      else { ms = $2 + 0; ok++; sum += ms; if (min == "" || ms < min) min = ms; if (ms > max) max = ms
        if (havelast) { d = ms - last; if (d < 0) d = -d; jsum += d; jn++ }
        last = ms; havelast = 1
        if (inout) { no++; ostartv[no] = ostart; odur[no] = $1 - ostart; inout = 0 }
        run = 0 } }
    END {
      if (n == 0) { p("No samples.", "没有采样。"); exit }
      if (inout) { no++; ostartv[no] = ostart; odur[no] = t[n] - ostart + 1; ongoing = 1 }
      printf("%s\n", (zh == 1 ? "目标 " host ": 共 " n " 次, 丢包 " lost+0 " 次 (" sprintf("%.1f", lost * 100 / n) "%)" : "Target " host ": " n " pings, " lost+0 " lost (" sprintf("%.1f", lost * 100 / n) "%)"))
      if (ok > 0) printf("%s\n", (zh == 1 ? "延迟 最小/平均/最大 = " : "Latency min/avg/max = ") sprintf("%.1f/%.1f/%.1f", min, sum / ok, max) " ms" (jn > 0 ? (zh == 1 ? ", 抖动 " : ", jitter ") sprintf("%.1f", jsum / jn) " ms" : ""))
      if (no == 0) p("No outage (an outage = 3 pings lost in a row).", "没有断线 (连续丢 3 次才算断线)。")
      else { printf("%s\n", (zh == 1 ? "断线 " no " 次:" : no " outage(s):"))
        for (i = 1; i <= no; i++) printf("  - %s%s\n", (zh == 1 ? "第 " (ostartv[i] - t[1]) " 秒起, 持续 " odur[i] " 秒" : "from +" (ostartv[i] - t[1]) " s, lasted " odur[i] " s"), (ongoing && i == no ? (zh == 1 ? " (结束时仍未恢复)" : " (still down at the end)") : "")) }
    }
    '
}

cmd_watch() {
  local h=${1:-1.1.1.1} secs=${2:-60} i=0 now out ms streak=0 down_at="" alerted=0 stop=0 f recent_ok=0 recent_n=0 recent_sum=0
  case "$h" in *[!A-Za-z0-9._:-]*|-*) bad "$(L "Invalid host: $h" "主机无效: $h")"; return 1;; esac
  case "$secs" in *[!0-9]*|"") bad "$(L "Seconds must be a number from 5 to 3600" "秒数必须是 5 到 3600 的数字")"; return 1;; esac
  if [ "$((10#$secs))" -lt 5 ] || [ "$((10#$secs))" -gt 3600 ]; then bad "$(L "Seconds must be a number from 5 to 3600" "秒数必须是 5 到 3600 的数字")"; return 1; fi
  secs=$((10#$secs)); f=$(mktemp) || { bad "$(L "Could not create a temporary file" "无法创建临时文件")"; return 1; }
  hdr "$(L "Watching $h for $secs s (Ctrl-C to stop early)" "监控 $h, 共 $secs 秒 (Ctrl-C 可提前结束)")"
  trap 'stop=1' INT
  local end=$(( $(date +%s) + secs )) t1
  while [ "$(date +%s)" -lt "$end" ] && [ "$stop" = 0 ]; do   # 按挂钟时间计时: 目标不通时每次 ping 要等超时, 按次数会远远超过设定的秒数
    i=$((i+1)); now=$(date +%s)
    out=$(ping -c 1 -W 1000 "$h" 2>/dev/null); ms=$(printf '%s' "$out" | sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p' | head -1)
    recent_n=$((recent_n+1))
    if [ -n "$ms" ]; then
      echo "$now $ms" >>"$f"; recent_ok=$((recent_ok+1)); recent_sum=$(awk -v a="$recent_sum" -v b="$ms" 'BEGIN{print a+b}')
      if [ "$alerted" = 1 ]; then ok "$(date +%H:%M:%S) $(L "Back online after $((now - down_at)) s" "恢复连接, 中断了 $((now - down_at)) 秒")"; alerted=0; fi
      streak=0; down_at=""
    else
      echo "$now -" >>"$f"
      [ "$streak" = 0 ] && down_at=$now
      streak=$((streak+1))
      if [ "$streak" = 3 ] && [ "$alerted" = 0 ]; then alerted=1; bad "$(date +%H:%M:%S) $(L "Connection lost (3 pings in a row)" "断线 (连续 3 次 ping 失败)")"; [ -t 1 ] && printf '\a'; fi
    fi
    if [ $((i % 10)) = 0 ]; then
      if [ "$recent_ok" -gt 0 ]; then echo "  $(date +%H:%M:%S)  $(L "last 10: $recent_ok/$recent_n answered, avg $(awk -v a="$recent_sum" -v b="$recent_ok" 'BEGIN{printf "%.1f", a/b}') ms" "最近 10 次: 应答 $recent_ok/$recent_n, 平均 $(awk -v a="$recent_sum" -v b="$recent_ok" 'BEGIN{printf "%.1f", a/b}') ms")"
      else echo "  $(date +%H:%M:%S)  $(L "last 10: no answer" "最近 10 次: 无应答")"; fi
      recent_ok=0; recent_n=0; recent_sum=0
    fi
    t1=$(date +%s); [ "$t1" -le "$now" ] && [ "$stop" = 0 ] && sleep 1   # ping 很快返回才补足 1 秒; 超时的那次本身已经等够了
  done
  trap - INT
  hdr "$(L "Summary" "汇总")"
  watch_summary "$h" <"$f"; rm -f "$f"
}

# ---- compare: 对比两份 report ---------------------------------------------------------------------------
# 把每次都会变的数字 (延迟、信号、耗时、百分比) 抹平后再 diff, 只剩真正的变化: 换了网络、DNS、网关、IP、检查结论等。
compare_norm() { # 标准输入 → 标准输出; 去掉第一行 (含时间)
  sed -E -e '1{/^netdoctor report/d;}' \
    -e 's/-?[0-9]+(\.[0-9]+)? ?(ms|dBm|dB|%|Mbps|Mbit\/s)/#\2/g' \
    -e 's/ [0-9]+\.[0-9]+s$/ #s/' \
    -e 's/[0-9]{2}:[0-9]{2}:[0-9]{2}/##:##:##/g' \
    -e 's/ +/ /g' -e 's/ +$//'   # 数字宽度变了会改变列对齐: 压缩空白
}
compare_count() { grep -c -- "$1" "$2" 2>/dev/null || true; }
cmd_compare() {
  local a=${1:-} b=${2:-} d f list n d1 d2
  if [ -z "$a" ] && [ -z "$b" ]; then
    list=$(ls -t "$HOME/Desktop"/netdoctor-report-*.txt "$HOME"/netdoctor-report-*.txt 2>/dev/null | awk '!s[$0]++' | head -2)   # 一起按时间排序
    n=$(printf '%s\n' "$list" | grep -c .)
    if [ "$n" -lt 2 ]; then bad "$(L "Need two saved reports (netdoctor report) on the Desktop or in your home folder; found $n. Or: netdoctor compare <older.txt> <newer.txt>" "需要两份已保存的报告 (netdoctor report), 放在桌面或主目录里, 现在只找到 $n 份。也可以: netdoctor compare <旧报告.txt> <新报告.txt>")"; return 1; fi
    b=$(printf '%s\n' "$list" | sed -n 1p); a=$(printf '%s\n' "$list" | sed -n 2p)   # ls -t: 最新的在前
  elif [ -z "$b" ]; then echo "$(L "Usage: netdoctor compare [<older report> <newer report>]  (no arguments: the two newest saved reports)" "用法: netdoctor compare [<旧报告> <新报告>]  (不带参数: 对比最新的两份报告)")"; return 1; fi
  for f in "$a" "$b"; do
    [ -r "$f" ] && [ -f "$f" ] || { bad "$(L "Cannot read: $f" "无法读取: $f")"; return 1; }
    case "$f" in *.html) bad "$(L "Only .txt reports can be compared (save the report without \"html\"): $f" "只能对比 .txt 报告 (保存时不要加 html): $f")"; return 1;; esac
    head -1 "$f" | grep -q '^netdoctor report\|^# ' || { bad "$(L "Not a netdoctor report: $f" "不是 netdoctor 的报告: $f")"; return 1; }
  done
  d1=$(mktemp); d2=$(mktemp); compare_norm <"$a" >"$d1"; compare_norm <"$b" >"$d2"
  hdr "$(L "Comparing reports" "对比报告")"
  echo "  $(L "older" "旧"): $a"; echo "  $(L "newer" "新"): $b"
  echo "  $(L "Problems" "问题数"): FAIL $(compare_count '^\[FAIL\]' "$a") → $(compare_count '^\[FAIL\]' "$b"),  WARN $(compare_count '^\[WARN\]' "$a") → $(compare_count '^\[WARN\]' "$b")"
  hdr "$(L "What changed (timings ignored)" "变化的内容 (已忽略延迟等数字波动)")"
  if diff -q "$d1" "$d2" >/dev/null; then ok "$(L "Nothing changed apart from timings." "除了延迟等数字波动, 没有任何变化。")"; rm -f "$d1" "$d2"; return 0; fi
  diff -U0 "$d1" "$d2" | sed -n '/^[-+]/p' | grep -v '^---\|^+++' | sed -E "s/^-/  $(L "was" "之前")  /; s/^\+/  $(L "now" "现在")  /"
  rm -f "$d1" "$d2"   # 有变化也返回 0: 对比本身成功了 (和 diff 不同, 这里的“有差异”不是错误)
}

cmd_tcpping() {
  local h=${1:-} p=${2:-} n=${3:-10} line seq ms sent okc min avg max loss
  if [ -z "$h" ] || [ -z "$p" ]; then echo "$(L "Usage: netdoctor tcpping <host> <port> [count]" "用法: netdoctor tcpping <主机> <端口> [次数]")"; return 1; fi
  case "$h" in *[!A-Za-z0-9._:-]*|-*) bad "$(L "Invalid host: $h" "主机无效: $h")"; return 1;; esac
  case "$p$n" in *[!0-9]*|"") bad "$(L "Port and count must be numbers" "端口和次数必须是数字")"; return 1;; esac
  if [ "$((10#$p))" -lt 1 ] || [ "$((10#$p))" -gt 65535 ] || [ "$((10#$n))" -lt 1 ] || [ "$((10#$n))" -gt 100 ]; then bad "$(L "Port must be 1-65535 and count 1-100" "端口范围 1-65535, 次数范围 1-100")"; return 1; fi
  has perl || { bad "$(L "perl not found" "未找到 perl")"; return 1; }
  hdr "$(L "TCP connect latency to $h:$p" "到 $h:$p 的 TCP 连接延迟")"
  # 注意: 不用 IO::Socket::INET 的 Timeout (非阻塞 connect), 它在 macOS 上会把 "连接被拒绝" 误判为成功
  perl -MSocket=:DEFAULT,getaddrinfo -MTime::HiRes=time,sleep,alarm -e '
    $| = 1; my ($h, $p, $n) = @ARGV; my ($ok, $sum, $min, $max) = (0, 0, 1e9, 0);
    my ($err, @res) = getaddrinfo($h, $p, { socktype => SOCK_STREAM });
    for my $i (1 .. $n) {
      my $t = time; my $good = 0;
      if (!$err && @res) {
        my $r = $res[0];
        if (socket(my $s, $r->{family}, SOCK_STREAM, 0)) {
          eval { local $SIG{ALRM} = sub { die "timeout\n" }; alarm(2); $good = connect($s, $r->{addr}) ? 1 : 0; alarm(0); 1 } or do { alarm(0); $good = 0 };
          close $s;
        }
      }
      my $ms = (time - $t) * 1000;
      if ($good) { $ok++; $sum += $ms; $min = $ms if $ms < $min; $max = $ms if $ms > $max; printf "OK %d %.1f\n", $i, $ms }
      else { printf "FAIL %d\n", $i }
      sleep(0.4) if $i < $n;
    }
    printf "STATS %d %d %.1f %.1f %.1f\n", $n, $ok, ($ok ? $min : 0), ($ok ? $sum / $ok : 0), ($ok ? $max : 0);
  ' "$h" "$p" "$n" | { rc=1; while read -r line; do
    set -- $line
    case "$1" in
      OK)   echo "  #$2  $3 ms";;
      FAIL) echo "  #$2  $(L "failed (refused or timed out)" "失败 (被拒绝或超时)")";;
      STATS) sent=$2; okc=$3
             if [ "$okc" -eq 0 ]; then rc=1; bad "$(L "$sent sent, none connected" "发送 $sent 次, 全部失败")"
             else rc=0; loss=$(( (sent - okc) * 100 / sent ))
                  ok "$(L "$sent sent, $okc connected (${loss}% loss), min/avg/max = $4/$5/$6 ms" "发送 $sent 次, 成功 $okc 次 (丢包 ${loss}%), 最小/平均/最大 = $4/$5/$6 ms")"; fi;;
    esac
  done; exit "$rc"; }
}

# ping6 自己没有总超时: 目标不通时会拖很久。后台跑, 到点杀掉; 输出 "丢包% 平均ms" (平均为空表示一个都没回)。
# 参数: 目标 个数 包大小 (包大小可空) 总超时秒数
ping6_stats() {
  local out pid wd f; f=$(mktemp) || return 1
  ping6 -c "${2:-3}" -i 0.3 -n ${3:+-s "$3"} "$1" >"$f" 2>&1 & pid=$!
  ( sleep "${4:-6}"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 & wd=$!
  wait "$pid" 2>/dev/null; kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
  out=$(cat "$f"); rm -f "$f"
  # 被超时杀掉时 ping6 不会打印汇总: 退回到逐包的 time= 自己算平均, 慢但能通的链路不会被误判为不通
  local loss avg
  loss=$(echo "$out" | awk -F', ' '/packet loss/{for(i=1;i<=NF;i++) if($i ~ /packet loss/){sub(/%.*/,"",$i); print $i}}')
  avg=$(echo "$out" | awk -F'/' '/min\/avg\/max/{print $5}')
  [ -n "$avg" ] || avg=$(echo "$out" | awk '/bytes from/{for(i=1;i<=NF;i++) if($i ~ /^time=/){sub(/time=/,"",$i); n++; t+=$i}} END{if(n) printf "%.3f", t/n}')
  # 丢包为空 (被杀掉时没有汇总行) 时用 - 占位: 调用方用 set -- $(...) 按空白拆词, 开头的空字段会被吞掉, 平均值就会挪到 $1
  printf '%s %s\n' "${loss:--}" "$avg"
}

# 结论。参数是 key=value 事实 (没测的留空):
#   glob=1 有全局 IPv6 地址   ula=1 只有唯一本地地址 (fd00::/8)   gw=1 有 IPv6 默认路由   gwok=1/0 路由器 ping 通/不通
#   ipok=1/0 按 IP 能/不能上外网   bigok=1/0 大包能/不能通过   nameok=1/0 按域名的 HTTPS 能/不能通   aaaa=1/0 DNS 有/无 AAAA 应答
#   v4ok=1/0 IPv4 是否通   t4 t6 到同一站点的 TCP 建连毫秒数
# 有故障返回 1 (和 doctor / leak 一致: 只有 bad 算失败, warn 不算)。
ipv6_assess() {
  local glob=0 ula=0 gw=0 gwok="" ipok="" bigok="" nameok="" aaaa="" v4ok="" t4="" t6="" tun=0 kv
  for kv in "$@"; do
    case "$kv" in tun=*) tun=${kv#*=};; glob=*) glob=${kv#*=};; ula=*) ula=${kv#*=};; gw=*) gw=${kv#*=};; gwok=*) gwok=${kv#*=};; ipok=*) ipok=${kv#*=};; bigok=*) bigok=${kv#*=};;
      nameok=*) nameok=${kv#*=};; aaaa=*) aaaa=${kv#*=};; v4ok=*) v4ok=${kv#*=};; t4=*) t4=${kv#*=};; t6=*) t6=${kv#*=};; esac
  done
  if [ "$tun" = 1 ]; then
    warn "$(L "Not diagnosed: the IPv6 default route goes through a VPN / tunnel, so the router and the IPv6 internet path were not tested. Disconnect the VPN and run this again." "未诊断: IPv6 默认路由走的是 VPN / 隧道, 没有测试路由器和 IPv6 外网链路。断开 VPN 后再试。")"
    return 0
  fi
  if [ "$glob" != 1 ]; then
    if [ "$gw" = 1 ] || [ "$ula" = 1 ]; then
      warn "$(L "This network hands out only local IPv6 (no globally routable address): the router has IPv6 on, but your ISP gives it no IPv6 prefix. Everything runs over IPv4; this is harmless." "这个网络只有本地 IPv6 (没有可路由的公网地址): 路由器开了 IPv6, 但运营商没有分配 IPv6 前缀。一切都走 IPv4, 无碍。")"
    else
      warn "$(L "This network provides no IPv6 at all (no address, no IPv6 router). Everything runs over IPv4; this is harmless unless you need IPv6-only sites." "这个网络完全没有 IPv6 (没有地址, 也没有 IPv6 路由器)。一切都走 IPv4; 除非要访问仅 IPv6 的站点, 否则无碍。")"
    fi
    return 0
  fi
  if [ "$gw" != 1 ]; then
    bad "$(L "You have a global IPv6 address but no IPv6 default route: the router's advertisement (RA) is missing or partial, so IPv6 cannot leave the LAN. Reconnect the network or reboot the router; if it keeps happening, turn IPv6 off for this service (networksetup -setv6off <service>)." "有全局 IPv6 地址却没有 IPv6 默认路由: 路由器的通告 (RA) 缺失或不完整, IPv6 出不了局域网。重新连接网络或重启路由器; 反复出现就对该网络服务关闭 IPv6 (networksetup -setv6off <服务名>)。")"; return 1
  fi
  if [ "$gwok" = 0 ]; then
    bad "$(L "The IPv6 router does not answer: the link to the router is broken for IPv6 (Wi-Fi / cable / router IPv6 service)." "IPv6 路由器没有应答: 到路由器的 IPv6 链路不通 (Wi-Fi / 网线 / 路由器的 IPv6 服务)。")"; return 1
  fi
  if [ "$ipok" = 0 ]; then
    bad "$(L "The IPv6 router answers but IPv6 cannot reach the internet: the fault is upstream (your ISP's IPv6, or the router's IPv6 uplink). Websites with IPv6 load slowly because the Mac waits and falls back to IPv4. Turn IPv6 off for this service (networksetup -setv6off <service>) or in the router until the ISP fixes it." "IPv6 路由器有应答, 但 IPv6 到不了外网: 故障在上游 (运营商的 IPv6 或路由器的 IPv6 上行)。有 IPv6 的网站会因为 Mac 先等待再回退到 IPv4 而变慢。可对该网络服务关闭 IPv6 (networksetup -setv6off <服务名>), 或在路由器里关掉, 等运营商修好再开。")"; return 1
  fi
  if [ "$bigok" = 0 ]; then
    bad "$(L "Small IPv6 packets get through but large ones are lost: a path-MTU black hole (a tunnel / VPN / router with a smaller MTU that does not report it). Pages start loading and then stall. Try: netdoctor mtu, or lower the MTU of this interface / the router's IPv6 MTU." "IPv6 小包能通、大包丢失: 路径 MTU 黑洞 (隧道 / VPN / MTU 更小的路由器没有回报)。表现为网页开了头就卡住。可试: netdoctor mtu, 或调低这块网卡 / 路由器的 IPv6 MTU。")"; return 1
  fi
  if [ "$nameok" = 0 ]; then
    if [ "$aaaa" = 0 ]; then
      warn "$(L "IPv6 reaches the internet by address, but your DNS gives no IPv6 (AAAA) answers, so sites are reached over IPv4. Harmless; use a resolver that supports IPv6 if you want IPv6." "IPv6 按地址能上外网, 但你的 DNS 没有给出 IPv6 (AAAA) 应答, 所以网站走的是 IPv4。无碍; 想用 IPv6 可换支持 IPv6 的 DNS。")"
    else
      warn "$(L "IPv6 works by address, but HTTPS over IPv6 to a real site fails: a firewall / filter blocks IPv6 on port 443, or the site's IPv6 is down. Sites fall back to IPv4 after a delay." "IPv6 按地址能通, 但对真实站点的 IPv6 HTTPS 失败: 防火墙 / 过滤器拦了 IPv6 的 443 端口, 或该站点的 IPv6 本身有问题。网站会在延迟后回退到 IPv4。")"
    fi
    return 0
  fi
  if [ -n "$t4" ] && [ -n "$t6" ] && [ "$t6" -gt $((t4 + 300)) ]; then
    warn "$(L "IPv6 works but is much slower to connect than IPv4 (${t6} ms vs ${t4} ms), so some sites feel sluggish. The IPv6 path is poor; consider turning IPv6 off for this service." "IPv6 能用, 但建立连接比 IPv4 慢很多 (${t6} ms 对 ${t4} ms), 部分网站会觉得卡。IPv6 链路质量差, 可考虑对该网络服务关闭 IPv6。")"; return 0
  fi
  if [ "$v4ok" = 0 ]; then
    ok "$(L "IPv6 works (IPv6-only connectivity: IPv4 is not reachable)." "IPv6 正常 (只有 IPv6 连通: IPv4 不通)。")"
  else
    ok "$(L "IPv6 is healthy: address, router, internet and websites all work over IPv6." "IPv6 正常: 地址、路由器、外网和网站都能走 IPv6。")"
  fi
  return 0
}

cmd_ipv6() {
  local g ula gwline gw gwif gwif2 tun=0 gwok="" a6 v4 v6 u=https://api.ip.sb/ip ipok="" bigok="" nameok="" aaaa=0 t4="" t6="" h=www.google.com dns6 p6='' alt hh th
  hdr "$(L "IPv6 addresses" "IPv6 地址")"
  # 排除链路本地 (fe80) 与唯一本地/私有 (fc00::/7), 它们不能访问公网
  # 只看默认路由所在的物理网卡; VPN / 叠加网络 (utun*) 的地址 (如 Tailscale 的 fd7a:) 不代表这个网络有没有 IPv6
  gwline=$(route -n get -inet6 default 2>/dev/null); gw=$(echo "$gwline" | awk '/gateway:/{print $2; exit}'); gwif=$(echo "$gwline" | awk '/interface:/{print $2; exit}')
  # 没有 IPv6 默认路由时 gwif 为空: 只看 IPv4 默认路由所在的网卡 (它才是"这个网络"); 别的网卡 (USB 网卡、虚拟网卡) 上的地址不算。
  # "-" 不会匹配任何网卡名, 即在拿不到主网卡时不把任何地址当作这个网络的
  case "$gwif" in
    utun*|ipsec*|ppp*|gif*|stf*) tun=1; gwif2="";;
    "") gwif2=$(default_if); case "$gwif2" in ""|utun*|ipsec*|ppp*|gif*|stf*) gwif2="-";; esac;;
    *) gwif2=$gwif;;
  esac
  g=$(ifconfig | awk -v want="$gwif2" '/^[^ \t]/{i=$1; sub(/:$/,"",i)} i ~ /^(utun|ipsec|ppp|gif|stf|awdl|llw|lo)/{next} want!="" && i!=want{next} /inet6 / && $2 !~ /^fe80|^::1|^f[cd]/{print $2}' | head -3)
  ula=$(ifconfig | awk -v want="$gwif2" '/^[^ \t]/{i=$1; sub(/:$/,"",i)} i ~ /^(utun|ipsec|ppp|gif|stf|awdl|llw|lo)/{next} want!="" && i!=want{next} /inet6 / && $2 ~ /^f[cd]/{print $2}' | head -3)
  if [ -n "$g" ]; then ok "$(L "Global IPv6 address present" "存在全局 IPv6 地址")"; echo "$g" | sed 's/^/   /'
  else warn "$(L "No global IPv6 address, only link-local/private ones (IPv6-only sites will be unreachable; usually harmless)" "没有全局 IPv6 地址, 只有本地/私有地址 (仅 IPv6 的站点打不开; 通常无碍)")"
    [ -n "$ula" ] && echo "$ula" | sed 's/^/   /'; fi
  hdr "$(L "IPv6 router (default route)" "IPv6 路由器 (默认路由)")"
  if [ "$tun" = 1 ]; then
    warn "$(L "The IPv6 default route goes through a VPN / tunnel ($gwif): the router and the IPv6 internet path cannot be diagnosed separately; disconnect the VPN and run this again." "IPv6 默认路由走的是 VPN / 隧道 ($gwif): 无法单独诊断路由器和 IPv6 外网链路; 断开 VPN 后再试。")"
  elif [ -n "$gw" ]; then
    echo "  $gw ${gwif:+($gwif)}"
    set -- $(ping6_stats "$gw" 2 "" 4); [ -n "${2:-}" ] && gwok=1 || gwok=0
    if [ "$gwok" = 1 ]; then ok "$(L "The IPv6 router answers (avg ${2} ms)" "IPv6 路由器有应答 (平均 ${2} ms)")"; else bad "$(L "The IPv6 router does not answer" "IPv6 路由器没有应答")"; fi
  else warn "$(L "No IPv6 default route" "没有 IPv6 默认路由")"; fi
  hdr "$(L "DNS AAAA records" "DNS AAAA 记录")"
  dns6=$(scutil --dns 2>/dev/null | awk '/nameserver\[[0-9]+\]/ && $3 ~ /:/ {print $3}' | awk '!s[$0]++' | head -3)
  [ -n "$dns6" ] && echo "  $(L "IPv6 DNS servers" "IPv6 DNS 服务器"): $(echo $dns6)"
  a6=$(dig +short +time=3 +tries=1 AAAA "$h" 2>/dev/null | head -1)
  if [ -n "$a6" ]; then aaaa=1; ok "$h → $a6"; else warn "$(L "No AAAA answer for $h" "$h 没有 AAAA 应答")"; fi
  hdr "$(L "Reachability: IPv4 vs IPv6" "连通性: IPv4 vs IPv6")"
  v4=$(curl -4 -s -m 5 "$u" 2>/dev/null); v6=$(curl -6 -s -m 5 "$u" 2>/dev/null)
  if [ -n "$v4" ]; then ok "IPv4  $v4"; else bad "$(L "IPv4 request failed" "IPv4 请求失败")"; fi
  if [ -n "$v6" ]; then ok "IPv6  $v6"; else warn "$(L "IPv6 request failed" "IPv6 请求失败")"; fi
  if [ "$tun" = 0 ] && [ -n "$g" ] && [ -n "$gw" ]; then
    hdr "$(L "Deeper IPv6 probes" "IPv6 深入探测")"
    set -- $(ping6_stats 2001:4860:4860::8888 3 "" 4); if [ -n "${2:-}" ]; then ipok=1; p6=2001:4860:4860::8888; ok "$(L "By address (2001:4860:4860::8888): reachable, avg ${2} ms" "按地址 (2001:4860:4860::8888): 可达, 平均 ${2} ms")"
    else set -- $(ping6_stats 2606:4700:4700::1111 3 "" 4); if [ -n "${2:-}" ]; then ipok=1; p6=2606:4700:4700::1111; ok "$(L "By address (2606:4700:4700::1111): reachable, avg ${2} ms" "按地址 (2606:4700:4700::1111): 可达, 平均 ${2} ms")"
      else ipok=0; bad "$(L "By address: both public IPv6 DNS servers unreachable" "按地址: 两个公共 IPv6 DNS 服务器都不通")"; fi; fi
    if [ "$ipok" = 1 ]; then
      # 用刚才应答的那个地址测大包; 不通再换另一个, 避免只因一个目标被过滤就判成 MTU 黑洞
      set -- $(ping6_stats "$p6" 3 1400 4)
      if [ -z "${2:-}" ]; then alt=2606:4700:4700::1111; [ "$p6" = "$alt" ] && alt=2001:4860:4860::8888; set -- $(ping6_stats "$alt" 3 1400 4); fi
      if [ -n "${2:-}" ]; then bigok=1; ok "$(L "Large packets (1400 bytes): pass" "大包 (1400 字节): 通过")"
      else bigok=0; bad "$(L "Large packets (1400 bytes): lost" "大包 (1400 字节): 丢失")"; fi
    fi
    # 以 TLS 握手完成 (time_appconnect > 0) 为成功, 不看 HTTP 状态码 (403 / 429 也说明 IPv6 通了);
    # 依次试几个站点, 避免某个站点本身被墙 / 故障就怪到 IPv6 头上
    nameok=0; t6=""; t4=""
    for hh in www.google.com www.cloudflare.com www.baidu.com; do
      th=$(curl -6 -s -o /dev/null -m 4 -w '%{time_appconnect} %{time_connect}' "https://$hh" 2>/dev/null)
      if [ -n "${th%% *}" ] && awk -v a="${th%% *}" 'BEGIN{exit !(a>0)}'; then
        nameok=1; h=$hh; t6=$(echo "$th" | awk '{printf "%d", $2*1000}'); break
      fi
      [ -n "$(dig +short +time=2 +tries=1 AAAA "$hh" 2>/dev/null | head -1)" ] && aaaa=1
    done
    if [ "$nameok" = 1 ]; then ok "$(L "HTTPS over IPv6 to $h: connected in ${t6} ms" "经 IPv6 访问 $h 的 HTTPS: ${t6} ms 建连")"
    else warn "$(L "HTTPS over IPv6 failed for all test sites" "经 IPv6 访问测试站点的 HTTPS 全部失败")"; fi
    if [ "$nameok" = 1 ]; then
      th=$(curl -4 -s -o /dev/null -m 4 -w '%{time_appconnect} %{time_connect}' "https://$h" 2>/dev/null)
      if [ -n "${th%% *}" ] && awk -v a="${th%% *}" 'BEGIN{exit !(a>0)}'; then t4=$(echo "$th" | awk '{printf "%d", $2*1000}'); fi
    fi
    [ -n "$t4" ] && echo "  $(L "(IPv4 to the same site: ${t4} ms)" "(同一站点走 IPv4: ${t4} ms)")"
  fi
  hdr "$(L "Verdict" "结论")"
  local rc; ipv6_assess glob=$([ -n "$g" ] && echo 1 || echo 0) ula=$([ -n "$ula" ] && echo 1 || echo 0) gw=$([ -n "$gw" ] && echo 1 || echo 0) gwok=$gwok \
    ipok=$ipok bigok=$bigok nameok=$nameok aaaa=$aaaa v4ok=$([ -n "$v4" ] && echo 1 || echo 0) t4=$t4 t6=$t6 tun=$tun
  rc=$?
  return $rc
}

# 强制门户探测。结果放在全局变量 CAP_STATE (ok | portal | offline) 和 CAP_REDIR (登录页地址),
# 不用 $(...) 返回, 因为子 shell 会丢掉变量。cmd_captive 和 doctor 共用。
captive_probe() {
  local u=http://captive.apple.com/hotspot-detect.html body
  CAP_STATE=offline; CAP_REDIR=""
  body=$(curl -s -m 8 "$u" 2>/dev/null); CAP_REDIR=$(curl -s -m 8 -o /dev/null -w '%{redirect_url}' "$u" 2>/dev/null)
  [ -z "$body" ] && [ -z "$CAP_REDIR" ] && return 0
  # Apple 的应答是 <HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>; 只认它, 不能是页面里随便出现 "Success" 字样
  if echo "$body" | grep -qi '<title>Success</title>' && [ -z "$CAP_REDIR" ]; then CAP_STATE=ok; else CAP_STATE=portal; fi
}

# 本机时钟与服务器时间的差 (秒, 本机减服务器; 取不到时输出为空)。用 HTTP 响应的 Date 头, 不依赖 NTP 端口。
# 必须用动态站点: captive.apple.com 是缓存一年的静态页, 它的 Date 是缓存生成时间 (可能落后好几个小时);
# 有 Age 头时把它加上。用明文 HTTP (时钟错时 HTTPS 会因证书失败, 而这里只需要读时间)
clock_skew() {
  local u h d age srv now
  for u in http://www.apple.com http://www.baidu.com http://www.cloudflare.com; do
    h=$(curl -sI -m 5 "$u" 2>/dev/null | tr -d '\r')
    d=$(echo "$h" | awk -F': ' 'tolower($1)=="date"{print $2; exit}')
    [ -z "$d" ] && continue
    age=$(echo "$h" | awk -F': ' 'tolower($1)=="age"{print $2; exit}'); age=${age//[^0-9]/}
    srv=$(LC_ALL=C date -u -j -f '%a, %d %b %Y %H:%M:%S GMT' "$d" +%s 2>/dev/null) || continue
    now=$(date +%s); echo $((now - srv - ${age:-0})); return 0
  done
}

human_secs() { # 把秒数 (取绝对值) 写成 “N 分钟 / N 小时 / N 天”
  local n=${1#-}
  if [ "$n" -ge 172800 ]; then echo "$((n/86400)) $(L "days" "天")"
  elif [ "$n" -ge 7200 ]; then echo "$((n/3600)) $(L "hours" "小时")"
  else echo "$((n/60)) $(L "minutes" "分钟")"; fi
}

cmd_captive() {
  hdr "$(L "Captive portal check" "强制门户检测")"
  captive_probe
  case "$CAP_STATE" in
    offline) bad "$(L "Could not reach captive.apple.com (no connectivity?)" "无法访问 captive.apple.com (没有网络?)")"; return 1;;
    ok) ok "$(L "No captive portal: direct internet access" "没有强制门户, 可直接上网")";;
    *)  warn "$(L "Captive portal suspected: got a login/redirect page instead of the expected reply" "疑似强制门户: 收到的是登录/跳转页, 而不是预期应答")"
        [ -n "$CAP_REDIR" ] && echo "   → $CAP_REDIR"
        echo "$(L "Open any http:// page (e.g. http://captive.apple.com) in a browser to reach the login page." "用浏览器打开任意 http:// 网址 (如 http://captive.apple.com) 即可进入登录页。")"
        return 1;;
  esac
}

cmd_quick() {
  hdr "$(L "Interface and gateway" "网卡与网关")"
  local ifc gw ip d u code nf=0; ifc=$(default_if); gw=$(gateway)
  if [ -z "$ifc" ]; then bad "$(L "No default route (not connected?)" "没有默认路由 (未联网?)")"; ifconfig | grep -E '^[a-z0-9]+:|inet ' ; return 1; fi
  ok "$(L "Default interface $ifc  gateway ${gw:-none}" "默认网卡 $ifc  网关 ${gw:-无}")"
  ifconfig "$ifc" | awk '/inet |inet6 |ether|status/{print "   "$0}'
  hdr "$(L "Gateway reachability" "网关连通性")"
  if [ -n "$gw" ]; then
    if ping -c 3 -t 5 "$gw" >/dev/null 2>&1; then ok "$(L "Gateway $gw reachable" "网关 $gw 可达")"
    elif ping -c 1 -t 3 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -t 3 223.5.5.5 >/dev/null 2>&1; then
      warn "$(L "Gateway $gw does not answer ping, but the internet is reachable (the router probably blocks ICMP)" "网关 $gw 不回应 ping, 但外网可达 (路由器可能禁了 ICMP)")"
    else bad "$(L "Gateway $gw unreachable (Wi-Fi / cable / router problem)" "网关 $gw 不通 (Wi-Fi/网线/路由器问题)")"; nf=$((nf+1)); fi
  fi
  hdr "$(L "Internet reachability by IP (bypassing DNS)" "外网 IP 连通性 (绕开 DNS)")"
  for ip in 1.1.1.1 8.8.8.8 223.5.5.5; do
    if ping -c 2 -t 4 "$ip" >/dev/null 2>&1; then ok "ping $ip"; else bad "ping $ip"; nf=$((nf+1)); fi
  done
  hdr "DNS"
  scutil --dns | awk '/nameserver\[/{print "   "$0}' | sort -u | head -6
  for d in apple.com baidu.com; do
    if dig +short +time=3 +tries=1 "$d" 2>/dev/null | grep -q .; then ok "$(L "Resolve $d" "解析 $d")"; else bad "$(L "Failed to resolve $d" "解析 $d 失败")"; nf=$((nf+1)); fi
  done
  hdr "HTTP/HTTPS"
  for u in https://www.apple.com https://www.baidu.com https://www.google.com; do
    code=$(curl -s -o /dev/null -m 8 -w '%{http_code} %{time_total}s' "$u" 2>/dev/null)
    case "$code" in 2*|3*) ok "$u  $code";; *) bad "$u  ${code:-$(L "timeout" "超时")}"; nf=$((nf+1));; esac
  done
  hdr "$(L "Public IP" "公网出口 IP")"
  local geo; geo=$(curl -s -m 6 https://api.ip.sb/geoip 2>/dev/null)
  if [ -z "$geo" ]; then warn "$(L "Lookup failed" "获取失败")"
  elif has jq; then echo "$geo" | jq -r '"   \(.ip)  \(.country // "") \(.isp // .organization // "")"' 2>/dev/null || echo "$geo"
  else echo "$geo"; fi
  echo
  echo "$(L "Reading: gateway down → local link; IP works but names fail → DNS; names work but HTTP fails → proxy/firewall/TLS." "判读: 网关不通→本地链路; IP通但域名失败→DNS; 域名通但HTTP失败→代理/防火墙/TLS。")"
  [ "$nf" -eq 0 ]
}

cmd_wifi() {
  local w; w=$(wifi_if); w=${w:-en0}
  hdr "Wi-Fi ($w)"
  networksetup -getairportnetwork "$w" 2>/dev/null
  if has wdutil; then
    echo "$(L "(wdutil needs sudo to show full details)" "(wdutil 需 sudo 才能看到完整信息)")"
    priv wdutil info 2>/dev/null | awk '/SSID|BSSID|RSSI|Noise|Tx Rate|Channel|PHY Mode|Security|Country/' | head -20
  fi
  hdr "$(L "system_profiler summary" "system_profiler 摘要")"
  system_profiler SPAirPortDataType 2>/dev/null | awk '/Current Network Information/{f=1} f&&/PHY Mode|Channel|Security|Signal|Transmit Rate|Country/{print} /Other Local Wi-Fi/{exit}'
  echo "$(L "Rules of thumb: RSSI > -60 good, -70 fair, < -75 poor; SNR (RSSI-Noise) should be > 25 to be stable." "经验值: RSSI > -60 好, -70 一般, < -75 差; SNR(RSSI-Noise) > 25 才稳。")"
  warn "$(L "Nearby Wi-Fi scan: Option-click the Wi-Fi menu bar icon, or use Wireless Diagnostics (Option-click the icon → Open Wireless Diagnostics)" "附近 Wi-Fi 扫描: 按住 Option 点菜单栏 Wi-Fi 图标, 或用 '无线诊断'(Option+Wi-Fi图标→打开无线诊断)")"
}

cmd_dns() {
  local d=${1:-}; [ -z "$d" ] && { echo "$(L "Usage: netdoctor dns <domain>" "用法: netdoctor dns <域名>")"; return 1; }
  case "$d" in *[!A-Za-z0-9._-]*|-*) bad "$(L "Invalid domain: $d" "域名无效: $d")"; return 1;; esac
  hdr "$(L "System resolvers (scutil --dns)" "系统解析器 (scutil --dns)")"; scutil --dns | awk '/resolver #|nameserver\[|domain|search domain|if_index/{print "  "$0}' | head -24
  hdr "$(L "System resolution (dscacheutil, the real system path)" "系统解析 (dscacheutil, 走真实系统路径)")"; dscacheutil -q host -a name "$d"
  hdr "$(L "DNS server comparison" "各 DNS 服务器对比")"
  local n_ans=0 n_nx=0 n_all=0 sys_ans=0 st
  for s in "" 1.1.1.1 8.8.8.8 223.5.5.5 119.29.29.29; do
    label=${s:-$(L "system" "系统默认")}
    out=$(dig ${s:+@$s} +tries=1 +time=3 "$d" A 2>&1)
    ans=$(echo "$out" | awk '/^[^;].*IN[ \t]+A[ \t]/{printf "%s ", $NF}')
    t=$(echo "$out" | awk '/Query time/{print $4" ms"}')
    st=$(echo "$out" | sed -n 's/.*status: \([A-Z]*\).*/\1/p' | head -1)
    n_all=$((n_all+1))
    if [ -n "$ans" ]; then n_ans=$((n_ans+1)); [ -z "$s" ] && sys_ans=1; fi
    [ "$st" = NXDOMAIN ] && n_nx=$((n_nx+1))
    printf '  %-12s %-10s %s\n' "$label" "${t:-$(L "timeout" "超时")}" "${ans:-$([ "$st" = NXDOMAIN ] && L "(NXDOMAIN: no such domain)" "(NXDOMAIN: 域名不存在)" || L "(no answer)" "(无结果)")}"
  done
  if [ "$n_nx" -ge 3 ] && [ "$n_ans" -eq 0 ]; then
    bad "$(L "$d does not exist (NXDOMAIN from most servers); check the spelling" "$d 不存在 (多数服务器返回 NXDOMAIN), 检查拼写")"; return 1
  elif [ "$n_ans" -eq 0 ]; then
    bad "$(L "No server returned an A record for $d (no network, DNS blocked, or the name has no IPv4 address)" "没有服务器返回 $d 的 A 记录 (没网、DNS 被拦截, 或该域名没有 IPv4 地址)")"; return 1
  elif [ "$sys_ans" -eq 0 ]; then
    warn "$(L "The system default DNS failed, but public servers answered: your DNS setting or ISP resolver is the problem (try: netdoctor fixdns)" "系统默认 DNS 解析失败, 但公共服务器正常: 问题在你的 DNS 设置或运营商解析器 (可试: netdoctor fixdns)")"; return 1
  else
    ok "$(L "$d resolves ($n_ans of $n_all servers answered)" "$d 解析正常 ($n_all 个服务器中 $n_ans 个有结果)")"
  fi
  echo "$(L "Tip: big differences between servers, or a failing system default → ISP hijacking or a DNS config problem; try netdoctor fixdns." "提示: 各家结果差异大/系统默认失败 → 运营商劫持或 DNS 配置问题; 可 netdoctor fixdns。")"
}

# 主机名能否被系统解析 (用 ping 的解析结果, 与系统解析器一致; IP 直接视为可解析)
cannot_resolve() {
  case "$1" in *:*) return 1;; esac   # IPv6 字面量: macOS 的 ping 只认 IPv4, 不能用它判断
  case "$1" in *[!0-9.]*) ;; *) return 1;; esac
  # 只有 AAAA (纯 IPv6) 的主机 ping 解析不了, 所以优先问系统解析器 (dscacheutil 同时返回 A / AAAA)
  if has dscacheutil; then [ -z "$(dscacheutil -q host -a name "$1" 2>/dev/null)" ]; return; fi
  ping -c 1 -t 1 "$1" 2>&1 | grep -qi 'cannot resolve\|unknown host'
}

cmd_route() {
  local h=${1:-}; [ -z "$h" ] && { echo "$(L "Usage: netdoctor route <host>" "用法: netdoctor route <主机>")"; return 1; }
  if cannot_resolve "$h"; then bad "$(L "Cannot resolve $h; check the host name or DNS (try: netdoctor dns $h)" "无法解析 $h, 检查域名或 DNS (可试: netdoctor dns $h)")"; return 1; fi
  hdr "$(L "Route selection (which interface/VPN the traffic uses)" "路由选择 (流量走哪块网卡/VPN)")"; route -n get "$h" 2>&1 | awk '/destination|gateway|interface/'
  hdr "$(L "Path" "路径")"
  if has mtr && priv mtr -rwbzc 20 "$h"; then :
  else
    has mtr && warn "$(L "mtr needs admin rights; falling back to traceroute" "mtr 需要管理员权限, 已改用 traceroute")"
    traceroute -w 2 -q 1 -m 20 "$h"
    has mtr || echo "$(L "For per-hop loss statistics without admin rights, run: netdoctor mtr $h" "要无需管理员权限的逐跳丢包统计, 请运行: netdoctor mtr $h")"
  fi
}

# ---------- mtr: 逐跳丢包 / 延迟 (不需要 root) ----------
# traceroute 找出每一跳, 再并行 ping 每一跳 N 次。注意: 中间路由器常对 ICMP 限速, 中间跳丢包而终点不丢是正常的, 判读时要区分。
# 判读 (stdin: "跳数 地址 丢包% 平均ms 最小ms 最大ms", 地址为 - 表示这一跳 traceroute 没有回应; $1 = 目标 IP)。
mtr_verdict() {
  local dest=$1
  awk -v dest="$dest" '
    $2=="-" { next }
    { n++; hop[n]=$1; ip[n]=$2; loss[n]=$3+0; avg[n]=($4=="-" ? -1 : $4+0) }
    END {
      if (n==0) { print "NONE"; exit }
      problem=0
      if (ip[n]!=dest) { print "UNREACHED", hop[n], ip[n]; exit }
      if (loss[n]>=100) { print "DEST_SILENT", hop[n], ip[n]; problem=1 }
      else if (loss[n]>=10) {
        s=n; while (s>1 && loss[s-1]>=10) s--
        print "LOSS_FROM", hop[s], ip[s], loss[n]; problem=1
      } else {
        for (i=1;i<n;i++) if (loss[i]>=30) { print "ICMP_LIMIT", hop[i], ip[i], loss[i]; break }
      }
      prev=-1; best=0; bi=0
      for (i=1;i<=n;i++) { if (avg[i]<0) continue
        if (prev>=0 && avg[i]-prev>best) { best=avg[i]-prev; bi=i }
        prev=avg[i] }
      if (bi>0 && best>=60 && avg[n]>=avg[bi]-10) print "LAT_JUMP", hop[bi], ip[bi], int(best)
      if (!problem) print "HEALTHY", loss[n], (avg[n]<0 ? 0 : int(avg[n]+0.5))
    }'
}
mtr_explain() {   # 把 mtr_verdict 的代码翻成结论; 有真正的问题时返回 1
  local rc=0 code a b c
  while read -r code a b c; do
    case "$code" in
      NONE)       warn "$(L "No hops answered, so no verdict." "没有任何一跳应答, 无法判断。")";;
      UNREACHED)  bad "$(L "The path stops at hop $a ($b) and never reaches the destination: the problem is at or just after that hop." "路径在第 $a 跳 ($b) 就断了, 没有到达目的地: 问题出在这一跳或它之后。")"; rc=1;;
      DEST_SILENT) warn "$(L "The destination was reached by traceroute but does not answer ping (many servers block ICMP), so loss cannot be measured." "traceroute 能到达目的地, 但它不回应 ping (很多服务器屏蔽 ICMP), 无法测丢包。")";;
      LOSS_FROM)
        bad "$(L "Loss starts at hop $a ($b) and continues to the destination ($c% at the end): the problem is at or just after that hop." "从第 $a 跳 ($b) 开始丢包, 一直持续到终点 (终点丢包 $c%): 问题出在这一跳或它之后。")"; rc=1
        if [ "$a" = 1 ]; then echo "$(L "  Hop 1 is your own router: check the Wi-Fi signal / cable, restart the router, or try a wired connection." "  第 1 跳就是你自己的路由器: 检查 Wi-Fi 信号 / 网线, 重启路由器, 或改用有线连接。")"
        elif [ "$a" -le 3 ]; then echo "$(L "  This is close to home (your ISP's access network): note the time and report it to your ISP." "  离家很近 (运营商接入网): 记下时间, 向运营商报障。")"
        else echo "$(L "  This is far from your network; there is usually nothing to fix locally. A VPN or another DNS / route may help." "  距离你的网络较远, 本地通常无法修复; 可尝试 VPN 或换线路。")"; fi;;
      ICMP_LIMIT) ok "$(L "Hop $a ($b) shows $c% loss, but the destination is fine: that router ignores or rate-limits ping replies (harmless)." "第 $a 跳 ($b) 显示丢包 $c%, 但终点正常: 这台路由器只是不回应或限速 ping (无害)。")";;
      LAT_JUMP)   warn "$(L "Latency jumps by about $c ms at hop $a ($b) and stays high afterwards: a long-distance link or congestion there." "第 $a 跳 ($b) 起延迟增加约 $c ms 并一直保持: 这里是远距离链路或拥塞点。")";;
      HEALTHY)    ok "$(L "Path looks healthy: $a% loss and about $b ms to the destination." "路径正常: 终点丢包 $a%, 延迟约 $b ms。")";;
    esac
  done
  return $rc
}

mtr_dest() { # 标准输入: traceroute 输出 → 目的 IP. 多地址主机会先打一行警告, 所以不能只看第 1 行
  sed -n 's/^traceroute to [^ ]* (\([0-9.]*\)).*/\1/p' | head -1; }
cmd_mtr() {
  local h=${1:-} n=${2:-20}
  [ -z "$h" ] && { echo "$(L "Usage: netdoctor mtr <host> [count]" "用法: netdoctor mtr <主机> [次数]")"; return 1; }
  case "$h" in *[!A-Za-z0-9._:-]*|-*) bad "$(L "Invalid host: $h" "主机无效: $h")"; return 1;; esac
  case "$h" in *:*) bad "$(L "mtr supports IPv4 only" "mtr 目前仅支持 IPv4")"; return 1;; esac
  case "$n" in ""|*[!0-9]*) n=0;; esac
  if [ "$n" -lt 3 ] || [ "$n" -gt 100 ]; then bad "$(L "Count must be a number from 3 to 100" "次数必须是 3-100 之间的数字")"; return 1; fi
  if cannot_resolve "$h"; then bad "$(L "Cannot resolve $h; check the host name or DNS (try: netdoctor dns $h)" "无法解析 $h, 检查域名或 DNS (可试: netdoctor dns $h)")"; return 1; fi
  has traceroute || { bad "$(L "traceroute not found" "找不到 traceroute")"; return 1; }
  hdr "$(L "Per-hop loss and latency to $h ($n pings per hop)" "到 $h 的逐跳丢包与延迟 (每跳 ping $n 次)")"
  echo "$(L "Finding the path …" "正在探测路径 …")"
  local out dest dir rows hop ip
  out=$(traceroute -n -w 1 -q 1 -m 30 "$h" 2>&1)
  dest=$(printf '%s\n' "$out" | mtr_dest)
  dir=$(mktemp -d -t netdoctor-mtr) || return 1
  # 每行 "跳数 地址"; 去掉结尾连续的无应答跳 (目的地不通时 traceroute 会一直打 * 到 30 跳)
  printf '%s\n' "$out" | awk '/^ *[0-9]+ /{ip="-"; for(i=2;i<=NF;i++) if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {ip=$i; break}; h[++k]=$1; a[k]=ip}
    END{while(k>0 && a[k]=="-") k--; for(i=1;i<=k;i++) print h[i], a[i]}' >"$dir/hops"
  if [ ! -s "$dir/hops" ]; then bad "$(L "traceroute got no answer from any hop (offline, or ICMP/UDP blocked)" "traceroute 没有收到任何一跳的应答 (断网, 或 ICMP / UDP 被屏蔽)")"; rm -rf "$dir"; return 1; fi
  echo "$(L "Measuring $(wc -l <"$dir/hops" | tr -d ' ') hops in parallel (about $((n/5+2)) s) …" "并行测量 $(wc -l <"$dir/hops" | tr -d ' ') 跳 (约 $((n/5+2)) 秒) …")"
  while read -r hop ip; do
    [ "$ip" = "-" ] && continue
    ping -c "$n" -i 0.2 -W 1000 -t $((n/4+6)) "$ip" >"$dir/p.$hop" 2>&1 &
  done <"$dir/hops"
  wait
  while read -r hop ip; do
    if [ "$ip" = "-" ]; then echo "$hop - 100 - - -"; continue; fi
    awk -v hop="$hop" -v ip="$ip" '
      /packets transmitted/ { l=$(NF-2); sub(/%/,"",l); loss=l }
      /round-trip/ { split($4,a,"/"); mn=a[1]; av=a[2]; mx=a[3] }
      END { if (loss=="") loss=100; printf "%s %s %s %s %s %s\n", hop, ip, loss, (av==""?"-":av), (mn==""?"-":mn), (mx==""?"-":mx) }' "$dir/p.$hop" 2>/dev/null
  done <"$dir/hops" >"$dir/rows"
  printf '  %-4s %-16s %7s %9s %9s %9s\n' "$(L "Hop" "跳")" "$(L "Address" "地址")" "$(L "Loss" "丢包")" "$(L "Avg ms" "平均")" "$(L "Best" "最快")" "$(L "Worst" "最慢")"
  awk '{ if ($2=="-") printf "  %-4s %-16s %7s %9s %9s %9s\n", $1, "(no reply)", "-", "-", "-", "-";
         else printf "  %-4s %-16s %6s%% %9s %9s %9s\n", $1, $2, $3, $4, $5, $6 }' "$dir/rows"
  echo
  hdr "$(L "Verdict" "结论")"
  mtr_verdict "$dest" <"$dir/rows" | mtr_explain; local rc=${PIPESTATUS[1]}
  rm -rf "$dir"
  return $rc
}

# ---------- leak: VPN 下的 DNS / IPv6 泄漏检查 ----------
tunnel_if() { case "$1" in utun*|ppp*|ipsec*|tun*|tap*|wg*) return 0;; esac; return 1; }
route_if_any() { case "$1" in *:*) route -n get -inet6 "$1" 2>/dev/null;; *) route -n get "$1" 2>/dev/null;; esac | awk '/interface:/{print $2; exit}'; }

# 判读。参数: $1=到公网 IPv4 的出口网卡, $2=到公网 IPv6 的出口网卡 (可空), $3=1 表示 IPv6 能上网; stdin 每行 "DNS服务器 出口网卡"。
# 有泄漏返回 1。"VPN 生效"的判据是去公网的 IPv4 流量走隧道网卡 (不看默认路由: 很多 VPN 用 0/1 + 128/1 两条路由覆盖默认路由)。
leak_assess() {
  local v4if=$1 v6if=${2:-} v6ok=${3:-0} ns ifc leaks=0
  if ! tunnel_if "$v4if"; then
    ok "$(L "No full-tunnel VPN in use: internet traffic leaves through $v4if, so nothing can leak around a tunnel." "没有使用全局 VPN: 上网流量走 $v4if, 不存在绕过隧道的泄漏。")"
    return 0
  fi
  ok "$(L "VPN active: IPv4 traffic goes through $v4if" "VPN 已生效: IPv4 流量走 $v4if")"
  while read -r ns ifc; do
    [ -z "$ns" ] && continue
    case "$ns" in 127.*|::1) ok "$(L "DNS server $ns is a resolver on this Mac (its upstream is not checked here)" "DNS 服务器 $ns 是本机上的解析器 (它的上游不在这里检查)")"; continue;; esac
    if tunnel_if "$ifc"; then ok "$(L "DNS server $ns is reached through the tunnel ($ifc)" "DNS 服务器 $ns 经隧道访问 ($ifc)")"
    else bad "$(L "DNS leak: $ns is queried through $ifc, outside the VPN (your provider / router can see the sites you look up)" "DNS 泄漏: $ns 经 $ifc 查询, 绕过了 VPN (运营商 / 路由器能看到你访问了哪些网站)")"; leaks=1; fi
  done
  if [ "$v6ok" = 1 ]; then
    if tunnel_if "$v6if"; then ok "$(L "IPv6 goes through the tunnel ($v6if)" "IPv6 也走隧道 ($v6if)")"
    else bad "$(L "IPv6 leak: IPv6 traffic bypasses the VPN through $v6if, exposing your real IPv6 address" "IPv6 泄漏: IPv6 流量经 $v6if 绕过了 VPN, 会暴露真实 IPv6 地址")"; leaks=1; fi
  else
    ok "$(L "No working IPv6, so IPv6 cannot leak" "IPv6 不通, 不存在 IPv6 泄漏")"
  fi
  if [ "$leaks" = 1 ]; then
    echo "$(L "  Fix: enable the VPN app's \"block DNS leaks\" / \"kill switch\" option, or turn IPv6 off for this network (networksetup -setv6off <service>)." "  办法: 在 VPN 应用里开启“防 DNS 泄漏”/“断网保护 (kill switch)”, 或对该网络服务关闭 IPv6 (networksetup -setv6off <服务名>)。")"
    return 1
  fi
  return 0
}

cmd_leak() {
  local v4if v6if v6ok=0 t ns ifc list="" pub4 pub6 dnsout found=0
  v4if=$(route_if_any 1.1.1.1)
  if [ -z "$v4if" ]; then bad "$(L "No route to the internet (not connected?)" "没有到互联网的路由 (未联网?)")"; return 1; fi
  v6if=$(route_if_any 2001:4860:4860::8888)
  hdr "$(L "VPN / tunnel interfaces" "VPN / 隧道网卡")"
  for t in $(ifconfig -l 2>/dev/null); do
    tunnel_if "$t" || continue
    ifconfig "$t" 2>/dev/null | grep -q 'inet ' || continue
    found=1; echo "  $t  $(ifconfig "$t" 2>/dev/null | awk '/inet /{print $2; exit}')"
  done
  [ "$found" = 0 ] && echo "  $(L "none with an IPv4 address" "没有带 IPv4 地址的隧道网卡")"
  echo "  $(L "Internet traffic (IPv4) leaves through: $v4if" "上网流量 (IPv4) 出口: $v4if")${v6if:+    $(L "IPv6: $v6if" "IPv6: $v6if")}"
  hdr "$(L "DNS servers and the path to them" "DNS 服务器及其访问路径")"
  for ns in $(scutil --dns 2>/dev/null | awk '/nameserver\[[0-9]+\]/{print $3}' | awk '!seen[$0]++'); do
    case "$ns" in *%*) continue;; esac
    ifc=$(route_if_any "$ns"); [ -z "$ifc" ] && ifc="?"
    printf '  %-40s %s %s\n' "$ns" "$(L "via" "经")" "$ifc"
    list="$list$ns $ifc
"
  done
  [ -z "$list" ] && echo "  $(L "no DNS servers found" "没有找到 DNS 服务器")"
  hdr "$(L "What the outside world sees" "外界看到的你")"
  pub4=$(curl -4 -s -m 6 https://api.ip.sb/ip 2>/dev/null); pub6=$(curl -6 -s -m 6 https://api.ip.sb/ip 2>/dev/null)
  dnsout=$(dig +short +time=3 +tries=1 TXT o-o.myaddr.l.google.com 2>/dev/null | tr -d '"' | head -1)
  echo "  $(L "Public IPv4 (web requests)" "公网 IPv4 (网页请求)"): ${pub4:-$(L "failed" "获取失败")}"
  echo "  $(L "Public IPv6 (web requests)" "公网 IPv6 (网页请求)"): ${pub6:-$(L "none / failed" "无 / 获取失败")}"
  echo "  $(L "Your DNS lookups reach the internet from" "你的 DNS 查询对外的出口"): ${dnsout:-$(L "failed" "获取失败")}"
  [ -n "$pub6" ] && v6ok=1
  hdr "$(L "Verdict" "结论")"
  printf '%s' "$list" | leak_assess "$v4if" "$v6if" "$v6ok"
  local rc=$?
  if tunnel_if "$v4if" && [ -n "$dnsout" ] && [ -n "$pub4" ] && [ "$dnsout" != "$pub4" ]; then
    echo "$(L "  Note: DNS lookups exit from $dnsout but web requests from $pub4. That is normal with a public DNS provider; if $dnsout is your ISP's address, DNS is leaking." "  注意: DNS 查询从 $dnsout 出去, 网页请求从 $pub4 出去。用公共 DNS 时这是正常的; 如果 $dnsout 是你运营商的地址, 说明 DNS 在泄漏。")"
  fi
  return $rc
}

# ---------- channels: Wi-Fi 信道拥挤分析 ----------
# system_profiler SPAirPortDataType 的输出 (stdin) -> 每行 "类别 信道 频段(GHz) 带宽(MHz) 信号dBm|-"
# 类别: cur=当前网络, oth=附近其他网络, sup=本机支持的信道。SSID 在没有定位权限时会被隐藏, 所以这里不取名字。
wifi_scan_parse() {
  awk '
    function flush() { if (have) { printf "%s %s %s %s %s\n", kind, ch, band, wd, (sig==""?"-":sig); have=0 } }
    /Supported Channels:/ { line=$0; sub(/.*Supported Channels:[ \t]*/,"",line); n=split(line,a,/, */)
      for (i=1;i<=n;i++) { t=a[i]; gsub(/[()]/," ",t); m=split(t,b," "); if (m>=2 && b[1] ~ /^[0-9]+$/ && b[2] ~ /^[0-9]GHz$/) { g=b[2]; sub(/GHz/,"",g); printf "sup %s %s 20 -\n", b[1], g } }
      next }
    /Current Network Information:/ { flush(); kind="cur"; next }
    /Other Local Wi-Fi Networks:/  { flush(); kind="oth"; next }
    kind=="" { next }
    /^[ \t]*Channel:/ { flush(); t=$0; sub(/.*Channel:[ \t]*/,"",t); gsub(/[(),]/," ",t); m=split(t,f," ")
      if (f[1] ~ /^[0-9]+$/ && f[2] ~ /^[0-9]GHz$/) { ch=f[1]; band=f[2]; sub(/GHz/,"",band); wd=20; if (f[3] ~ /^[0-9]+MHz$/) { wd=f[3]; sub(/MHz/,"",wd) } sig=""; have=1 }
      next }
    /Signal \/ Noise:/ { if (have) { t=$0; sub(/.*Signal \/ Noise:[ \t]*/,"",t); m=split(t,f," "); if (f[1] ~ /^-?[0-9]+$/) sig=f[1] } next }
    END { flush() }'
}

# 拥挤度评估。stdin 是 wifi_scan_parse 的输出。输出机器可读行:
#   NOCUR                          没有当前 Wi-Fi 网络
#   CUR 频段 信道 带宽 分数 个数    与当前网络频谱重叠的邻居 (信号 >= -65 dBm 的算 2 分, 其余 1 分)
#   CAND 信道 分数 DFS             同频段里的候选信道 (DFS=1 表示雷达避让信道)
#   NEI 频段 邻居数                各频段看到的邻居数
#   SUP 频段 数量                  本机支持的信道数
channels_assess() {
  awk '
    function span(c,b,w,   e,base,k) {
      if (b==2) { h=(w<=20?11:w/2); LO=2407+5*c-h; HI=2407+5*c+h; return }   # 2.4 GHz 的 20 MHz 信道实际占约 22 MHz, 所以相邻 4 个信道以内会重叠 (1/6/11 才互不干扰)
      if (b==5) { e=5000+5*c-10; base=(c<=64?5170:(c<=144?5490:5735)) } else { e=5950+5*c-10; base=5945 }
      if (w<=20) { LO=e; HI=e+20 } else { k=int((e-base)/w); LO=base+k*w; HI=LO+w }
    }
    function score(lo,hi,   i,s) { s=0; cn=0
      for (i=1;i<=n;i++) { if (ob[i]!=cb) continue; span(oc[i],ob[i],ow[i]); if (LO<hi && HI>lo) { s+=((os[i]!="-" && os[i]+0>=-65)?2:1); cn++ } }
      return s }
    $1=="sup" { ns++; sc[ns]=$2; sb[ns]=$3; supn[$3]++; next }
    $1=="cur" { have=1; cb=$3; cc=$2; cw=$4; next }
    $1=="oth" { n++; oc[n]=$2; ob[n]=$3; ow[n]=$4; os[n]=$5; nei[$3]++; next }
    END {
      if (!have) { print "NOCUR"; exit }
      span(cc,cb,cw); clo=LO; chi=HI; cs=score(clo,chi); ccn=cn; print "CUR", cb, cc, cw, cs, ccn
      for (b in nei) print "NEI", b, nei[b]
      for (b in supn) print "SUP", b, supn[b]
      for (i=1;i<=ns;i++) { if (sb[i]!=cb) continue; c=sc[i]
        if (cb==2 && c!=1 && c!=6 && c!=11) continue
        if (cb==5 && c==165 && cw>20) continue
        span(c,cb,cw); if (LO==clo) continue
        if (cb==5 && cw>20 && LO!=5000+5*c-10) continue
        if (cb==6 && cw>20 && LO!=5950+5*c-10) continue
        s=score(LO,HI); printf "CAND %s %s %s\n", c, s, (cb==5 && c>=52 && c<=144 ? 1 : 0) }
    }'
}

# 把 channels_assess 的输出翻成结论。stdin 是 channels_assess 的输出。
channels_verdict() {
  local cb="" cc="" cw="" cs=0 cn=0 best="" bs="" bd="" s5=0 s6=0 tmp curline bestline
  tmp=$(cat)
  if printf '%s\n' "$tmp" | grep -q '^NOCUR'; then warn "$(L "This Mac is not connected to a Wi-Fi network, so there is no channel to judge." "这台 Mac 没有连接 Wi-Fi, 无法判断信道。")"; return 1; fi
  curline=$(printf '%s\n' "$tmp" | grep '^CUR')
  set -- $curline; cb=$2; cc=$3; cw=$4; cs=$5; cn=$6
  s5=$(printf '%s\n' "$tmp" | awk '$1=="SUP" && $2==5{print $3}'); s5=${s5:-0}
  s6=$(printf '%s\n' "$tmp" | awk '$1=="SUP" && $2==6{print $3}'); s6=${s6:-0}
  bestline=$(printf '%s\n' "$tmp" | grep '^CAND' | sort -k3,3n -k4,4n -k2,2n | head -1)
  if [ -n "$bestline" ]; then set -- $bestline; best=$2; bs=$3; bd=$4; fi
  hdr "$(L "Neighbouring networks by band" "各频段看到的邻居网络")"
  if printf '%s\n' "$tmp" | grep -q '^NEI'; then printf '%s\n' "$tmp" | awk '$1=="NEI"{printf "  %s GHz: %s\n",$2,$3}' | sort
  else echo "  $(L "none seen (the scan may have been limited)" "没有看到 (扫描可能受限)")"; fi
  hdr "$(L "Your channel" "你所在的信道")"
  echo "  ${cb} GHz, $(L "channel" "信道") ${cc}, ${cw} MHz — $(L "$cn neighbouring network(s) overlap it (weighted score $cs)" "有 $cn 个邻居网络与它的频谱重叠 (加权分 $cs)")"
  hdr "$(L "Verdict" "结论")"
  if [ "$cs" -le 2 ]; then
    ok "$(L "Your channel is quiet; interference from neighbours is not the likely cause of slowness." "你的信道很空闲; 邻居干扰不太可能是网速慢的原因。")"
  elif [ -n "$best" ] && [ "$((bs + 2))" -le "$cs" ]; then
    warn "$(L "Your channel is crowded ($cn overlapping networks, score $cs). Channel $best in the ${cb} GHz band is much quieter (score $bs)." "你的信道比较拥挤 ($cn 个网络重叠, 分数 $cs)。${cb} GHz 频段的信道 $best 空得多 (分数 $bs)。")"
    echo "  $(L "Fix: in the router's Wi-Fi settings set the ${cb} GHz channel to $best." "办法: 在路由器的 Wi-Fi 设置里把 ${cb} GHz 的信道改成 ${best}。")"
    [ "$bd" = 1 ] && echo "  $(L "Note: channel $best is a DFS channel; the router must leave it when it detects radar, which can briefly drop the connection. Pick a non-DFS channel (36–48 or 149–165) if that happens." "注意: 信道 $best 是 DFS 信道, 路由器检测到雷达时必须让出, 会造成短暂断线; 如果出现这种情况请改用非 DFS 信道 (36–48 或 149–165)。")"
  else
    warn "$(L "Your channel is crowded ($cn overlapping networks, score $cs) and no other channel in this band is clearly better." "你的信道比较拥挤 ($cn 个网络重叠, 分数 $cs), 同频段里也没有明显更好的信道。")"
  fi
  if [ "$cb" = 2 ] && [ "$cs" -gt 2 ] && { [ "$s5" -gt 0 ] || [ "$s6" -gt 0 ]; }; then
    echo "  $(L "This Mac supports 5 GHz; if your router offers it, connect to the 5 GHz network: more channels and far less crowded (shorter range through walls)." "这台 Mac 支持 5 GHz; 如果路由器有 5 GHz 网络, 建议连它: 信道多、干扰少 (穿墙距离更短)。")"
  fi
  if [ "$cb" = 2 ] && [ "$cw" -ge 40 ] && [ "$cn" -ge 3 ]; then
    echo "  $(L "You are using a 40 MHz channel on the crowded 2.4 GHz band; setting the router to 20 MHz is usually more stable." "你在拥挤的 2.4 GHz 上用了 40 MHz 带宽; 在路由器里改成 20 MHz 通常更稳。")"
  fi
  echo "  $(L "Only networks this Mac can hear are counted, and few report signal strength, so the score is a rough guide." "只统计这台 Mac 能听到的网络, 且多数没有信号强度, 所以分数只是粗略参考。")"
  return 0
}

cmd_channels() {
  has system_profiler || { bad "$(L "system_profiler not found" "未找到 system_profiler")"; return 1; }
  hdr "$(L "Wi-Fi channel analysis" "Wi-Fi 信道分析")"
  echo "$(L "Scanning nearby networks (about 15 s) …" "正在扫描附近的网络 (约 15 秒) …")"
  system_profiler SPAirPortDataType 2>/dev/null | wifi_scan_parse | channels_assess | channels_verdict
}

# ---------- exposure: 本机监听端口的暴露面检查 ----------
# 看哪些端口对局域网 / 所有网卡开放, 哪些只对本机 (127.0.0.1 / ::1) 开放, 并标出不该暴露的服务。
# netstat 不需要 root 就能看到全部监听端口 (lsof 只能看到自己的进程), 所以端口取自 netstat, 进程名尽量用 lsof 补。

# stdin: netstat -an -p tcp 的输出 -> 每行 "端口 范围"; 范围: all (所有网卡) / lan (某个具体地址) / local (仅本机)。同一端口取最宽的范围。
exposure_parse() {
  awk '
    $NF=="LISTEN" && $1 ~ /^tcp/ {
      a=$4; i=length(a); while (i>0 && substr(a,i,1)!=".") i--
      if (i<2) next
      port=substr(a,i+1); addr=substr(a,1,i-1)
      if (port !~ /^[0-9]+$/) next
      if (addr=="*" || addr=="0.0.0.0" || addr=="::") sc=3
      else if (addr ~ /^127\./ || addr=="::1") sc=1
      else sc=2
      if (sc>best[port]) best[port]=sc
    }
    END { for (p in best) printf "%s %s\n", p, (best[p]==3?"all":(best[p]==2?"lan":"local")) }' | sort -n
}

# stdin: lsof -nP -iTCP -sTCP:LISTEN 的输出 -> 每行 "端口 进程名" (只能看到有权限看的进程)
exposure_procs() {
  awk 'NR>1 && /LISTEN/ { n=$(NF-1); sub(/.*:/,"",n); c=$1; gsub(/\\x20/," ",c); if (n ~ /^[0-9]+$/ && !(n in seen)) { seen[n]=1; print n, c } }'
}

# 防火墙状态: on / off / unknown
fw_state() {
  local f=/usr/libexec/ApplicationFirewall/socketfilterfw o
  [ -x "$f" ] || { echo unknown; return; }
  o=$("$f" --getglobalstate 2>/dev/null)
  case "$o" in *"enabled"*|*"State = 1"*|*"State = 2"*) echo on;; *"disabled"*|*"State = 0"*) echo off;; *) echo unknown;; esac
}

# 评估。stdin 每行 "端口 范围 进程名" (进程名可为 ?), 参数 fw=on|off|unknown。有危险暴露返回 1。
exposure_assess() {
  local fw=unknown a port scope proc nbad=0 nwarn=0 nlocal=0 nexp=0 ndyn=0 dynprocs="" lvl msg
  for a in "$@"; do case "$a" in fw=*) fw=${a#fw=};; esac; done
  while read -r port scope proc; do
    [ -z "$port" ] && continue
    proc=${proc:-?}
    if [ "$scope" = local ]; then nlocal=$((nlocal+1)); continue; fi
    if [ "$port" -ge 49152 ]; then ndyn=$((ndyn+1)); [ "$proc" != "?" ] && case " $dynprocs " in *" $proc "*) ;; *) dynprocs="$dynprocs $proc";; esac; continue; fi
    nexp=$((nexp+1)); lvl=""; msg=""
    case "$port" in
      2375|2376) lvl=bad; msg="$(L "the Docker API is open to the network: anyone who can reach it can take over this Mac. Bind it to 127.0.0.1 or use TLS." "Docker API 对网络开放: 任何能连上的人都能控制这台 Mac。改成只监听 127.0.0.1, 或启用 TLS。")";;
      6379)      lvl=bad; msg="$(L "Redis is open to the network (no password by default). Bind it to 127.0.0.1." "Redis 对网络开放 (默认没有密码)。改成只监听 127.0.0.1。")";;
      27017)     lvl=bad; msg="$(L "MongoDB is open to the network. Bind it to 127.0.0.1 or turn on authentication." "MongoDB 对网络开放。改成只监听 127.0.0.1, 或启用认证。")";;
      9200|9300) lvl=bad; msg="$(L "Elasticsearch is open to the network. Bind it to 127.0.0.1." "Elasticsearch 对网络开放。改成只监听 127.0.0.1。")";;
      11211)     lvl=bad; msg="$(L "memcached is open to the network (no authentication). Bind it to 127.0.0.1." "memcached 对网络开放 (没有认证)。改成只监听 127.0.0.1。")";;
      23)        lvl=bad; msg="$(L "telnet sends passwords in clear text. Turn it off." "telnet 明文传输密码。请关闭。")";;
      21)        lvl=warn; msg="$(L "FTP sends passwords in clear text. Turn it off or use SFTP." "FTP 明文传输密码。请关闭, 或改用 SFTP。")";;
      22)        lvl=warn; msg="$(L "Remote Login (SSH) is on: anyone on the network can try to log in. Turn it off in System Settings → General → Sharing if you do not need it." "远程登录 (SSH) 已开启: 网络上的人都可以尝试登录。不需要的话在 系统设置 → 通用 → 共享 里关闭。")";;
      445|139)    lvl=warn; msg="$(L "File Sharing (SMB) is on. Turn it off in System Settings → General → Sharing if you do not need it." "文件共享 (SMB) 已开启。不需要的话在 系统设置 → 通用 → 共享 里关闭。")";;
      5900)      lvl=warn; msg="$(L "Screen Sharing / VNC is on. Turn it off in System Settings → General → Sharing if you do not need it." "屏幕共享 / VNC 已开启。不需要的话在 系统设置 → 通用 → 共享 里关闭。")";;
      3283)      lvl=warn; msg="$(L "Remote Management (Apple Remote Desktop) is on." "远程管理 (Apple Remote Desktop) 已开启。")";;
      3389)      lvl=warn; msg="$(L "RDP is open to the network." "RDP 对网络开放。")";;
      3306|5432|1433) lvl=warn; msg="$(L "a database is open to the network. Bind it to 127.0.0.1 unless other machines need it." "数据库对网络开放。除非别的机器要用, 否则改成只监听 127.0.0.1。")";;
      *) case "$proc" in node|python*|Python|ruby|java|php*|deno|bun|vite|next-server*|go|air|uvicorn|gunicorn|flask) lvl=warn; msg="$(L "a development server is reachable by everyone on the network. Bind it to 127.0.0.1 unless you want that." "开发服务器对网络上所有人开放。除非有意, 否则改成只监听 127.0.0.1。")";; esac;;
    esac
    if [ -n "$lvl" ]; then
      if [ "$lvl" = bad ]; then bad "$port/tcp $proc — $msg"; nbad=$((nbad+1)); else warn "$port/tcp $proc — $msg"; nwarn=$((nwarn+1)); fi
    else
      echo "  $port/tcp  $proc  ($(L "reachable from the network" "网络可达")$([ "$scope" = lan ] && printf ', %s' "$(L "one address only" "仅某个地址")"))"
    fi
  done
  [ "$nexp" = 0 ] && echo "  $(L "no ports below 49152 are open to the network" "没有低于 49152 的端口对网络开放")"
  [ "$ndyn" -gt 0 ] && echo "  $(L "$ndyn high ports (49152+) are open to the network, usually macOS services such as AirPlay / Handoff / Control Center" "$ndyn 个高位端口 (49152+) 对网络开放, 通常是 AirPlay / 接力 / 控制中心之类的 macOS 系统服务")${dynprocs:+: $(echo $dynprocs | tr ' ' ',' | sed 's/,/, /g')}"
  echo "  $(L "$nlocal ports listen on this Mac only (127.0.0.1 / ::1): not reachable from the network" "$nlocal 个端口只对本机开放 (127.0.0.1 / ::1): 网络上访问不到")"
  hdr "$(L "Verdict" "结论")"
  case "$fw" in
    on)  ok "$(L "The macOS application firewall is on." "macOS 应用防火墙已开启。")";;
    off) if [ "$nexp" -gt 0 ]; then warn "$(L "The macOS application firewall is OFF while $nexp port(s) are open to the network. Turn it on in System Settings → Network → Firewall." "macOS 应用防火墙是关闭的, 却有 $nexp 个端口对网络开放。请在 系统设置 → 网络 → 防火墙 里打开。")"; nwarn=$((nwarn+1))
         else warn "$(L "The macOS application firewall is off (nothing sensitive is listening right now). Consider turning it on: System Settings → Network → Firewall." "macOS 应用防火墙是关闭的 (目前没有敏感端口在监听)。建议打开: 系统设置 → 网络 → 防火墙。")"; fi;;
    *)   echo "  $(L "(could not read the firewall state)" "(读不到防火墙状态)")";;
  esac
  if [ "$nbad" -gt 0 ]; then bad "$(L "$nbad dangerous service(s) are exposed to the network." "有 $nbad 个危险服务暴露在网络上。")"; return 1; fi
  if [ "$nwarn" -gt 0 ]; then warn "$(L "$nwarn service(s) are exposed that you may not want exposed; see above." "有 $nwarn 个服务暴露在网络上, 请确认是不是你要的; 见上面。")"
  else ok "$(L "Nothing sensitive is exposed to the network." "没有敏感服务暴露在网络上。")"; fi
  return 0
}

cmd_exposure() {
  local ns procs fw list
  has netstat || { bad "$(L "netstat not found" "未找到 netstat")"; return 1; }
  hdr "$(L "Ports open to the network (this Mac)" "本机对网络开放的端口")"
  ns=$(netstat -an -p tcp 2>/dev/null | exposure_parse)
  procs=""; has lsof && procs=$(lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | exposure_procs)
  fw=$(fw_state)
  list=$(printf '%s\n' "$ns" | while read -r p sc; do [ -z "$p" ] && continue; n=$(printf '%s\n' "$procs" | awk -v p="$p" '$1==p{ $1=""; sub(/^ /,""); print; exit }'); printf '%s %s %s\n' "$p" "$sc" "${n:-?}"; done)
  printf '%s\n' "$list" | exposure_assess fw="$fw"
  local rc=$?
  echo "  $(L "(Only TCP is checked. Without administrator rights process names are only known for your own processes; '?' means unknown.)" "(只检查 TCP。没有管理员权限时只能知道自己的进程名, ? 表示未知。)")"
  return $rc
}

# ---------- bonjour: 局域网服务发现 ----------
bonjour_label() {
  case "$1" in
    _airplay._tcp) echo "AirPlay";; _raop._tcp) echo "AirPlay $(L "audio" "音频")";; _googlecast._tcp) echo "Chromecast / Google Cast";;
    _ipp._tcp|_ipps._tcp|_printer._tcp|_pdl-datastream._tcp) echo "$(L "Printer" "打印机") (${1%%.*})";;
    _scanner._tcp|_uscan._tcp|_uscans._tcp) echo "$(L "Scanner" "扫描仪")";;
    _ssh._tcp) echo "SSH";; _sftp-ssh._tcp) echo "SFTP";; _smb._tcp) echo "$(L "File sharing (SMB)" "文件共享 (SMB)")";; _afpovertcp._tcp) echo "$(L "File sharing (AFP)" "文件共享 (AFP)")";;
    _http._tcp|_https._tcp) echo "$(L "Web server" "网页服务") (${1%%.*})";;
    _hap._tcp|_homekit._tcp) echo "HomeKit";; _companion-link._tcp) echo "$(L "Apple device (Companion Link)" "Apple 设备 (Companion Link)")";;
    _device-info._tcp) echo "$(L "Device info" "设备信息")";; _airport._tcp) echo "AirPort / $(L "Wi-Fi base station" "无线基站")";;
    _workstation._tcp) echo "$(L "Workstation" "工作站")";; _spotify-connect._tcp) echo "Spotify Connect";; _remotepairing._tcp) echo "$(L "Apple remote pairing" "Apple 远程配对")";;
    _rfb._tcp) echo "$(L "Screen sharing (VNC)" "屏幕共享 (VNC)")";; _sleep-proxy._udp) echo "$(L "Sleep proxy" "休眠代理")";;
    *) echo "$1";;
  esac
}
# dns-sd -B 的输出 -> "服务类型|实例名" (去重)。$6 = 服务类型, 其后是实例名。
bonjour_parse() {
  awk '$2=="Add" && NF>=7 { t=$6; sub(/\.$/,"",t); n=$7; for(i=8;i<=NF;i++) n=n" "$i; print t "|" n }' "$@" | sort -u
}
# 枚举元服务得到的服务类型 (行里 $6 是 "_tcp.local.", $7 是 "_ssh") -> "_ssh._tcp"
bonjour_types() {
  awk '$2=="Add" && $6 ~ /^_(tcp|udp)\.local\.$/ { p=$6; sub(/\..*/,"",p); print $7 "." p }' "$@" | sort -u
}

cmd_bonjour() {
  local secs=${1:-5}
  case "$secs" in ""|*[!0-9]*) secs=0;; esac
  if [ "$secs" -lt 2 ] || [ "$secs" -gt 30 ]; then bad "$(L "Seconds must be a number from 2 to 30" "秒数必须是 2-30 之间的数字")"; return 1; fi
  has dns-sd || { bad "$(L "dns-sd not found" "找不到 dns-sd")"; return 1; }
  hdr "$(L "Bonjour / mDNS services on the local network" "局域网 Bonjour / mDNS 服务")"
  local dir pids="" t types
  dir=$(mktemp -d -t netdoctor-bonjour) || return 1
  echo "$(L "Listing service types …" "正在枚举服务类型 …")"
  dns-sd -B _services._dns-sd._udp local >"$dir/meta" 2>&1 & pids=$!
  sleep 2; kill $pids 2>/dev/null; wait $pids 2>/dev/null
  # 枚举到的类型 + 常见类型 (有的设备不出现在枚举里)
  types=$( { bonjour_types "$dir/meta"; printf '%s\n' _airplay._tcp _raop._tcp _ipp._tcp _printer._tcp _ssh._tcp _smb._tcp _afpovertcp._tcp _http._tcp _googlecast._tcp _hap._tcp _companion-link._tcp _sftp-ssh._tcp _airport._tcp _workstation._tcp _spotify-connect._tcp; } | sort -u)
  echo "$(L "Browsing $(printf '%s\n' "$types" | wc -l | tr -d ' ') service types for $secs s …" "浏览 $(printf '%s\n' "$types" | wc -l | tr -d ' ') 种服务类型, 持续 $secs 秒 …")"
  pids=""; local i=0
  for t in $types; do
    i=$((i+1)); dns-sd -B "$t" local >"$dir/b.$i" 2>&1 & pids="$pids $!"
  done
  sleep "$secs"
  kill $pids 2>/dev/null; wait $pids 2>/dev/null
  local found; found=$(bonjour_parse "$dir"/b.* 2>/dev/null)
  rm -rf "$dir"
  if [ -z "$found" ]; then
    warn "$(L "No services found. Nothing on the network advertises any, or this program lacks the Local Network permission (System Settings → Privacy & Security → Local Network); try it in Terminal." "没有发现任何服务。要么网络上没有设备对外广播, 要么这个程序没有“本地网络”权限 (系统设置 → 隐私与安全性 → 本地网络); 可以在终端里再试。")"
    return 0
  fi
  local cur="" ty nm lb total=0 kinds=0
  while IFS='|' read -r ty nm; do
    if [ "$ty" != "$cur" ]; then cur=$ty; kinds=$((kinds+1)); echo; lb=$(bonjour_label "$ty"); if [ "$lb" = "$ty" ]; then echo "  $ty"; else echo "  $lb  [$ty]"; fi; fi
    echo "      - $nm"; total=$((total+1))
  done <<EOF2
$found
EOF2
  echo
  ok "$(L "$total services of $kinds types" "共 $total 个服务, $kinds 种类型")"
  echo "$(L "Only devices that advertise themselves with Bonjour show up; use netdoctor lan for everything that answers ping." "只有用 Bonjour 广播自己的设备才会出现; 想看所有能应答 ping 的设备请用 netdoctor lan。")"
}

cmd_ping() { local h=${1:-}; [ -z "$h" ] && { echo "$(L "Usage: netdoctor ping <host> [count]" "用法: netdoctor ping <主机> [次数]")"; return 1; }; ping -c "${2:-20}" "$h"; }

cmd_port() {
  [ $# -lt 2 ] && { echo "$(L "Usage: netdoctor port <host> <port>" "用法: netdoctor port <主机> <端口>")"; return 1; }
  case "$2" in ''|*[!0-9]*) bad "$(L "Port must be a number between 1 and 65535" "端口必须是 1-65535 的数字")"; return 1;; esac
  if [ "$2" -lt 1 ] || [ "$2" -gt 65535 ]; then bad "$(L "Port must be a number between 1 and 65535" "端口必须是 1-65535 的数字")"; return 1; fi
  if nc -vz -G 5 "$1" "$2" 2>&1; then ok "$(L "$1:$2 open" "$1:$2 开放")"
  else bad "$(L "$1:$2 unreachable (closed / firewall / routing)" "$1:$2 不通 (关闭/防火墙/路由)")"; return 1; fi
}

cmd_http() {
  local u=${1:-}; [ -z "$u" ] && { echo "$(L "Usage: netdoctor http <URL>" "用法: netdoctor http <URL>")"; return 1; }
  local fmt
  if [ "$ZH" = 1 ]; then fmt='
  HTTP 状态      %{http_code}  (重定向 %{num_redirects} 次)
  远端 IP        %{remote_ip}:%{remote_port}
  DNS 解析       %{time_namelookup}s
  TCP 连接       %{time_connect}s
  TLS 握手完成   %{time_appconnect}s
  首字节(TTFB)   %{time_starttransfer}s
  总耗时         %{time_total}s
  下载速度       %{speed_download} B/s
'
  else fmt='
  HTTP status     %{http_code}  (%{num_redirects} redirects)
  Remote IP       %{remote_ip}:%{remote_port}
  DNS lookup      %{time_namelookup}s
  TCP connect     %{time_connect}s
  TLS handshake   %{time_appconnect}s
  First byte      %{time_starttransfer}s
  Total           %{time_total}s
  Download speed  %{speed_download} B/s
'
  fi
  local res
  if ! res=$(curl -sS -o /dev/null -L -m 30 -w "$fmt
@@%{http_code}" "$u"); then
    printf '%s\n' "${res%@@*}"
    bad "$(L "Request failed; investigate with: curl -v $u" "请求失败, 加 -v 排查: curl -v $u")"; return 1
  fi
  printf '%s\n' "${res%@@*}"
  local code=${res##*@@}
  case "$code" in
    2*) ok "$(L "HTTP $code: the server answered normally" "HTTP $code: 服务器响应正常")";;
    3*) warn "$(L "HTTP $code: still a redirect after following the limit; check the Location header" "HTTP $code: 跟随重定向后仍是跳转, 检查 Location 头")"; return 1;;
    4*) bad "$(L "HTTP $code: the network works but the server rejected the request (check the URL, login or permissions)" "HTTP $code: 网络是通的, 但服务器拒绝了请求 (检查网址、登录或权限)")"; return 1;;
    5*) bad "$(L "HTTP $code: the network works but the server has a problem (try again later or contact the site)" "HTTP $code: 网络是通的, 但服务器自身出错 (稍后重试或联系站点)")"; return 1;;
    *) warn "$(L "Unexpected HTTP status: $code" "异常的 HTTP 状态码: $code")"; return 1;;
  esac
}

# 主机名是否匹配证书里的名字 (精确匹配, 或 *.example.com 恰好匹配一级子域名)
host_matches() {
  local h n; h=$(echo "$1" | tr 'A-Z' 'a-z'); shift
  for n in "$@"; do
    n=$(echo "$n" | tr 'A-Z' 'a-z')
    case "$n" in
      \*.*) [ "$h" != "${h#*.}" ] && [ "${h#*.}" = "${n#*.}" ] && return 0;;
      *) [ "$h" = "$n" ] && return 0;;
    esac
  done
  return 1
}

cmd_tls() {
  local h=${1:-}; local p=${2:-443}; [ -z "$h" ] && { echo "$(L "Usage: netdoctor tls <host> [port]" "用法: netdoctor tls <主机> [端口]")"; return 1; }
  # s_client 默认不校验主机名 (证书是别的域名的也会显示 Verification: OK)。OpenSSL 支持 -verify_hostname;
  # 系统自带的 LibreSSL 不支持, 那种情况下下面自己比对 SAN。
  local vh="" native=0 isip=0 target="$h:$p" sni="-servername $h"
  case "$h" in
    # IPv6 字面量: 不该发 SNI; OpenSSL 的 -connect 要方括号, 系统自带的 LibreSSL 不认方括号 (直接写 ::1:443)
    *:*) isip=1; sni=""; openssl s_client -help 2>&1 | grep -q -- -verify_hostname && target="[$h]:$p";;
    *[!0-9.]*) ;;
    *) isip=1;;
  esac
  if [ "$isip" = 0 ] && openssl s_client -help 2>&1 | grep -q -- -verify_hostname; then vh="-verify_hostname $h"; native=1; fi
  local out; out=$(echo | openssl s_client -connect "$target" $sni $vh 2>&1)
  echo "$out" | grep -E 'Protocol|Cipher|Verif|verify|depth=|errno|error' | head -12
  local cert; cert=$(echo "$out" | openssl x509 2>/dev/null)
  if [ -z "$cert" ]; then bad "$(L "No certificate received ($h:$p unreachable or not a TLS service)" "未取得证书 ($h:$p 不可达或非 TLS 服务)")"; return 1; fi
  local rc=0
  echo "$out" | grep -qE 'Verification error|Verify return code: [1-9]' && rc=1
  echo "$cert" | openssl x509 -noout -subject -issuer -dates
  local san; san=$(echo "$cert" | openssl x509 -noout -text | grep -A1 'Subject Alternative Name' | sed 's/^ */SAN: /;/Subject Alternative/d')
  echo "$san"
  if [ "$native" = 0 ] && [ "$isip" = 0 ]; then
    case "$h" in *)
      local names; names=$(echo "$san" | tr ',' '\n' | sed -n 's/^[ ]*\(SAN: \)\{0,1\}DNS://p')
      [ -z "$names" ] && names=$(echo "$cert" | openssl x509 -noout -subject | sed -n 's/.*CN *= *\([^,/]*\).*/\1/p')
      # shellcheck disable=SC2086
      if ! host_matches "$h" $names; then
        bad "$(L "Hostname mismatch: the certificate is not valid for $h" "主机名不匹配: 该证书不适用于 $h")"; rc=1
      fi;;
    esac
  fi
  if has testssl; then echo "$(L "Full audit: testssl $h:$p" "完整体检: testssl $h:$p")"; fi
  return $rc
}

cmd_mtu() {
  local h=${1:-1.1.1.1} s
  case "$h" in *:*) bad "$(L "MTU probing supports IPv4 only (the system ping cannot send IPv6 with the DF bit)" "MTU 探测只支持 IPv4 (系统 ping 无法发送带 DF 位的 IPv6 包)")"; return 1;; esac
  if cannot_resolve "$h"; then bad "$(L "Cannot resolve $h; check the host name or DNS (try: netdoctor dns $h)" "无法解析 $h, 检查域名或 DNS (可试: netdoctor dns $h)")"; return 1; fi
  hdr "$(L "Path MTU probe -> $h (DF bit)" "路径 MTU 探测 -> $h (DF 位)")"
  for s in 1472 1452 1432 1412 1372 1272 1172; do
    if ping -c 1 -t 3 -D -s "$s" "$h" >/dev/null 2>&1; then
      ok "$(L "Payload $s passed → MTU ≈ $((s+28))" "载荷 $s 通过 → MTU ≈ $((s+28))")"; return; fi
    printf "  $(L "Payload %s lost" "载荷 %s 丢失")\n" "$s"
  done
  bad "$(L "All failed; the target may block ICMP" "均失败; 目标可能禁 ICMP")"; return 1
}

cmd_speed() {
  if ! has networkQuality; then
    bad "$(L "Requires macOS 12+ (networkQuality)" "需要 macOS 12+ (networkQuality)")"
    if has speedtest-cli; then speedtest-cli; else return 1; fi
    return
  fi
  # 边跑边显示 (网页 / App 里测试要 20-30 秒, 不能到最后才一次性出现), 同时留一份用来解析结论
  local tmp rc out; tmp=$(mktemp)
  networkQuality -v 2>&1 | tee "$tmp"; rc=${PIPESTATUS[0]}
  out=$(cat "$tmp"); rm -f "$tmp"
  [ "$rc" -eq 0 ] || {
    bad "$(L "networkQuality failed (often a temporary problem reaching Apple's test server; try again, or check the clock / proxy with: netdoctor doctor)" "networkQuality 执行失败 (多半是暂时连不上 Apple 的测速服务器; 请重试, 或用 netdoctor doctor 检查时钟 / 代理)")"; return 1; }
  speed_verdict "$out"
}

# 解析 networkQuality 的摘要, 给出结论: 带宽够不够、上传 / 下载时延是否因缓冲膨胀 (bufferbloat) 而飙升。
# 响应性单位是 RPM (每分钟往返次数): >= 1000 很好, 300-999 一般, < 300 差 (视频会议、游戏会卡)。
speed_verdict() {
  local t=$1 dl ul dr ur
  dl=$(printf '%s\n' "$t" | sed -n 's/^Downlink capacity: *\([0-9.]*\) Mbps.*/\1/p' | head -1)
  ul=$(printf '%s\n' "$t" | sed -n 's/^Uplink capacity: *\([0-9.]*\) Mbps.*/\1/p' | head -1)
  dr=$(printf '%s\n' "$t" | sed -n 's/^Downlink [Rr]esponsiveness:.*|  *\([0-9]*\) RPM.*/\1/p' | head -1)
  ur=$(printf '%s\n' "$t" | sed -n 's/^Uplink [Rr]esponsiveness:.*|  *\([0-9]*\) RPM.*/\1/p' | head -1)
  # 有的 macOS / 网络下只给一行总的 "Responsiveness: Medium (68 milliseconds | 879 RPM)", 不分上下行
  local fig single=""
  if [ -z "$dr$ur" ]; then
    dr=$(printf '%s\n' "$t" | sed -n 's/^Responsiveness:.*|  *\([0-9]*\) RPM.*/\1/p' | head -1)
    [ -n "$dr" ] && { ur=$dr; single=1; }
  fi
  if [ -n "$single" ]; then fig="$dr RPM"; else fig="$(L "down $dr RPM, up $ur RPM" "下载 $dr RPM, 上传 $ur RPM")"; fi
  echo
  if [ -z "$dr$ur" ]; then
    warn "$(L "Could not read the responsiveness figures, so no bufferbloat verdict (the output format may differ on this macOS)." "读不到响应性数据, 无法判断缓冲膨胀 (这个 macOS 版本的输出格式可能不同)。")"; return 0
  fi
  local worst=$dr; [ -z "$worst" ] && worst=$ur; [ -n "$ur" ] && [ "$ur" -lt "$worst" ] && worst=$ur
  if [ "$worst" -ge 1000 ]; then
    ok "$(L "Responsiveness is good ($fig): the line stays snappy under load." "响应性良好 ($fig): 满载时网络依然流畅。")"
  elif [ "$worst" -ge 300 ]; then
    warn "$(L "Responsiveness is fair ($fig): latency rises noticeably when the line is busy." "响应性一般 ($fig): 线路繁忙时延迟会明显上升。")"
  else
    local dir; dir="$(L "upload" "上传")"; [ -n "$dr" ] && [ "$dr" -lt 300 ] && dir="$(L "download" "下载")"
    [ -n "$dr" ] && [ -n "$ur" ] && [ "$dr" -lt 300 ] && [ "$ur" -lt 300 ] && dir="$(L "upload and download" "上传和下载")"
    [ -n "$single" ] && dir="$(L "network" "网络")"
    bad "$(L "Bufferbloat: latency under $dir load is very high ($fig). Video calls and games will lag while someone is uploading or downloading." "存在缓冲膨胀: $dir 满载时延迟很高 ($fig)。有人上传或下载时, 视频会议和游戏会卡。")"
    echo "$(L "  Fix: enable SQM / smart queue (fq_codel, CAKE) on the router, or cap its speed at about 90% of the figures above." "  办法: 在路由器上启用 SQM / 智能队列 (fq_codel、CAKE), 或把路由器限速设为上面带宽的约 90%。")"
  fi
  if [ -n "$ul" ] && [ -n "$dl" ]; then
    awk -v u="$ul" -v d="$dl" 'BEGIN{ if (u < 5) exit 0; exit 1 }' && warn "$(L "Upload bandwidth is only $ul Mbps: video calls and cloud uploads will be slow." "上传带宽只有 $ul Mbps: 视频会议和云端上传会比较慢。")"
  fi
  return 0
}

cmd_conns() {
  # 没有管理员权限 (无终端且 sudo 无缓存) 时降级为普通权限的 lsof: 只能看到当前用户自己的进程
  local P=priv
  if ! can_priv; then
    P=""; warn "$(L "No administrator rights: only your own processes are listed (run sudo netdoctor conns for all)" "没有管理员权限: 只列出当前用户自己的进程 (用 sudo netdoctor conns 查看全部)")"
  fi
  hdr "$(L "Listening ports" "监听端口")"; $P lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | head -40
  hdr "$(L "Established connections" "已建立连接")"; $P lsof -nP -iTCP -sTCP:ESTABLISHED 2>/dev/null | head -40
  if has nettop; then echo "$(L "Live per-process traffic: nettop -P -d    |   bandwhich (needs sudo)" "实时按进程流量: nettop -P -d    |   bandwhich (需 sudo)")"; fi
}

cmd_proxy() {
  hdr "$(L "System proxy (scutil --proxy)" "系统代理 (scutil --proxy)")"; scutil --proxy
  hdr "$(L "Environment-variable proxy" "环境变量代理")"; env | grep -i -E '^(https?|all|no)_proxy=' || echo "$(L "  (none)" "  (无)")"
  hdr "$(L "VPN / tunnel interfaces" "VPN/隧道网卡")"; ifconfig | awk '/^(utun|ppp|ipsec|tun|tap)[0-9]*:/{print $1}'
  hdr "$(L "Configured VPN services" "已配置的 VPN 服务")"; scutil --nc list 2>/dev/null
  hdr "$(L "Per-service proxy (networksetup)" "各网络服务代理 (networksetup)")"
  networksetup -listallnetworkservices 2>/dev/null | tail -n +2 | grep -v '^\*' | while read -r s; do
    echo "- $s: $(networksetup -getwebproxy "$s" | tr '\n' ' ')"
  done
}

cmd_capture() {
  local f=${1:-}; local out="$HOME/Desktop/cap-$(date +%Y%m%d-%H%M%S).pcap"
  can_priv || { need_admin capture; return 1; }
  echo "$(L "Capturing → $out  (Ctrl-C to stop; open with Wireshark)" "抓包 → $out  (Ctrl-C 结束; 用 Wireshark 打开)")"
  echo "$(L "Filter examples: 'host 1.2.3.4'  'port 53'  'tcp port 443 and host x.com'" "过滤器示例: 'host 1.2.3.4'  'port 53'  'tcp port 443 and host x.com'")"
  if [ -n "$f" ]; then priv tcpdump -i "$(default_if)" -nn -s0 -w "$out" "$f"; else priv tcpdump -i "$(default_if)" -nn -s0 -w "$out"; fi
}

cmd_fixdns() {
  can_priv || { need_admin fixdns; return 1; }
  if priv dscacheutil -flushcache && priv killall -HUP mDNSResponder; then ok "$(L "DNS cache flushed" "DNS 缓存已刷新")"
  else bad "$(L "Flushing the DNS cache failed (wrong password or no admin rights)" "刷新 DNS 缓存失败 (密码错误或没有管理员权限)")"; return 1; fi
}

cmd_tools() {
  hdr "$(L "Built-in" "系统自带")"
  for t in ping traceroute netstat lsof nc curl dig scutil networksetup route tcpdump nettop networkQuality wdutil ifconfig arp dscacheutil system_profiler; do
    has "$t" && ok "$t" || warn "$(L "$t missing" "$t 缺失")"; done
  # 可选的第三方工具: NetDoctor 的所有功能都不依赖它们, 没装不是问题。格式: 命令:brew 包名:用途
  hdr "$(L "Optional third-party tools (NetDoctor works without them)" "可选的第三方工具 (不装也不影响 NetDoctor)")"
  local spec cmd pkg desc have=0 total=0
  for spec in \
    "iperf3:iperf3:$(L "two-ended bandwidth test between two machines" "两台机器之间的带宽测试")" \
    "fping:fping:$(L "ping many hosts at once" "同时 ping 多个主机")" \
    "nmap:nmap:$(L "port scan / service probing" "端口扫描 / 服务探测")" \
    "gping:gping:$(L "ping with a live graph" "带实时图表的 ping")" \
    "trip:trippy:$(L "modern traceroute TUI" "现代化的 traceroute 终端界面")" \
    "doggo:doggo:$(L "friendly DNS client" "更友好的 DNS 查询工具")" \
    "http:httpie:$(L "friendly HTTP client" "更友好的 HTTP 客户端")" \
    "tshark:wireshark:$(L "packet capture analysis; GUI is the wireshark-app cask" "抓包分析; 图形界面是 wireshark-app cask")" \
    "termshark:termshark:$(L "Wireshark-style terminal UI" "终端里的 Wireshark 界面")" \
    "ngrep:ngrep:$(L "grep for network traffic" "按内容过滤网络流量")" \
    "bandwhich:bandwhich:$(L "per-process bandwidth, needs sudo" "按进程看带宽, 需要 sudo")" \
    "iftop:iftop:$(L "per-connection bandwidth, needs sudo" "按连接看带宽, 需要 sudo")" \
    "testssl:testssl:$(L "thorough TLS configuration audit" "全面的 TLS 配置审计")" \
    "jq:jq:$(L "pretty JSON; makes the public-IP line neater" "解析 JSON; 让公网 IP 一行更整洁")"; do
    cmd=${spec%%:*}; desc=${spec#*:}; pkg=${desc%%:*}; desc=${desc#*:}; total=$((total+1))
    if has "$cmd"; then have=$((have+1)); ok "$cmd  ($desc)"
    else printf '  - %-10s %s  →  brew install %s\n' "$cmd" "($desc)" "$pkg"; fi
  done
  echo
  echo "$(L "$have of $total optional tools installed. None of them is required." "已安装 $have / $total 个可选工具, 都不是必需的。")"
  if has brew; then echo "$(L "To install them all: brew bundle --file=Brewfile (in the NetDoctor folder)" "全部安装: 在 NetDoctor 目录里运行 brew bundle --file=Brewfile")"
  else echo "$(L "These need Homebrew first: https://brew.sh" "这些工具需要先安装 Homebrew: https://brew.sh")"; fi
}

# 转义成 sed -E 里的字面量
re_escape() { printf '%s' "$1" | sed 's/[][\.*^$/&|(){}+?]/\\&/g'; }

# 报告脱敏: 从标准输入读, 把个人信息换成占位符写到标准输出。
# 隐藏: 公网 IP、全局 IPv6、MAC、Wi-Fi 名称 / BSSID、主机名、搜索域、用户名路径、VPN 隧道地址。
# 保留: 局域网私有地址、网关、公共 DNS 的地址、延迟 / 丢包等诊断数据 (这些发给别人才有用)。
redact_filter() {
  local h hs u rules=()
  h=$(hostname 2>/dev/null); hs=$(hostname -s 2>/dev/null); u=$(id -un 2>/dev/null)
  [ -n "$h" ]  && rules+=(-e "s/$(re_escape "$h")/<hostname>/g")
  [ -n "$hs" ] && rules+=(-e "s/$(re_escape "$hs")/<hostname>/g")
  [ -n "$u" ]  && rules+=(-e "s#/Users/$(re_escape "$u")#/Users/<user>#g")
  # 报告时现取的确切值 (公网 IPv4 / IPv6、Wi-Fi 名称): 不管它们出现在哪一行、什么格式, 都整体替换。
  # 太短的值 (< 3 个字符) 会误伤普通文字, 不处理。
  local lit
  while IFS= read -r lit; do
    [ "${#lit}" -ge 3 ] && rules+=(-e "s/$(re_escape "$lit")/<redacted>/g")
  done <<EOF
${REDACT_LITERALS:-}
EOF
  rules+=(
    -e 's/([0-9A-Fa-f]{1,2}:){5}[0-9A-Fa-f]{1,2}/xx:xx:xx:xx:xx:xx/g'
    -e 's/[A-Za-z0-9-]+\.ts\.net/<tailnet-host>/g'
    -e 's/^( *(Public IP|公网 IP): )\{.*/\1<redacted>/'      # 没装 jq 时是原始 JSON (含城市 / 运营商 / 经纬度)
    -e 's/^( *(Public IP|公网 IP): )[^ ]+/\1<redacted>/'
    -e 's/^ *\{.*"ip".*$/   <redacted>/'
    -e 's/^( *IPv6: ).*/\1<redacted>/'
    -e 's/^( *(Search domains|搜索域): ).*/\1<redacted>/'
    -e 's/^( *(Search domain|搜索域) +)[^ ].*/\1<redacted>/'
    -e 's/^( *(search domain\[[0-9]+\]|domain) *: ).*/\1<redacted>/'
    -e 's/(\] IPv[46]  )[^ ]+/\1<redacted>/'
    -e 's/^   ([0-9]{1,3}\.){3}[0-9]{1,3}(  .*)$/   <redacted>\2/'
    -e 's/^   ([0-9A-Fa-f]{1,4}:){2,}[0-9A-Fa-f:]*$/   <redacted>/'
    -e 's/^   ([0-9A-Fa-f]{1,4}:){2,}[0-9A-Fa-f:]*(  .*)$/   <redacted>\2/'
    -e 's/(inet6 )(f[cd][0-9A-Fa-f:]*|[23][0-9A-Fa-f:]*)/\1<redacted>/'
    -e 's/(inet6 )fe80[0-9A-Fa-f:]*/\1fe80::<redacted>/'   # 老式 EUI-64 的链路本地地址由 MAC 推导, 会间接泄漏 MAC
    -e 's/(Current Wi-Fi Network: ).*/\1<redacted>/'
    -e 's/^( *B?SSID *:).*/\1 <redacted>/'
    -e 's/((utun|ppp|ipsec|tun|tap)[0-9]+)=[0-9.]+/\1=<redacted>/g'
  )
  sed -E "${rules[@]}"
}

# 把纯文本报告 (标准输入) 转成单文件 HTML (标准输出): 每个 "== 标题 ==" 一个可折叠区块, [ OK ]/[WARN]/[FAIL] 着色,
# 顶部有计数摘要。没有外部依赖, 只用 awk; 已脱敏的文本照样可用 (脱敏在转换之前做)。
report_to_html() { # $1=标题 $2=生成时间 $3=摘要标签 $4=语言属性
  awk -v title="$1" -v when="$2" -v sumlabel="$3" -v lang="$4" '
    function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
    function out(s) { body = body s "\n" }
    BEGIN { open = 0; pre = 0 }
    {
      line = esc($0)
      if (line ~ /^== .* ==$/) {
        if (pre) { out("</pre>"); pre = 0 }
        if (open) out("</details>")
        h = substr(line, 4, length(line) - 6)
        out("<details open><summary>" h "</summary>"); open = 1; out("<pre>"); pre = 1; next
      }
      if (!pre) { out("<pre class=\"head\">"); pre = 1 }
      if (line ~ /\[FAIL\]/) { nf++; sub(/\[FAIL\]/, "<span class=\"f\">[FAIL]</span>", line) }
      else if (line ~ /\[WARN\]/) { nw++; sub(/\[WARN\]/, "<span class=\"w\">[WARN]</span>", line) }
      else if (line ~ /\[ OK \]/) { no++; sub(/\[ OK \]/, "<span class=\"o\">[ OK ]</span>", line) }
      out(line)
    }
    END {
      if (pre) out("</pre>")
      if (open) out("</details>")
      print "<!doctype html><html lang=\"" lang "\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
      print "<title>" esc(title) "</title><style>"
      print ":root{--bg:#fff;--fg:#1d1d1f;--mut:#6e6e73;--card:#f5f5f7;--ok:#1a7f37;--warn:#9a6700;--fail:#cf222e}"
      print "@media(prefers-color-scheme:dark){:root{--bg:#1c1c1e;--fg:#f5f5f7;--mut:#98989d;--card:#2c2c2e;--ok:#3fb950;--warn:#d29922;--fail:#ff7b72}}"
      print "body{margin:0 auto;max-width:900px;padding:24px 16px;background:var(--bg);color:var(--fg);font:15px/1.5 -apple-system,BlinkMacSystemFont,sans-serif}"
      print "h1{font-size:22px;margin:0 0 4px}.m{color:var(--mut);margin:0 0 16px}.sum span{display:inline-block;margin-right:14px;font-weight:600}"
      print "details{background:var(--card);border-radius:10px;margin:12px 0;padding:8px 14px}summary{cursor:pointer;font-weight:600;padding:4px 0}"
      print "pre{margin:6px 0;font:12.5px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap;word-break:break-word}pre.head{background:var(--card);border-radius:10px;padding:10px 14px}"
      print ".o{color:var(--ok);font-weight:600}.w{color:var(--warn);font-weight:600}.f{color:var(--fail);font-weight:600}"
      print "</style></head><body><h1>" esc(title) "</h1><p class=\"m\">" esc(when) "</p>"
      print "<p class=\"sum\"><span>" sumlabel "</span><span class=\"o\">OK " no+0 "</span><span class=\"w\">WARN " nw+0 "</span><span class=\"f\">FAIL " nf+0 "</span></p>"
      printf "%s", body
      print "</body></html>"
    }'
}

cmd_report() {
  local NETDOCTOR_NOSUDO=1   # 输出被重定向到文件, 不要在中途弹出 sudo 密码提示
  local B= G= R= Y= N=       # 报告是纯文本文件: 即使网页 / App 设了 NETDOCTOR_COLOR=1, 也不能把颜色转义码写进去 (动态作用域, 下面调用的函数也生效)
  local redact=0 html=0 a
  for a in "$@"; do case "$a" in redact|--redact) redact=1;; html|--html) html=1;; *) bad "$(L "Unknown option: $a (use: report [html] [redact])" "未知选项: $a (用法: report [html] [redact])")"; return 1;; esac; done
  local dir="$HOME/Desktop"; [ -d "$dir" ] && [ -w "$dir" ] || dir="$HOME"   # 没有桌面目录 (或不可写) 就存到主目录
  local ext=txt; [ "$html" = 1 ] && ext=html
  local f="$dir/netdoctor-report-$(date +%Y%m%d-%H%M%S).$ext" gen
  gen=$(mktemp) || { bad "$(L "Could not create a temporary file" "无法创建临时文件")"; return 1; }
  if [ "$redact" = 1 ]; then
    local ssid v; REDACT_LITERALS=""
    ssid=$(networksetup -getairportnetwork "$(wifi_if)" 2>/dev/null | sed -n 's/^Current Wi-Fi Network: //p' | head -1)   # 只认这个前缀: 其他输出是错误提示, 不是 SSID
    [ -n "$ssid" ] && REDACT_LITERALS="$ssid"
    for v in "$(curl -4 -s -m 5 https://api.ip.sb/ip 2>/dev/null)" "$(curl -6 -s -m 5 https://api.ip.sb/ip 2>/dev/null)"; do
      case "$v" in ""|*[!0-9A-Fa-f.:]*) ;; *) REDACT_LITERALS="$REDACT_LITERALS
$v";; esac
    done
  fi
  { echo "netdoctor report $(date)"; uname -a; sw_vers
    cmd_doctor; cmd_overview; cmd_dhcp; cmd_quick; cmd_wifi; cmd_dns apple.com; cmd_ipv6; cmd_proxy; } >"$gen" 2>&1
  local txt; txt=$(mktemp) || { rm -f "$gen"; bad "$(L "Could not create a temporary file" "无法创建临时文件")"; return 1; }
  if [ "$redact" = 1 ]; then
    { echo "# $(L "Personal info hidden (public IP, MAC, Wi-Fi name, host name, search domains)" "已隐藏个人信息 (公网 IP、MAC、Wi-Fi 名称、主机名、搜索域)")"; redact_filter <"$gen"; } >"$txt"
  else
    cat "$gen" >"$txt"
  fi
  if [ "$html" = 1 ]; then report_to_html "NetDoctor $(L "report" "报告")" "$(date)" "$(L "Summary" "概要")" "$(L en zh-CN)" <"$txt" >"$f"
  else cat "$txt" >"$f"; fi
  rm -f "$txt"
  rm -f "$gen"
  if [ ! -s "$f" ]; then bad "$(L "Could not write the report to $f" "无法写入报告: $f")"; return 1; fi
  ok "$(L "Saved: $f" "已保存: $f")"
  if [ "$redact" = 1 ]; then
    warn "$(L "Personal info was hidden; skim the report once before you share it anyway." "已隐藏个人信息; 分享前仍请快速浏览一遍。")"
  else
    warn "$(L "The report contains your IP addresses, MAC address and Wi-Fi name; check it before you share it (netdoctor report redact hides them)." "报告包含你的 IP 地址、MAC 地址和 Wi-Fi 名称, 分享给别人前请先检查 (netdoctor report redact 可自动隐藏)。")"
  fi
}

# 被当作函数库 source 进来 (自动化测试用): NETDOCTOR_SOURCE_ONLY=1 . ./netdoctor ——只定义函数, 不执行命令分发
[ -n "${NETDOCTOR_SOURCE_ONLY:-}" ] && { return 0 2>/dev/null || exit 0; }

c=${1:-help}; [ $# -gt 0 ] && shift
case "$c" in
  quick|q) cmd_quick;; doctor|diagnose) cmd_doctor "$@";; tcpping) cmd_tcpping "$@";; overview) cmd_overview;; dhcp) cmd_dhcp;; mtr) cmd_mtr "$@";; watch) cmd_watch "$@";; dnsset) cmd_dnsset "$@";; compare) cmd_compare "$@";; leak) cmd_leak;; channels) cmd_channels;; exposure) cmd_exposure;; bonjour) cmd_bonjour "$@";; ports) cmd_ports "$@";; dnsbench) cmd_dnsbench "$@";; lan) cmd_lan;; ipv6) cmd_ipv6;; captive) cmd_captive;; wifi) cmd_wifi;; dns) cmd_dns "$@";; route) cmd_route "$@";;
  ping) cmd_ping "$@";; port) cmd_port "$@";; http) cmd_http "$@";; tls) cmd_tls "$@";;
  mtu) cmd_mtu "$@";; speed) cmd_speed;; conns) cmd_conns;; proxy) cmd_proxy;;
  capture) cmd_capture "$@";; fixdns) cmd_fixdns;; fix) cmd_fix "$@";; report) cmd_report "$@";; tools) cmd_tools;;
  version|-v|--version) echo "netdoctor $VERSION";;
  help|-h|--help) usage;;
  *) warn "$(L "Unknown command: $c (this is netdoctor $VERSION; if the command is in the README, update with: git pull)" "未知命令: $c (当前是 netdoctor $VERSION; 如果 README 里有这个命令, 请先更新: git pull)")"; usage; exit 2;;
esac
