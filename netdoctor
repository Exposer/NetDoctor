#!/usr/bin/env bash
# netdoctor - unified entry point for macOS network diagnostics (works with the stock bash 3.2)
set -u
VERSION=1.0
B=$'\033[1m'; G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; N=$'\033[0m'
[ -t 1 ] || [ -n "${NETDOCTOR_COLOR:-}" ] || { B=; G=; R=; Y=; N=; }
has() { command -v "$1" >/dev/null 2>&1; }
hdr() { printf '\n%s== %s ==%s\n' "$B" "$*" "$N"; }
ok()  { printf '%s[ OK ]%s %s\n' "$G" "$N" "$*"; }
bad() { printf '%s[FAIL]%s %s\n' "$R" "$N" "$*"; }
warn(){ printf '%s[WARN]%s %s\n' "$Y" "$N" "$*"; }

default_if()  { route -n get default 2>/dev/null | awk '/interface:/{print $2}'; }
gateway()     { route -n get default 2>/dev/null | awk '/gateway:/{print $2}'; }
wifi_if()     { networksetup -listallhardwareports 2>/dev/null | awk '/Wi-Fi|AirPort/{getline; print $2; exit}'; }

usage() { cat <<USAGE
netdoctor $VERSION - macOS network diagnostics

Usage: netdoctor <command> [args]
  quick                 one-shot check: interface/gateway/DNS/internet/HTTP (run this first)
  wifi                  Wi-Fi signal, channel, rate, SSID (some details need sudo)
  dns <domain>          compare system/1.1.1.1/8.8.8.8/223.5.5.5 answers and timings
  route <host>          route selection + traceroute/mtr path
  ping <host>           ping with loss/jitter stats (20 packets by default)
  port <host> <port>    TCP port reachability
  http <URL>            curl timing breakdown (DNS/TCP/TLS/first byte/total)
  tls <host> [port]     certificate, protocol version, validity
  mtu [host]            probe path MTU (large-packet loss / VPN issues)
  speed                 bandwidth + responsiveness (built-in networkQuality)
  conns                 current connections and listening ports (by process)
  proxy                 system proxy / env-var proxy / VPN status
  capture [filter]      tcpdump capture to ~/Desktop (needs sudo)
  fixdns                flush the DNS cache (needs sudo)
  report                save quick+wifi+dns+proxy output to a file
  tools                 check whether third-party tools are installed
USAGE
}

cmd_quick() {
  hdr "Interface and gateway"
  local ifc gw; ifc=$(default_if); gw=$(gateway)
  if [ -z "$ifc" ]; then bad "No default route (not connected?)"; ifconfig | grep -E '^[a-z0-9]+:|inet ' ; return; fi
  ok "Default interface $ifc  gateway ${gw:-none}"
  ifconfig "$ifc" | awk '/inet |inet6 |ether|status/{print "   "$0}'
  hdr "Gateway reachability"
  if [ -n "$gw" ]; then
    ping -c 3 -t 5 "$gw" >/dev/null 2>&1 && ok "Gateway $gw reachable" || bad "Gateway $gw unreachable (Wi-Fi / cable / router problem)"
  fi
  hdr "Internet reachability by IP (bypassing DNS)"
  for ip in 1.1.1.1 8.8.8.8 223.5.5.5; do
    ping -c 2 -t 4 "$ip" >/dev/null 2>&1 && ok "ping $ip" || bad "ping $ip"
  done
  hdr "DNS"
  scutil --dns | awk '/nameserver\[/{print "   "$0}' | sort -u | head -6
  for d in apple.com baidu.com; do
    if dig +short +time=3 +tries=1 "$d" 2>/dev/null | grep -q .; then ok "Resolve $d"; else bad "Failed to resolve $d"; fi
  done
  hdr "HTTP/HTTPS"
  for u in https://www.apple.com https://www.baidu.com https://www.google.com; do
    code=$(curl -s -o /dev/null -m 8 -w '%{http_code} %{time_total}s' "$u" 2>/dev/null)
    case "$code" in 2*|3*) ok "$u  $code";; *) bad "$u  ${code:-timeout}";; esac
  done
  hdr "Public IP"
  curl -s -m 6 https://api.ip.sb/geoip 2>/dev/null | (has jq && jq -r '"   \(.ip)  \(.country) \(.isp // .organization)"' || cat) || warn "Lookup failed"
  echo
  echo "Reading: gateway down → local link; IP works but names fail → DNS; names work but HTTP fails → proxy/firewall/TLS."
}

cmd_wifi() {
  local w; w=$(wifi_if); w=${w:-en0}
  hdr "Wi-Fi ($w)"
  networksetup -getairportnetwork "$w" 2>/dev/null
  if has wdutil; then
    echo "(wdutil needs sudo to show full details)"
    sudo wdutil info 2>/dev/null | awk '/SSID|BSSID|RSSI|Noise|Tx Rate|Channel|PHY Mode|Security|Country/' | head -20
  fi
  hdr "system_profiler summary"
  system_profiler SPAirPortDataType 2>/dev/null | awk '/Current Network Information/{f=1} f&&/PHY Mode|Channel|Security|Signal|Transmit Rate|Country/{print} /Other Local Wi-Fi/{exit}'
  echo "Rules of thumb: RSSI > -60 good, -70 fair, < -75 poor; SNR (RSSI-Noise) should be > 25 to be stable."
  warn "Nearby Wi-Fi scan: Option-click the Wi-Fi menu bar icon, or use Wireless Diagnostics (Option-click the icon → Open Wireless Diagnostics)"
}

cmd_dns() {
  local d=${1:-}; [ -z "$d" ] && { echo "Usage: netdoctor dns <domain>"; return 1; }
  hdr "System resolvers (scutil --dns)"; scutil --dns | awk '/resolver #|nameserver\[|domain|search domain|if_index/{print "  "$0}' | head -24
  hdr "System resolution (dscacheutil, the real system path)"; dscacheutil -q host -a name "$d"
  hdr "DNS server comparison"
  for s in "" 1.1.1.1 8.8.8.8 223.5.5.5 119.29.29.29; do
    label=${s:-system}
    out=$(dig ${s:+@$s} +tries=1 +time=3 "$d" A 2>&1)
    ans=$(echo "$out" | awk '/^[^;].*IN[ \t]+A[ \t]/{printf "%s ", $NF}')
    t=$(echo "$out" | awk '/Query time/{print $4" ms"}')
    printf '  %-12s %-10s %s\n' "$label" "${t:-timeout}" "${ans:-(no answer)}"
  done
  echo "Tip: big differences between servers, or a failing system default → ISP hijacking or a DNS config problem; try netdoctor fixdns."
}

cmd_route() {
  local h=${1:-}; [ -z "$h" ] && { echo "Usage: netdoctor route <host>"; return 1; }
  hdr "Route selection (which interface/VPN the traffic uses)"; route -n get "$h" 2>&1 | awk '/destination|gateway|interface/'
  hdr "Path"
  if has mtr; then sudo mtr -rwbzc 20 "$h"; else traceroute -w 2 -q 1 -m 20 "$h"; warn "brew install mtr gives per-hop loss statistics"; fi
}

cmd_ping() { local h=${1:-}; [ -z "$h" ] && { echo "Usage: netdoctor ping <host> [count]"; return 1; }; ping -c "${2:-20}" "$h"; }

cmd_port() {
  [ $# -lt 2 ] && { echo "Usage: netdoctor port <host> <port>"; return 1; }
  nc -vz -G 5 "$1" "$2" 2>&1 && ok "$1:$2 open" || bad "$1:$2 unreachable (closed / firewall / routing)"
}

cmd_http() {
  local u=${1:-}; [ -z "$u" ] && { echo "Usage: netdoctor http <URL>"; return 1; }
  curl -sS -o /dev/null -L -m 30 -w '
  HTTP status     %{http_code}  (%{num_redirects} redirects)
  Remote IP       %{remote_ip}:%{remote_port}
  DNS lookup      %{time_namelookup}s
  TCP connect     %{time_connect}s
  TLS handshake   %{time_appconnect}s
  First byte      %{time_starttransfer}s
  Total           %{time_total}s
  Download speed  %{speed_download} B/s
' "$u" || bad "Request failed; investigate with: curl -v $u"
}

cmd_tls() {
  local h=${1:-}; local p=${2:-443}; [ -z "$h" ] && { echo "Usage: netdoctor tls <host> [port]"; return 1; }
  local out; out=$(echo | openssl s_client -connect "$h:$p" -servername "$h" -brief 2>&1)
  echo "$out" | head -12
  echo | openssl s_client -connect "$h:$p" -servername "$h" 2>/dev/null | openssl x509 -noout -subject -issuer -dates -ext subjectAltName 2>/dev/null
  has testssl && echo "Full audit: testssl $h:$p"
}

cmd_mtu() {
  local h=${1:-1.1.1.1} s
  hdr "Path MTU probe -> $h (DF bit)"
  for s in 1472 1452 1432 1412 1372 1272 1172; do
    if ping -c 1 -t 3 -D -s "$s" "$h" >/dev/null 2>&1; then
      ok "Payload $s passed → MTU ≈ $((s+28))"; return; fi
    printf '  Payload %s lost\n' "$s"
  done
  bad "All failed; the target may block ICMP"
}

cmd_speed() { has networkQuality && networkQuality -v || { bad "Requires macOS 12+"; has speedtest-cli && speedtest-cli; }; }

cmd_conns() {
  hdr "Listening ports"; sudo lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk 'NR==1||1' | head -40
  hdr "Established connections"; sudo lsof -nP -iTCP -sTCP:ESTABLISHED 2>/dev/null | head -40
  has nettop && echo "Live per-process traffic: nettop -P -d    |   bandwhich (needs sudo)"
}

cmd_proxy() {
  hdr "System proxy (scutil --proxy)"; scutil --proxy
  hdr "Environment-variable proxy"; env | grep -i -E '^(https?|all|no)_proxy=' || echo "  (none)"
  hdr "VPN / tunnel interfaces"; ifconfig | awk '/^(utun|ppp|ipsec|tun|tap)[0-9]*:/{print $1}'
  hdr "Configured VPN services"; scutil --nc list 2>/dev/null
  hdr "Per-service proxy (networksetup)"
  networksetup -listallnetworkservices 2>/dev/null | tail -n +2 | grep -v '^\*' | while read -r s; do
    echo "- $s: $(networksetup -getwebproxy "$s" | tr '\n' ' ')"
  done
}

cmd_capture() {
  local f=${1:-}; local out="$HOME/Desktop/cap-$(date +%Y%m%d-%H%M%S).pcap"
  echo "Capturing → $out  (Ctrl-C to stop; open with Wireshark)"
  echo "Filter examples: 'host 1.2.3.4'  'port 53'  'tcp port 443 and host x.com'"
  if [ -n "$f" ]; then sudo tcpdump -i "$(default_if)" -nn -s0 -w "$out" "$f"; else sudo tcpdump -i "$(default_if)" -nn -s0 -w "$out"; fi
}

cmd_fixdns() { sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder && ok "DNS cache flushed"; }

cmd_tools() {
  hdr "Built-in"
  for t in ping traceroute netstat lsof nc curl dig scutil networksetup route tcpdump nettop networkQuality wdutil ifconfig arp dscacheutil system_profiler; do
    has "$t" && ok "$t" || warn "$t missing"; done
  hdr "Third-party (brew bundle --file=Brewfile)"
  for t in mtr iperf3 fping nmap gping trip doggo http tshark termshark ngrep bandwhich iftop testssl speedtest-cli jq; do
    has "$t" && ok "$t" || warn "$t not installed"; done
}

cmd_report() {
  local f="$HOME/Desktop/netdoctor-report-$(date +%Y%m%d-%H%M%S).txt"
  { echo "netdoctor report $(date)"; uname -a; sw_vers
    cmd_quick; cmd_wifi; cmd_dns apple.com; cmd_proxy; } >"$f" 2>&1
  ok "Saved: $f"
}

c=${1:-help}; [ $# -gt 0 ] && shift
case "$c" in
  quick|q) cmd_quick;; wifi) cmd_wifi;; dns) cmd_dns "$@";; route) cmd_route "$@";;
  ping) cmd_ping "$@";; port) cmd_port "$@";; http) cmd_http "$@";; tls) cmd_tls "$@";;
  mtu) cmd_mtu "$@";; speed) cmd_speed;; conns) cmd_conns;; proxy) cmd_proxy;;
  capture) cmd_capture "$@";; fixdns) cmd_fixdns;; report) cmd_report;; tools) cmd_tools;;
  *) usage;;
esac
