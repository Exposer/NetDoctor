#!/bin/bash
# netdoctor - unified entry point for macOS network diagnostics (works with the stock bash 3.2)
set -u
VERSION=1.3.0
B=$'\033[1m'; G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; N=$'\033[0m'
[ -t 1 ] || [ -n "${NETDOCTOR_COLOR:-}" ] || { B=; G=; R=; Y=; N=; }
# Language: NETDOCTOR_LANG=zh|en, otherwise taken from the locale (LC_ALL / LANG)
case "${NETDOCTOR_LANG:-${LC_ALL:-${LANG:-}}}" in zh*|ZH*) ZH=1;; *) ZH=0;; esac
L() { if [ "$ZH" = 1 ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }
has() { command -v "$1" >/dev/null 2>&1; }
hdr() { printf '\n%s== %s ==%s\n' "$B" "$*" "$N"; }
ok()  { printf '%s[ OK ]%s %s\n' "$G" "$N" "$*"; }
bad() { printf '%s[FAIL]%s %s\n' "$R" "$N" "$*"; }
warn(){ printf '%s[WARN]%s %s\n' "$Y" "$N" "$*"; }

default_if()  { route -n get default 2>/dev/null | awk '/interface:/{print $2}'; }
gateway()     { route -n get default 2>/dev/null | awk '/gateway:/{print $2}'; }
# 提权: 已是 root 直接执行; 有终端时正常询问密码; 无终端(GUI 调用)或设了 NETDOCTOR_NOSUDO(如 report)用 -n, 避免卡在/弹出密码提示
priv() { if [ "$(id -u)" = 0 ]; then "$@"; elif [ -t 0 ] && [ -z "${NETDOCTOR_NOSUDO:-}" ]; then sudo "$@"; else sudo -n "$@"; fi; }
# 能否提权: root / 有终端 (sudo 会询问密码) / sudo 已缓存凭据。GUI 调用没有终端, 拿不到就别硬跑
can_priv() { [ "$(id -u)" = 0 ] && return 0; [ -t 0 ] && [ -z "${NETDOCTOR_NOSUDO:-}" ] && return 0; sudo -n true 2>/dev/null; }
need_admin() { bad "$(L "Administrator rights are required: run  sudo netdoctor $1  in a terminal" "需要管理员权限: 请在终端运行  sudo netdoctor $1")"; }
wifi_if()     { networksetup -listallhardwareports 2>/dev/null | awk '/Wi-Fi|AirPort/{getline; print $2; exit}'; }

usage() {
  if [ "$ZH" = 1 ]; then cat <<USAGE
netdoctor $VERSION - macOS 网络诊断

用法: netdoctor <命令> [参数]
  quick                 一键体检: 网卡/网关/DNS/外网/HTTP (先跑这个)
  doctor                智能诊断: 逐层检查并给出结论和下一步建议 (遇到问题先跑这个)
  overview              网络概览: 网卡/IP/网关/DNS/Wi-Fi/代理/公网 IP 一屏看全
  dhcp                  DHCP / IP 地址: 租约详情, 识别 169.254 自分配地址 (DHCP 失败)
  tcpping <主机> <端口> [次数]  TCP 连接延迟 (ping 被屏蔽时用; 默认 10 次)
  ports <主机> [端口]   并行检测多个端口 (默认常用端口; 如 22,80 或 1-1024)
  ipv6                  IPv4 / IPv6 双栈连通性对比 (有 IPv6 地址却不通时给出判读)
  captive               检测强制门户 (连上 Wi-Fi 却打不开网页)
  dnsbench [域名]       DNS 测速: 对比系统与多家公共 DNS 的速度并给出推荐
  lan                   局域网设备发现: 扫描本网段, 列出 IP / MAC / 主机名
  wifi                  Wi-Fi 信号、信道、速率、SSID (部分信息需 sudo)
  dns <域名>            对比 系统/1.1.1.1/8.8.8.8/223.5.5.5 解析结果与耗时
  route <主机>          路由选择 + traceroute/mtr 路径
  ping <主机>           持续 ping 并统计丢包/抖动 (默认 20 个包)
  port <主机> <端口>    TCP 端口连通性
  http <URL>            curl 分阶段耗时 (DNS/TCP/TLS/首字节/总计)
  tls <主机> [端口]     证书、协议版本、有效期
  mtu [主机]            探测路径 MTU (排查大包丢失/VPN 问题)
  speed                 带宽 + 响应性 (系统自带 networkQuality)
  conns                 当前连接与监听端口 (按进程)
  proxy                 系统代理 / 环境变量代理 / VPN 状态
  capture [过滤器]      tcpdump 抓包到 ~/Desktop (需 sudo)
  fixdns                刷新 DNS 缓存 (需 sudo)
  report [redact]       把诊断、概览、DHCP、Wi-Fi、DNS、IPv6、代理等保存到文件; redact 自动隐藏 IP / MAC / Wi-Fi 名等个人信息
  tools                 检查第三方工具是否已安装
USAGE
  else cat <<USAGE
netdoctor $VERSION - macOS network diagnostics

Usage: netdoctor <command> [args]
  quick                 one-shot check: interface/gateway/DNS/internet/HTTP (run this first)
  doctor                smart diagnosis: layer-by-layer checks with a verdict and next steps
  overview              network snapshot: interface/IP/gateway/DNS/Wi-Fi/proxy/public IP
  dhcp                  DHCP lease details; spots a self-assigned 169.254 address (DHCP failed)
  tcpping <host> <port> [count]  TCP connect latency (for when ping is blocked; 10 by default)
  ports <host> [ports]  check many ports in parallel (common ports by default; e.g. 22,80 or 1-1024)
  ipv6                  compare IPv4 / IPv6 (dual-stack) connectivity and spot a broken IPv6 path
  captive               detect a captive portal (Wi-Fi connected but no web access)
  dnsbench [domain]     DNS benchmark: compare the system and public DNS servers and recommend one
  lan                   discover devices on the local network (IP / MAC / name)
  wifi                  Wi-Fi signal, channel, rate, SSID (some details need sudo)
  dns <domain>          compare system/1.1.1.1/8.8.8.8/223.5.5.5 answers and timings
  route <host>          route selection + traceroute/mtr path
  ping <host>           ping with loss/jitter stats (20 packets by default)
  port <host> <port>    TCP port reachability
  http <URL>            curl timing breakdown (DNS/TCP/TLS/first byte/total)
  tls <host> [port]     certificate, protocol version, validity
  mtu [host]            probe path MTU (large-packet loss / VPN issues)
  speed                 bandwidth + responsiveness (built-in networkQuality)
  conns                 current connections and listening ports (by process)
  proxy                 system proxy / env-var proxy / VPN status
  capture [filter]      tcpdump capture to ~/Desktop (needs sudo)
  fixdns                flush the DNS cache (needs sudo)
  report [redact]       save diagnosis, overview, DHCP, Wi-Fi, DNS, IPv6 and proxy info to a file; "redact" hides IP / MAC / Wi-Fi name etc.
  tools                 check whether third-party tools are installed
USAGE
  fi
}

row() { printf '  %s: %s\n' "$1" "$(printf '%s' "$2" | sed 's/[[:space:]]*$//')"; }

cmd_overview() {
  local ifc gw ip4 ip6 mac mtu dns dom wn px vpn
  hdr "$(L "Network overview" "网络概览")"
  ifc=$(default_if); gw=$(gateway)
  if [ -z "$ifc" ]; then bad "$(L "No default route (not connected?)" "没有默认路由 (未联网?)")"; return 1; fi
  ip4=$(ipconfig getifaddr "$ifc" 2>/dev/null); [ -z "$ip4" ] && ip4=$(ifconfig "$ifc" 2>/dev/null | awk '/inet /{print $2; exit}')
  ip6=$(ifconfig "$ifc" 2>/dev/null | awk '/inet6 / && $2 !~ /^fe80/{print $2; exit}')
  mac=$(ifconfig "$ifc" 2>/dev/null | awk '/ether /{print $2; exit}')
  mtu=$(ifconfig "$ifc" 2>/dev/null | sed -n 's/.*mtu \([0-9]*\).*/\1/p' | head -1)
  row "$(L "Interface" "网卡")" "$ifc${mtu:+  (MTU $mtu)}"
  row "IPv4" "${ip4:-$(L "none" "无")}"
  row "IPv6" "${ip6:-$(L "none" "无")}"
  row "MAC" "${mac:-$(L "unknown" "未知")}"
  if [ -n "$gw" ]; then
    if ping -c 1 -t 2 "$gw" >/dev/null 2>&1; then row "$(L "Gateway" "网关")" "$gw  $(L "(reachable)" "(可达)")"
    else row "$(L "Gateway" "网关")" "$gw  $(L "(unreachable)" "(不通)")"; fi
  else row "$(L "Gateway" "网关")" "$(L "none" "无")"; fi
  dns=$(scutil --dns 2>/dev/null | awk '/nameserver\[[0-9]+\]/{print $3}' | awk '!seen[$0]++' | tr '\n' ' ')
  dom=$(scutil --dns 2>/dev/null | awk '/search domain\[[0-9]+\]/{print $4}' | awk '!seen[$0]++' | tr '\n' ' ')
  row "DNS" "${dns:-$(L "unknown" "未知")}"
  [ -n "$dom" ] && row "$(L "Search domains" "搜索域")" "$dom"
  if has networksetup; then
    wn=$(networksetup -getairportnetwork "$(wifi_if)" 2>/dev/null | sed 's/^Current Wi-Fi Network: //')
    [ -n "$wn" ] && row "Wi-Fi" "$wn"
  fi
  px=$(scutil --proxy 2>/dev/null | awk '/HTTPEnable : 1/{h=1} /HTTPProxy :/{hp=$3} /HTTPPort :/{hq=$3} /HTTPSEnable : 1/{s=1} /HTTPSProxy :/{sp=$3} /HTTPSPort :/{sq=$3} /SOCKSEnable : 1/{k=1} /SOCKSProxy :/{kp=$3} /SOCKSPort :/{kq=$3} END{if(h)printf "http=%s:%s ",hp,hq; if(s)printf "https=%s:%s ",sp,sq; if(k)printf "socks=%s:%s ",kp,kq}')
  row "$(L "Proxy" "代理")" "${px:-$(L "none" "无")}"
  vpn=$(ifconfig 2>/dev/null | awk '/^[a-z0-9]+:/{n=$1; sub(":","",n)} /inet /{if (n ~ /^(utun|ppp|ipsec|tun|tap)/) printf "%s=%s ", n, $2}')
  row "$(L "VPN / tunnels" "VPN / 隧道")" "${vpn:-$(L "none" "无")}"
  local geo; geo=$(curl -s -m 6 https://api.ip.sb/geoip 2>/dev/null)
  if [ -n "$geo" ] && has jq; then row "$(L "Public IP" "公网 IP")" "$(echo "$geo" | jq -r '"\(.ip)  \(.country // "") \(.isp // .organization // "")"')"
  elif [ -n "$geo" ]; then row "$(L "Public IP" "公网 IP")" "$(echo "$geo" | tr -d '\n' | cut -c1-120)"
  else row "$(L "Public IP" "公网 IP")" "$(L "lookup failed" "获取失败")"; fi
}

svc() {
  case "$1" in 21) echo ftp;; 22) echo ssh;; 23) echo telnet;; 25) echo smtp;; 53) echo dns;; 80) echo http;; 110) echo pop3;;
    143) echo imap;; 443) echo https;; 465) echo smtps;; 587) echo submission;; 993) echo imaps;; 995) echo pop3s;;
    1433) echo mssql;; 3306) echo mysql;; 3389) echo rdp;; 5432) echo postgres;; 5900) echo vnc;; 6379) echo redis;;
    8080) echo http-alt;; 8443) echo https-alt;; 27017) echo mongodb;; *) echo "";; esac
}

cmd_ports() {
  local h=${1:-} spec=${2:-} list="" tok a b i n=0 total tmp ncopt open p closed
  [ -z "$h" ] && { echo "$(L "Usage: netdoctor ports <host> [ports]" "用法: netdoctor ports <主机> [端口]")"; return 1; }
  case "$h" in *[!A-Za-z0-9._:-]*|-*) bad "$(L "Invalid host: $h" "主机无效: $h")"; return 1;; esac
  [ -z "$spec" ] && spec="21,22,23,25,53,80,110,143,443,465,587,993,995,1433,3306,3389,5432,5900,6379,8080,8443,27017"
  case "$spec" in *[!0-9,-]*) bad "$(L "Invalid port list: $spec" "端口列表无效: $spec")"; return 1;; esac
  for tok in $(echo "$spec" | tr ',' ' '); do
    case "$tok" in
      *-*) a=${tok%%-*}; b=${tok#*-}
           if [ -z "$a" ] || [ -z "$b" ] || [ -n "${b//[0-9]/}" ]; then bad "$(L "Invalid port list: $spec" "端口列表无效: $spec")"; return 1; fi ;;
      *)   a=$tok; b=$tok ;;
    esac
    a=$((10#$a)); b=$((10#$b))
    if [ "$a" -lt 1 ] || [ "$b" -gt 65535 ]; then bad "$(L "Port out of range (1-65535): $tok" "端口超出范围 (1-65535): $tok")"; return 1; fi
    if [ "$a" -gt "$b" ]; then bad "$(L "Invalid port range (start is greater than end): $tok" "端口范围无效 (起始大于结束): $tok")"; return 1; fi
    i=$a; while [ "$i" -le "$b" ]; do list="$list $i"; i=$((i+1)); n=$((n+1)); if [ "$n" -gt 1024 ]; then bad "$(L "Too many ports (max 1024 per run)" "端口过多 (每次最多 1024 个)")"; return 1; fi; done
  done
  has nc || { bad "$(L "nc (netcat) not found" "未找到 nc (netcat)")"; return 1; }
  if cannot_resolve "$h"; then bad "$(L "Cannot resolve $h; check the host name or DNS (try: netdoctor dns $h)" "无法解析 $h, 检查域名或 DNS (可试: netdoctor dns $h)")"; return 1; fi
  ncopt="-w 2"; if ! nc -G 2 -z 127.0.0.1 9 2>&1 | grep -qiE 'illegal option|invalid option|unknown option'; then ncopt="-G 2 -w 2"; fi
  tmp=$(mktemp -d); n=0
  for p in $list; do
    ( nc -z $ncopt "$h" "$p" >/dev/null 2>&1 && : >"$tmp/$p" ) &
    n=$((n+1)); [ $((n % 40)) -eq 0 ] && wait
  done
  wait
  total=$n; open=$(ls "$tmp" | sort -n); rm -rf "$tmp"
  hdr "$(L "Ports on $h ($total checked)" "$h 的端口 (已检测 $total 个)")"
  if [ -z "$open" ]; then
    warn "$(L "No open ports found (closed, filtered, or host unreachable)" "没有发现开放端口 (关闭 / 被过滤 / 主机不可达)")"; return 0
  fi
  n=0; for p in $open; do n=$((n+1)); ok "$p/tcp  $(svc "$p")"; done
  echo "$(L "$n open, $((total - n)) closed or filtered" "$n 个开放, $((total - n)) 个关闭或被过滤")"
  if [ "$total" -le 30 ]; then
    closed=""; for p in $list; do case " $(echo $open) " in *" $p "*) ;; *) closed="$closed $p";; esac; done
    [ -n "$closed" ] && echo "$(L "Closed or filtered:" "关闭或被过滤:")$closed"
  fi
  return 0
}

cmd_dnsbench() {
  local extra=${1:-} domains="example.com apple.com baidu.com github.com wikipedia.org"
  local servers="system 1.1.1.1 8.8.8.8 9.9.9.9 223.5.5.5 119.29.29.29 114.114.114.114 180.76.76.76" tmp s best_line rank=0 avg srv ok n mn
  has dig || { bad "$(L "dig not found (brew install bind)" "未找到 dig (brew install bind)")"; return 1; }
  if [ -n "$extra" ]; then
    case "$extra" in *[!A-Za-z0-9.-]*|-*) bad "$(L "Invalid domain: $extra" "域名无效: $extra")"; return 1;; esac
    domains="$domains $extra"
  fi
  hdr "$(L "DNS benchmark" "DNS 测速") ($(echo $domains | wc -w | tr -d ' ') $(L "domains" "个域名"))"
  tmp=$(mktemp -d)
  for s in $servers; do
    (
      sum=0; ok=0; n=0; mn=999999; at=""; [ "$s" != system ] && at="@$s"
      for d in $domains; do
        out=$(dig $at +tries=1 +time=2 "$d" A 2>/dev/null)
        t=$(printf '%s\n' "$out" | awk '/Query time:/{print $4; exit}'); n=$((n+1))
        if [ -n "$t" ] && printf '%s\n' "$out" | grep -q 'status: NOERROR'; then ok=$((ok+1)); sum=$((sum+t)); [ "$t" -lt "$mn" ] && mn=$t; fi
      done
      if [ "$ok" -gt 0 ]; then echo "$((sum/ok)) $s $ok $n $mn" >"$tmp/$s"; else echo "999999 $s 0 $n 0" >"$tmp/$s"; fi
    ) &
  done
  wait
  printf '  %-3s %-17s %9s %9s  %s\n' "#" "Server" "Avg ms" "Min ms" "OK"
  best_line=""
  while read -r avg srv ok n mn; do
    rank=$((rank+1)); [ -z "$best_line" ] && [ "$ok" -gt 0 ] && best_line="$avg $srv"
    if [ "$ok" -gt 0 ]; then printf '  %-3s %-17s %9s %9s  %s/%s\n' "$rank" "$srv" "$avg" "$mn" "$ok" "$n"
    else printf '  %-3s %-17s %9s %9s  %s/%s\n' "$rank" "$srv" "-" "-" "$ok" "$n"; fi
  done <<EOF2
$(cat "$tmp"/* | sort -n)
EOF2
  local sysavg; sysavg=$(awk '$2=="system"{print $1}' "$tmp"/system 2>/dev/null); rm -rf "$tmp"
  [ -z "$best_line" ] && { bad "$(L "No DNS server answered (network down?)" "没有 DNS 服务器应答 (网络不通?)")"; return 1; }
  set -- $best_line
  ok "$(L "Fastest: $2 (avg $1 ms)" "最快: $2 (平均 $1 ms)")"
  if [ "$2" != system ] && [ -n "$sysavg" ] && [ "$sysavg" -lt 999999 ] && [ "$sysavg" -gt $(( $1 * 13 / 10 )) ]; then
    echo "$(L "The system DNS (avg $sysavg ms) is noticeably slower. To switch (Wi-Fi):" "系统 DNS (平均 $sysavg ms) 明显偏慢。可切换 (Wi-Fi):")"
    echo "  networksetup -setdnsservers Wi-Fi $2"
    echo "$(L "To undo: networksetup -setdnsservers Wi-Fi empty" "恢复默认: networksetup -setdnsservers Wi-Fi empty")"
  fi
  echo "$(L "Note: popular domains are usually cached, so this measures the resolver's nearest cache." "注: 热门域名通常有缓存, 测得的是解析器最近缓存的响应速度。")"
}

ip2int() { local IFS=.; set -- $1; echo $(( ($1<<24) + ($2<<16) + ($3<<8) + $4 )); }
int2ip() { echo "$(( ($1>>24)&255 )).$(( ($1>>16)&255 )).$(( ($1>>8)&255 )).$(( $1&255 ))"; }

# 有 169.254.x.x 自分配地址的网卡 (DHCP 没拿到地址时系统会自己分配一个)
self_assigned_if() { ifconfig 2>/dev/null | awk '/^[a-z0-9]+:/{n=$1; sub(":","",n)} /inet 169\.254\./{print n; exit}'; }

cmd_dhcp() {
  local ifc ip pkt srv rtr dns mask lease dom gw ls
  ifc=$(default_if); [ -z "$ifc" ] && ifc=$(self_assigned_if); [ -z "$ifc" ] && ifc=$(wifi_if); ifc=${ifc:-en0}
  hdr "$(L "DHCP / IP address ($ifc)" "DHCP / IP 地址 ($ifc)")"
  ip=$(ifconfig "$ifc" 2>/dev/null | awk '/inet /{print $2; exit}')
  if [ -z "$ip" ]; then
    bad "$(L "$ifc has no IPv4 address (not connected, or DHCP has not answered yet)" "$ifc 没有 IPv4 地址 (没连上网络, 或 DHCP 还没应答)")"
    echo "$(L "Renew the lease: sudo ipconfig set $ifc DHCP   (or toggle Wi-Fi off and on)" "重新获取地址: sudo ipconfig set $ifc DHCP   (或关闭再打开 Wi-Fi)")"; return 1
  fi
  case "$ip" in
    169.254.*)
      bad "$(L "$ifc has a self-assigned address $ip: the DHCP server did not answer, so the Mac gave itself one" "$ifc 的地址 $ip 是系统自己分配的: DHCP 服务器没有应答")"
      echo "$(L "Next steps:" "建议下一步:")"
      echo "  - sudo ipconfig set $ifc DHCP   # $(L "renew the lease" "重新获取地址")"
      echo "  - $(L "Turn Wi-Fi off and on (or re-plug the cable), then run this again" "关闭再打开 Wi-Fi (或重新插拔网线), 然后再跑一次")"
      echo "  - $(L "Restart the router; check that its DHCP pool is not full" "重启路由器; 检查路由器的 DHCP 地址池是否已满")"
      return 1;;
  esac
  ok "IPv4  $ip"
  pkt=$(ipconfig getpacket "$ifc" 2>/dev/null)
  if ! echo "$pkt" | grep -q BOOTREPLY; then
    warn "$(L "No DHCP lease on $ifc: the address is set manually, or comes from a VPN / another source" "$ifc 上没有 DHCP 租约: 地址是手动设置的, 或来自 VPN / 其他来源")"; return 0
  fi
  srv=$(echo "$pkt" | sed -n 's/^server_identifier (ip): //p' | head -1)
  mask=$(echo "$pkt" | sed -n 's/^subnet_mask (ip): //p' | head -1)
  rtr=$(echo "$pkt" | sed -n 's/^router (ip_mult): {\(.*\)}/\1/p' | head -1)
  dns=$(echo "$pkt" | sed -n 's/^domain_name_server (ip_mult): {\(.*\)}/\1/p' | head -1)
  dom=$(echo "$pkt" | sed -n 's/^domain_name (string): //p' | head -1)
  lease=$(echo "$pkt" | sed -n 's/^lease_time (uint32): //p' | head -1)
  printf '  %-14s %s\n' "$(L "DHCP server" "DHCP 服务器")" "${srv:--}"
  printf '  %-14s %s\n' "$(L "Subnet mask" "子网掩码")" "${mask:--}"
  printf '  %-14s %s\n' "$(L "Router" "路由器")" "${rtr:--}"
  printf '  %-14s %s\n' "DNS" "${dns:--}"
  [ -n "$dom" ] && printf '  %-14s %s\n' "$(L "Search domain" "搜索域")" "$dom"
  if [ -n "$lease" ]; then
    ls=$((lease)) 2>/dev/null || ls=""
    if [ -n "$ls" ] && [ "$ls" -gt 0 ]; then
      if [ "$ls" -ge 3600 ]; then printf '  %-14s %s\n' "$(L "Lease time" "租期")" "$((ls/3600)) $(L "h" "小时") $((ls%3600/60)) $(L "min" "分钟")"
      else printf '  %-14s %s\n' "$(L "Lease time" "租期")" "$((ls/60)) $(L "min" "分钟")"; fi
      [ "$ls" -lt 600 ] && warn "$(L "Very short lease ($((ls/60)) min): the router renews addresses constantly, which can cause brief drops" "租期很短 ($((ls/60)) 分钟): 路由器频繁更换地址, 可能造成短暂掉线")"
    fi
  fi
  # 默认网关与 DHCP 下发的路由器不一致 → 可能被 VPN 或其他网络服务改了默认路由
  gw=$(gateway)
  if [ -n "$gw" ] && [ -n "$rtr" ]; then
    case ", $rtr, " in *", $gw, "*|*" $gw "*|*"{$gw}"*) ok "$(L "The default gateway matches the router the DHCP server offered" "默认网关与 DHCP 下发的路由器一致")";;
      *) warn "$(L "The default gateway ($gw) is not the router the DHCP server offered ($rtr): a VPN or another network service changed the default route" "默认网关 ($gw) 不是 DHCP 下发的路由器 ($rtr): 可能被 VPN 或其他网络服务改了默认路由")";; esac
  fi
  return 0
}

# MAC 地址 -> 厂商。系统没有自带 OUI 库, 所以按顺序找: ~/.netdoctor/oui.txt、nmap、Wireshark 的库 (格式: 前 6 位十六进制 + 空格/制表符 + 厂商名)。
# 都没有时只能识别"随机 MAC" (第一个字节的 0x02 位: iPhone / Android 的"私有 Wi-Fi 地址"), 不会瞎猜厂商。
oui_file() {
  local f
  for f in "$HOME/.netdoctor/oui.txt" /usr/local/share/nmap/nmap-mac-prefixes /opt/homebrew/share/nmap/nmap-mac-prefixes /usr/share/nmap/nmap-mac-prefixes; do
    [ -r "$f" ] && { echo "$f"; return; }
  done
}
mac_vendor() {   # $1=MAC (aa:bb:cc:...), $2=OUI 文件 (可空)
  local mac=$1 f=$2 first p
  case "$mac" in ""|"?"|"-") return;; esac
  case "${mac%%:*}" in *[!0-9A-Fa-f]*|"") return;; esac
  first=$((16#${mac%%:*}))
  # 第一个字节的 0x02 位 = 本地管理地址: 手机的"私有 Wi-Fi 地址"是随机生成的, 虚拟机 / 容器网卡也这样, 没有厂商可查
  if [ $(( first & 2 )) -ne 0 ]; then L "random / virtual MAC (locally administered)" "随机 / 虚拟 MAC (本地管理地址)"; return; fi
  [ -n "$f" ] || return
  p=$(printf '%s' "$mac" | tr 'a-f' 'A-F' | awk -F: '{printf "%s%s%s", (length($1)==1?"0"$1:$1), (length($2)==1?"0"$2:$2), (length($3)==1?"0"$3:$3)}')
  awk -v p="$p" 'toupper(substr($1,1,6))==p { $1=""; sub(/^[ \t]+/,""); print; exit }' "$f" 2>/dev/null
}

cmd_lan() {
  local ifc ip m mask ipi net size i addr n=0 popt gw selfmac found tmp unk=0 t
  ifc=$(default_if); gw=$(gateway)
  if [ -z "$ifc" ]; then bad "$(L "No default route (not connected?)" "没有默认路由 (未联网?)")"; return 1; fi
  ip=$(ipconfig getifaddr "$ifc" 2>/dev/null); [ -z "$ip" ] && ip=$(ifconfig "$ifc" 2>/dev/null | awk '/inet /{print $2; exit}')
  m=$(ifconfig "$ifc" 2>/dev/null | awk '/inet /{print $4; exit}')
  if [ -z "$ip" ] || [ -z "$m" ]; then bad "$(L "Cannot read the IPv4 address of $ifc" "无法读取 $ifc 的 IPv4 地址")"; return 1; fi
  case "$m" in 0x*) mask=$((16#${m#0x}));; *) mask=$(ip2int "$m");; esac
  ipi=$(ip2int "$ip"); net=$(( ipi & mask )); size=$(( (~mask) & 0xffffffff ))
  if [ "$size" -gt 1023 ]; then   # 大于 /22 的网段只扫本机所在的 /24, 避免扫描过久
    warn "$(L "Subnet is larger than /22; scanning only this Mac's /24" "子网大于 /22, 仅扫描本机所在的 /24")"
    net=$(( ipi & 0xffffff00 )); size=255
  fi
  selfmac=$(ifconfig "$ifc" 2>/dev/null | awk '/ether /{print $2; exit}')
  # 没有"本地网络"权限的进程 (网页 / App 里运行) 读到的是占位 MAC 02:00:00:00:00:00, 不是真的
  [ "$selfmac" = "02:00:00:00:00:00" ] && { selfmac="?"; unk=1; }
  hdr "$(L "Devices on the local network" "局域网设备") ($(int2ip $((net+1))) - $(int2ip $((net+size-1))))"
  echo "$(L "Scanning $((size-1)) addresses on $ifc …" "正在扫描 $ifc 上的 $((size-1)) 个地址 …")"
  popt="-W 1"; [ "$(uname)" = Darwin ] && popt="-t 1"
  tmp=$(mktemp -t netdoctor-lan)
  for ((i=1; i<size; i++)); do
    addr=$(int2ip $((net+i))); [ "$addr" = "$ip" ] && continue
    ( ping -c 1 $popt "$addr" >/dev/null 2>&1 && echo "$addr" >>"$tmp" ) &
    n=$((n+1)); [ $((n % 64)) -eq 0 ] && wait
  done
  wait
  # ARP 表 + 有应答的主机 (整表读不到时, 逐个按 IP 查询; 仍读不到 MAC 则显示 ?)
  local rows; rows=$(arp -a -i "$ifc" 2>/dev/null | awk '/ at /')
  for t in $(sort -u "$tmp" 2>/dev/null); do
    echo "$rows" | grep -q "($t)" && continue
    line=$(arp -n "$t" 2>/dev/null | grep " on $ifc " | head -1)
    [ -z "$line" ] && { line="? ($t) at ? on $ifc"; unk=1; }
    rows="$rows
$line"
  done
  rm -f "$tmp"
  found=$(echo "$rows" | awk '
      { if (!match($0, /\([0-9.]+\)/)) next
        a=substr($0, RSTART+1, RLENGTH-2); name=substr($0, 1, RSTART-2); sub(/ .*/, "", name)
        if (!match($0, / at [^ ]+/)) next
        mac=substr($0, RSTART+4, RLENGTH-4)
        if (mac=="(incomplete)" || mac ~ /ff:ff:ff:ff:ff:ff/ || a ~ /^(224|239)\./ || a ~ /\.255$/) next
        if (mac!="?") { k=split(mac,o,":"); mac=""; for(j=1;j<=k;j++){ if(length(o[j])==1) o[j]="0" o[j]; mac=mac (j>1?":":"") o[j] } }
        if (name=="" || name=="?") name="-"
        if (!(a in nm) || (nm[a]=="-" && name!="-")) { nm[a]=name; mc[a]=mac } }
      END { for (a in nm) print a, mc[a], nm[a] }' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n)
  local ouif; ouif=$(oui_file)
  # 没有名字的设备: 向网关 (路由器自带的 DNS) 做一次反向解析, 并行, 每个最多等 1 秒
  local rdir; rdir=$(mktemp -d -t netdoctor-rdns)
  if has dig; then
    while read -r a2 mac name; do
      [ -z "$a2" ] || [ "$name" != "-" ] && continue
      ( dig +short +time=1 +tries=1 -x "$a2" ${gw:+@"$gw"} 2>/dev/null | head -1 | sed 's/\.$//' >"$rdir/$a2" ) &
    done <<EOF3
$found
EOF3
    wait
  fi
  printf '  %-16s %-18s %-28s %s\n' "IP" "MAC" "$(L "Name" "名称")" "$(L "Vendor" "厂商")"
  local cnt=0 line tag vend rn
  while read -r a2 mac name; do
    [ -z "$a2" ] || [ "$a2" = "$ip" ] && continue
    case "$(int2ip $(( $(ip2int "$a2") & mask )))" in "$(int2ip $net)") ;; *) continue;; esac
    if [ "$name" = "-" ] && [ -s "$rdir/$a2" ]; then rn=$(head -1 "$rdir/$a2"); case "$rn" in *\ *|"") ;; *) name=$rn;; esac; fi
    tag=""; [ "$a2" = "$gw" ] && tag="$(L "(gateway)" "(网关)") "
    vend=$(mac_vendor "$mac" "$ouif")
    printf '  %-16s %-18s %-28s %s%s\n' "$a2" "$mac" "${name:0:28}" "$tag" "$vend"; cnt=$((cnt+1))
  done <<EOF2
$found
EOF2
  rm -rf "$rdir"
  printf '  %-16s %-18s %-28s %s\n' "$ip" "${selfmac:--}" "-" "$(L "(this Mac)" "(本机)")"
  ok "$(L "$((cnt+1)) devices (including this Mac)" "共 $((cnt+1)) 台设备 (含本机)")"
  [ "$unk" = 1 ] && warn "$(L "Some MAC addresses could not be read. If this runs inside the app or web UI, allow it under System Settings → Privacy & Security → Local Network, or run netdoctor lan in Terminal." "部分设备的 MAC 无法读取。若在 App/网页中运行, 请在 系统设置 → 隐私与安全性 → 本地网络 中允许, 或直接在终端运行 netdoctor lan。")"
  [ -z "$ouif" ] && echo "$(L "No vendor database found: only random / virtual MACs are labelled. Put an OUI list in ~/.netdoctor/oui.txt (or install nmap) to see vendors." "没有找到厂商库: 只能标出随机 / 虚拟 MAC。把 OUI 列表放到 ~/.netdoctor/oui.txt (或安装 nmap) 即可显示厂商。")"
  echo "$(L "Devices that block ping may be missing; the ARP table only lists hosts that answered recently." "屏蔽 ping 的设备可能不会出现; ARP 表只包含近期有应答的主机。")"
}

ping_stats() { # $1 = host, $2 = count -> prints "loss avg" (avg empty if nothing answered)
  local out; out=$(ping -c "${2:-3}" -t 3 "$1" 2>/dev/null)
  printf '%s %s\n' "$(echo "$out" | awk -F', ' '/packet loss/{for(i=1;i<=NF;i++) if($i ~ /packet loss/){sub(/%.*/,"",$i); print $i}}')" \
                    "$(echo "$out" | awk -F'/' '/min\/avg\/max/{print $5}')"
}
resolves() { # $1 = name, $2 = optional DNS server
  if has dig; then dig ${2:+@$2} +short +time=3 +tries=1 "$1" 2>/dev/null | grep -q .
  else dscacheutil -q host -a name "$1" 2>/dev/null | grep -q ip_address; fi
}

skipped() { printf '[ -- ] %s\n' "$(L "$1/6 $2: skipped (an earlier step failed)" "$1/6 $3: 已跳过 (前面的步骤失败)")"; }

cmd_doctor() {
  local ifc gw verdict="" l avg ip_ok="" ip dns_ok dns_pub http_ok="" code u px vpn steps="" detail
  local FAILS=0 WARNS=0 skew=""
  hdr "$(L "Diagnosis" "智能诊断")"
  # 1. link
  ifc=$(default_if); gw=$(gateway)
  local sa; sa=$(self_assigned_if)
  if [ -n "$sa" ] && { [ -z "$ifc" ] || [ "$sa" = "$ifc" ]; }; then
    bad "$(L "1/6 Link: $sa has a self-assigned 169.254.x.x address (the DHCP server did not answer)" "1/6 链路: $sa 只有自分配的 169.254.x.x 地址 (DHCP 服务器没有应答)")"; FAILS=$((FAILS+1)); verdict=dhcp; ifc=${ifc:-$sa}
  elif [ -z "$ifc" ]; then
    bad "$(L "1/6 Link: no default route (not connected)" "1/6 链路: 没有默认路由 (未联网)")"; FAILS=$((FAILS+1)); verdict=link
  else ok "$(L "1/6 Link: $ifc is the default interface" "1/6 链路: 默认网卡为 $ifc")"; fi
  # 2. gateway
  if [ -z "$verdict" ] && [ -n "$gw" ]; then
    set -- $(ping_stats "$gw" 3); l=${1:-100}; avg=${2:-}
    if [ -z "$avg" ]; then
      # 有些路由器禁 ping。先探测外网: 只要外网 IP 通, 就不是链路故障, 只提示网关不回应 ping
      for ip in 1.1.1.1 223.5.5.5 8.8.8.8; do set -- $(ping_stats "$ip" 1); [ -n "${2:-}" ] && { ip_ok=$ip; break; }; done
      if [ -n "$ip_ok" ]; then
        warn "$(L "2/6 Gateway $gw: does not answer ping, but the internet is reachable (the router probably blocks ICMP)" "2/6 网关 $gw: 不回应 ping, 但外网可达 (路由器可能禁了 ICMP)")"; WARNS=$((WARNS+1)); ip_ok=""
      else
        bad "$(L "2/6 Gateway $gw: no reply (Wi-Fi / cable / router)" "2/6 网关 $gw: 无应答 (Wi-Fi / 网线 / 路由器)")"; FAILS=$((FAILS+1)); verdict=gateway
      fi
    elif [ "${l%.*}" -gt 0 ]; then warn "$(L "2/6 Gateway $gw: ${l}% packet loss (avg $avg ms)" "2/6 网关 $gw: 丢包 ${l}% (平均 $avg ms)")"; WARNS=$((WARNS+1)); verdict=${verdict:-unstable}
    else ok "$(L "2/6 Gateway $gw: reachable (avg $avg ms)" "2/6 网关 $gw: 可达 (平均 $avg ms)")"; fi
  elif [ -z "$verdict" ]; then warn "$(L "2/6 Gateway: none reported (VPN-only or unusual setup); skipped" "2/6 网关: 未取得 (仅 VPN 或特殊配置); 已跳过")"
  else skipped 2 Gateway 网关; fi
  # 3. internet by IP
  if [ "$verdict" != link ] && [ "$verdict" != dhcp ] && [ "$verdict" != gateway ]; then
    for ip in 1.1.1.1 223.5.5.5 8.8.8.8; do
      set -- $(ping_stats "$ip" 3); l=${1:-100}; avg=${2:-}
      if [ -n "$avg" ]; then ip_ok=$ip; break; fi
    done
    if [ -z "$ip_ok" ]; then bad "$(L "3/6 Internet (by IP): 1.1.1.1 / 223.5.5.5 / 8.8.8.8 all unreachable" "3/6 外网 (按 IP): 1.1.1.1 / 223.5.5.5 / 8.8.8.8 均不通")"; FAILS=$((FAILS+1)); verdict=internet
    elif [ "${l%.*}" -gt 0 ] || [ "${avg%.*}" -gt 150 ]; then warn "$(L "3/6 Internet (by IP): $ip_ok answers but is unstable (${l}% loss, avg $avg ms)" "3/6 外网 (按 IP): $ip_ok 可达但不稳定 (丢包 ${l}%, 平均 $avg ms)")"; WARNS=$((WARNS+1)); verdict=${verdict:-unstable}
    else ok "$(L "3/6 Internet (by IP): $ip_ok reachable (avg $avg ms)" "3/6 外网 (按 IP): $ip_ok 可达 (平均 $avg ms)")"; fi
  else skipped 3 "Internet (by IP)" "外网 (按 IP)"; fi
  # 4. DNS
  if [ "$verdict" != link ] && [ "$verdict" != dhcp ] && [ "$verdict" != gateway ] && [ "$verdict" != internet ]; then
    dns_ok=""; for u in apple.com baidu.com; do resolves "$u" && dns_ok=1; done
    if [ -n "$dns_ok" ]; then ok "$(L "4/6 DNS: the system resolver works" "4/6 DNS: 系统解析正常")"
    else
      dns_pub=""; resolves apple.com 1.1.1.1 && dns_pub=1; [ -z "$dns_pub" ] && resolves baidu.com 223.5.5.5 && dns_pub=1
      if [ -n "$dns_pub" ]; then bad "$(L "4/6 DNS: the system resolver fails, public DNS works" "4/6 DNS: 系统解析失败, 公共 DNS 正常")"; verdict=dns
      else bad "$(L "4/6 DNS: both the system and public resolvers fail" "4/6 DNS: 系统与公共解析均失败")"; verdict=dns_all; fi
      FAILS=$((FAILS+1))
    fi
  else skipped 4 DNS DNS; fi
  # 5. HTTP
  if [ -z "$verdict" ] || [ "$verdict" = unstable ]; then
    for u in https://www.apple.com https://www.baidu.com https://www.cloudflare.com; do
      code=$(curl -s -o /dev/null -m 8 -w '%{http_code}' "$u" 2>/dev/null)
      case "$code" in 2*|3*) http_ok=$u; break;; esac
    done
    if [ -n "$http_ok" ]; then ok "$(L "5/6 HTTPS: $http_ok answers" "5/6 HTTPS: $http_ok 可访问")"
    else
      # HTTPS 打不开: 先分辨是不是强制门户 (登录页), 再看是不是本机时钟错得离谱 (证书会校验失败), 都不是才是泛泛的 http
      FAILS=$((FAILS+1)); captive_probe; skew=""
      if [ "$CAP_STATE" = portal ]; then
        bad "$(L "5/6 HTTPS: no test site answers, and plain HTTP returns a login / redirect page (captive portal)" "5/6 HTTPS: 测试站点都打不开, 而且普通 HTTP 返回的是登录 / 跳转页 (强制门户)")"; verdict=captive
      else
        skew=$(clock_skew)
        if [ -n "$skew" ] && [ "${skew#-}" -gt 300 ]; then
          bad "$(L "5/6 HTTPS: no test site answers, and this Mac's clock is off by about $(human_secs "$skew")" "5/6 HTTPS: 测试站点都打不开, 而且这台 Mac 的时钟偏差约 $(human_secs "$skew")")"; verdict=clock
        else
          bad "$(L "5/6 HTTPS: no test site answers although DNS and IP work" "5/6 HTTPS: DNS 与 IP 均正常, 但测试站点都打不开")"; verdict=http
        fi
      fi
    fi
  else skipped 5 HTTPS HTTPS; fi
  # 6. proxy / VPN (informational)
  px=$(scutil --proxy 2>/dev/null | awk '/HTTPEnable : 1|HTTPSEnable : 1|SOCKSEnable : 1/{n++} END{print n+0}')
  vpn=$(ifconfig 2>/dev/null | awk '/^[a-z0-9]+:/{n=$1; sub(":","",n)} /inet /{if (n ~ /^(utun|ppp|ipsec|tun|tap)/) printf "%s ", n}')
  if [ "$px" -gt 0 ] || [ -n "$vpn" ]; then
    detail=""; [ "$px" -gt 0 ] && detail="$(L "$px proxy setting(s) enabled" "已启用 $px 项代理")"
    [ -n "$vpn" ] && detail="${detail:+$detail; }$(L "tunnels: $vpn" "隧道: $vpn")"
    warn "$(L "6/6 Proxy / VPN: $detail (these can change what you see)" "6/6 代理 / VPN: $detail (可能影响判断)")"; WARNS=$((WARNS+1))
  else ok "$(L "6/6 Proxy / VPN: none active" "6/6 代理 / VPN: 未启用")"; fi

  hdr "$(L "Verdict" "结论")"
  case "$verdict" in
    link)     bad "$(L "You are not connected to any network." "当前没有连接任何网络。")"
              steps="netdoctor wifi|$(L "Check that Wi-Fi is on and joined, or the cable is plugged in" "检查 Wi-Fi 是否已开启并连接, 或网线是否插好")";;
    dhcp)     bad "$(L "The Mac did not get an IP address from the router (DHCP failed), so it gave itself a 169.254.x.x address." "这台 Mac 没有从路由器拿到 IP 地址 (DHCP 失败), 只能给自己分配 169.254.x.x 地址。")"
              steps="netdoctor dhcp|$(L "See the details" "查看详情")
sudo ipconfig set $ifc DHCP|$(L "Renew the lease" "重新获取地址")
-|$(L "Turn Wi-Fi off and on, or re-plug the cable" "关闭再打开 Wi-Fi, 或重新插拔网线")
-|$(L "Restart the router; check that its DHCP address pool is not full" "重启路由器; 检查路由器的 DHCP 地址池是否已满")";;
    gateway)  bad "$(L "The link to your router is broken or very weak." "到路由器的链路不通或很弱。")"
              steps="netdoctor wifi|$(L "Check the signal strength; move closer to the router" "查看信号强度, 靠近路由器")
netdoctor lan|$(L "See whether other devices are reachable" "看看其他设备是否可达")
-|$(L "Restart the router and re-join the network" "重启路由器并重新连接")";;
    internet) bad "$(L "The router answers but there is no internet (ISP or upstream problem)." "路由器正常, 但无法访问外网 (运营商或上游问题)。")"
              steps="netdoctor route 1.1.1.1|$(L "See where the path stops" "看路径在哪一跳中断")
-|$(L "Restart the modem / router; if it persists, contact your ISP" "重启光猫 / 路由器, 仍不行请联系运营商")";;
    dns|dns_all) bad "$(L "DNS resolution is the problem: the internet works by IP." "问题出在 DNS 解析: 按 IP 访问外网是正常的。")"
              steps="netdoctor dnsbench|$(L "Find a faster, working DNS server" "找出更快且可用的 DNS 服务器")
netdoctor fixdns|$(L "Flush the DNS cache" "刷新 DNS 缓存")
netdoctor dns apple.com|$(L "Compare what each server answers" "对比各 DNS 服务器的应答")";;
    captive)  bad "$(L "A captive portal (a Wi-Fi login page) is blocking web access." "被强制门户 (Wi-Fi 登录页) 拦住了, 网页打不开。")"
              steps="netdoctor captive|$(L "Show the login page address" "查看登录页地址")
-|$(L "Open http://captive.apple.com in a browser and sign in to the Wi-Fi" "用浏览器打开 http://captive.apple.com, 登录这个 Wi-Fi")";;
    clock)    bad "$(L "This Mac's clock is wrong by about $(human_secs "$skew"), so HTTPS certificates fail to validate." "这台 Mac 的时钟偏差约 $(human_secs "$skew"), 导致 HTTPS 证书校验失败。")"
              steps="-|$(L "System Settings → General → Date & Time: turn on Set time and date automatically" "系统设置 → 通用 → 日期与时间: 打开“自动设置时间和日期”")
sudo sntp -sS time.apple.com|$(L "Or sync the clock right now from a terminal" "或在终端里立刻同步时间")
netdoctor http https://www.apple.com|$(L "Then check HTTPS again" "然后再确认 HTTPS")";;
    http)     bad "$(L "IP and DNS work, but web access fails (proxy, firewall, captive portal or TLS interception)." "IP 与 DNS 正常, 但网页访问失败 (代理、防火墙、认证网关或 TLS 拦截)。")"
              steps="netdoctor proxy|$(L "Check proxy and VPN settings" "检查代理和 VPN 设置")
netdoctor http https://www.apple.com|$(L "See which phase fails" "看是哪个阶段失败")
netdoctor tls www.apple.com|$(L "Check for a replaced certificate" "检查证书是否被替换")";;
    unstable) warn "$(L "Connectivity works but is unstable (packet loss or high latency)." "网络可用, 但不稳定 (丢包或延迟高)。")"
              steps="netdoctor wifi|$(L "Check the Wi-Fi signal and noise" "检查 Wi-Fi 信号和噪声")
netdoctor route 1.1.1.1|$(L "Find the lossy hop" "找出丢包的那一跳")
netdoctor mtu|$(L "Rule out MTU problems (VPN)" "排除 MTU 问题 (VPN)")";;
    *)        ok "$(L "Everything looks healthy." "一切正常。")";;
  esac
  if [ -n "$steps" ]; then
    echo "$(L "Next steps:" "建议下一步:")"
    printf '%s\n' "$steps" | while IFS='|' read -r cmd why; do
      if [ "$cmd" = "-" ]; then echo "  - $why"; else echo "  - $cmd   # $why"; fi
    done
  fi
  [ "$FAILS" -eq 0 ] && [ "$verdict" != unstable ]
}

cmd_tcpping() {
  local h=${1:-} p=${2:-} n=${3:-10} line seq ms sent okc min avg max loss
  if [ -z "$h" ] || [ -z "$p" ]; then echo "$(L "Usage: netdoctor tcpping <host> <port> [count]" "用法: netdoctor tcpping <主机> <端口> [次数]")"; return 1; fi
  case "$h" in *[!A-Za-z0-9._:-]*|-*) bad "$(L "Invalid host: $h" "主机无效: $h")"; return 1;; esac
  case "$p$n" in *[!0-9]*|"") bad "$(L "Port and count must be numbers" "端口和次数必须是数字")"; return 1;; esac
  if [ "$((10#$p))" -lt 1 ] || [ "$((10#$p))" -gt 65535 ] || [ "$((10#$n))" -lt 1 ] || [ "$((10#$n))" -gt 100 ]; then bad "$(L "Port must be 1-65535 and count 1-100" "端口范围 1-65535, 次数范围 1-100")"; return 1; fi
  has perl || { bad "$(L "perl not found" "未找到 perl")"; return 1; }
  hdr "$(L "TCP connect latency to $h:$p" "到 $h:$p 的 TCP 连接延迟")"
  # 注意: 不用 IO::Socket::INET 的 Timeout (非阻塞 connect), 它在 macOS 上会把 "连接被拒绝" 误判为成功
  perl -MSocket=:DEFAULT,getaddrinfo -MTime::HiRes=time,sleep,alarm -e '
    $| = 1; my ($h, $p, $n) = @ARGV; my ($ok, $sum, $min, $max) = (0, 0, 1e9, 0);
    my ($err, @res) = getaddrinfo($h, $p, { socktype => SOCK_STREAM });
    for my $i (1 .. $n) {
      my $t = time; my $good = 0;
      if (!$err && @res) {
        my $r = $res[0];
        if (socket(my $s, $r->{family}, SOCK_STREAM, 0)) {
          eval { local $SIG{ALRM} = sub { die "timeout\n" }; alarm(2); $good = connect($s, $r->{addr}) ? 1 : 0; alarm(0); 1 } or do { alarm(0); $good = 0 };
          close $s;
        }
      }
      my $ms = (time - $t) * 1000;
      if ($good) { $ok++; $sum += $ms; $min = $ms if $ms < $min; $max = $ms if $ms > $max; printf "OK %d %.1f\n", $i, $ms }
      else { printf "FAIL %d\n", $i }
      sleep(0.4) if $i < $n;
    }
    printf "STATS %d %d %.1f %.1f %.1f\n", $n, $ok, ($ok ? $min : 0), ($ok ? $sum / $ok : 0), ($ok ? $max : 0);
  ' "$h" "$p" "$n" | { rc=1; while read -r line; do
    set -- $line
    case "$1" in
      OK)   echo "  #$2  $3 ms";;
      FAIL) echo "  #$2  $(L "failed (refused or timed out)" "失败 (被拒绝或超时)")";;
      STATS) sent=$2; okc=$3
             if [ "$okc" -eq 0 ]; then rc=1; bad "$(L "$sent sent, none connected" "发送 $sent 次, 全部失败")"
             else rc=0; loss=$(( (sent - okc) * 100 / sent ))
                  ok "$(L "$sent sent, $okc connected (${loss}% loss), min/avg/max = $4/$5/$6 ms" "发送 $sent 次, 成功 $okc 次 (丢包 ${loss}%), 最小/平均/最大 = $4/$5/$6 ms")"; fi;;
    esac
  done; exit "$rc"; }
}

cmd_ipv6() {
  hdr "$(L "IPv6 addresses" "IPv6 地址")"
  # 排除链路本地 (fe80) 与唯一本地/私有 (fc00::/7), 它们不能访问公网
  local g; g=$(ifconfig | awk '/inet6 / && $2 !~ /^fe80|^::1|^f[cd]/{print $2}' | head -3)
  if [ -n "$g" ]; then ok "$(L "Global IPv6 address present" "存在全局 IPv6 地址")"; echo "$g" | sed 's/^/   /'
  else warn "$(L "No global IPv6 address, only link-local/private ones (IPv6-only sites will be unreachable; usually harmless)" "没有全局 IPv6 地址, 只有本地/私有地址 (仅 IPv6 的站点打不开; 通常无碍)")"; fi
  hdr "$(L "DNS AAAA records" "DNS AAAA 记录")"
  local a6; a6=$(dig +short +time=3 +tries=1 AAAA www.google.com 2>/dev/null | head -1)
  if [ -n "$a6" ]; then ok "www.google.com → $a6"; else warn "$(L "No AAAA answer for www.google.com" "www.google.com 没有 AAAA 应答")"; fi
  hdr "$(L "Reachability: IPv4 vs IPv6" "连通性: IPv4 vs IPv6")"
  local v4 v6 u=https://api.ip.sb/ip
  v4=$(curl -4 -s -m 6 "$u" 2>/dev/null); v6=$(curl -6 -s -m 6 "$u" 2>/dev/null)
  if [ -n "$v4" ]; then ok "IPv4  $v4"; else bad "$(L "IPv4 request failed" "IPv4 请求失败")"; fi
  if [ -n "$v6" ]; then ok "IPv6  $v6"; else warn "$(L "IPv6 request failed" "IPv6 请求失败")"; fi
  if [ -n "$g" ] && [ -z "$v6" ]; then
    echo "$(L "Verdict: an IPv6 address is assigned but traffic fails → broken IPv6 path; this makes some sites load slowly. Try turning IPv6 off for this service (networksetup -setv6off <service>) or fix the router." "判读: 有 IPv6 地址但无法通信 → IPv6 链路异常, 会让部分网站变慢。可对该网络服务关闭 IPv6 (networksetup -setv6off <服务名>) 或检查路由器。")"
  elif [ -z "$v4" ] && [ -n "$v6" ]; then
    echo "$(L "Verdict: IPv6-only connectivity." "判读: 仅有 IPv6 连通。")"
  fi
  return 0
}

# 强制门户探测。结果放在全局变量 CAP_STATE (ok | portal | offline) 和 CAP_REDIR (登录页地址),
# 不用 $(...) 返回, 因为子 shell 会丢掉变量。cmd_captive 和 doctor 共用。
captive_probe() {
  local u=http://captive.apple.com/hotspot-detect.html body
  CAP_STATE=offline; CAP_REDIR=""
  body=$(curl -s -m 8 "$u" 2>/dev/null); CAP_REDIR=$(curl -s -m 8 -o /dev/null -w '%{redirect_url}' "$u" 2>/dev/null)
  [ -z "$body" ] && [ -z "$CAP_REDIR" ] && return 0
  # Apple 的应答是 <HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>; 只认它, 不能是页面里随便出现 "Success" 字样
  if echo "$body" | grep -qi '<title>Success</title>' && [ -z "$CAP_REDIR" ]; then CAP_STATE=ok; else CAP_STATE=portal; fi
}

# 本机时钟与服务器时间的差 (秒, 本机减服务器; 取不到时输出为空)。用 HTTP 响应的 Date 头, 不依赖 NTP 端口。
# 必须用动态站点: captive.apple.com 是缓存一年的静态页, 它的 Date 是缓存生成时间 (可能落后好几个小时);
# 有 Age 头时把它加上。用明文 HTTP (时钟错时 HTTPS 会因证书失败, 而这里只需要读时间)
clock_skew() {
  local u h d age srv now
  for u in http://www.apple.com http://www.baidu.com http://www.cloudflare.com; do
    h=$(curl -sI -m 6 "$u" 2>/dev/null | tr -d '\r')
    d=$(echo "$h" | awk -F': ' 'tolower($1)=="date"{print $2; exit}')
    [ -z "$d" ] && continue
    age=$(echo "$h" | awk -F': ' 'tolower($1)=="age"{print $2; exit}'); age=${age//[^0-9]/}
    srv=$(LC_ALL=C date -u -j -f '%a, %d %b %Y %H:%M:%S GMT' "$d" +%s 2>/dev/null) || continue
    now=$(date +%s); echo $((now - srv - ${age:-0})); return 0
  done
}

human_secs() { # 把秒数 (取绝对值) 写成 “N 分钟 / N 小时 / N 天”
  local n=${1#-}
  if [ "$n" -ge 172800 ]; then echo "$((n/86400)) $(L "days" "天")"
  elif [ "$n" -ge 7200 ]; then echo "$((n/3600)) $(L "hours" "小时")"
  else echo "$((n/60)) $(L "minutes" "分钟")"; fi
}

cmd_captive() {
  hdr "$(L "Captive portal check" "强制门户检测")"
  captive_probe
  case "$CAP_STATE" in
    offline) bad "$(L "Could not reach captive.apple.com (no connectivity?)" "无法访问 captive.apple.com (没有网络?)")"; return 1;;
    ok) ok "$(L "No captive portal: direct internet access" "没有强制门户, 可直接上网")";;
    *)  warn "$(L "Captive portal suspected: got a login/redirect page instead of the expected reply" "疑似强制门户: 收到的是登录/跳转页, 而不是预期应答")"
        [ -n "$CAP_REDIR" ] && echo "   → $CAP_REDIR"
        echo "$(L "Open any http:// page (e.g. http://captive.apple.com) in a browser to reach the login page." "用浏览器打开任意 http:// 网址 (如 http://captive.apple.com) 即可进入登录页。")"
        return 1;;
  esac
}

cmd_quick() {
  hdr "$(L "Interface and gateway" "网卡与网关")"
  local ifc gw ip d u code nf=0; ifc=$(default_if); gw=$(gateway)
  if [ -z "$ifc" ]; then bad "$(L "No default route (not connected?)" "没有默认路由 (未联网?)")"; ifconfig | grep -E '^[a-z0-9]+:|inet ' ; return 1; fi
  ok "$(L "Default interface $ifc  gateway ${gw:-none}" "默认网卡 $ifc  网关 ${gw:-无}")"
  ifconfig "$ifc" | awk '/inet |inet6 |ether|status/{print "   "$0}'
  hdr "$(L "Gateway reachability" "网关连通性")"
  if [ -n "$gw" ]; then
    if ping -c 3 -t 5 "$gw" >/dev/null 2>&1; then ok "$(L "Gateway $gw reachable" "网关 $gw 可达")"
    elif ping -c 1 -t 3 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -t 3 223.5.5.5 >/dev/null 2>&1; then
      warn "$(L "Gateway $gw does not answer ping, but the internet is reachable (the router probably blocks ICMP)" "网关 $gw 不回应 ping, 但外网可达 (路由器可能禁了 ICMP)")"
    else bad "$(L "Gateway $gw unreachable (Wi-Fi / cable / router problem)" "网关 $gw 不通 (Wi-Fi/网线/路由器问题)")"; nf=$((nf+1)); fi
  fi
  hdr "$(L "Internet reachability by IP (bypassing DNS)" "外网 IP 连通性 (绕开 DNS)")"
  for ip in 1.1.1.1 8.8.8.8 223.5.5.5; do
    if ping -c 2 -t 4 "$ip" >/dev/null 2>&1; then ok "ping $ip"; else bad "ping $ip"; nf=$((nf+1)); fi
  done
  hdr "DNS"
  scutil --dns | awk '/nameserver\[/{print "   "$0}' | sort -u | head -6
  for d in apple.com baidu.com; do
    if dig +short +time=3 +tries=1 "$d" 2>/dev/null | grep -q .; then ok "$(L "Resolve $d" "解析 $d")"; else bad "$(L "Failed to resolve $d" "解析 $d 失败")"; nf=$((nf+1)); fi
  done
  hdr "HTTP/HTTPS"
  for u in https://www.apple.com https://www.baidu.com https://www.google.com; do
    code=$(curl -s -o /dev/null -m 8 -w '%{http_code} %{time_total}s' "$u" 2>/dev/null)
    case "$code" in 2*|3*) ok "$u  $code";; *) bad "$u  ${code:-$(L "timeout" "超时")}"; nf=$((nf+1));; esac
  done
  hdr "$(L "Public IP" "公网出口 IP")"
  local geo; geo=$(curl -s -m 6 https://api.ip.sb/geoip 2>/dev/null)
  if [ -z "$geo" ]; then warn "$(L "Lookup failed" "获取失败")"
  elif has jq; then echo "$geo" | jq -r '"   \(.ip)  \(.country // "") \(.isp // .organization // "")"' 2>/dev/null || echo "$geo"
  else echo "$geo"; fi
  echo
  echo "$(L "Reading: gateway down → local link; IP works but names fail → DNS; names work but HTTP fails → proxy/firewall/TLS." "判读: 网关不通→本地链路; IP通但域名失败→DNS; 域名通但HTTP失败→代理/防火墙/TLS。")"
  [ "$nf" -eq 0 ]
}

cmd_wifi() {
  local w; w=$(wifi_if); w=${w:-en0}
  hdr "Wi-Fi ($w)"
  networksetup -getairportnetwork "$w" 2>/dev/null
  if has wdutil; then
    echo "$(L "(wdutil needs sudo to show full details)" "(wdutil 需 sudo 才能看到完整信息)")"
    priv wdutil info 2>/dev/null | awk '/SSID|BSSID|RSSI|Noise|Tx Rate|Channel|PHY Mode|Security|Country/' | head -20
  fi
  hdr "$(L "system_profiler summary" "system_profiler 摘要")"
  system_profiler SPAirPortDataType 2>/dev/null | awk '/Current Network Information/{f=1} f&&/PHY Mode|Channel|Security|Signal|Transmit Rate|Country/{print} /Other Local Wi-Fi/{exit}'
  echo "$(L "Rules of thumb: RSSI > -60 good, -70 fair, < -75 poor; SNR (RSSI-Noise) should be > 25 to be stable." "经验值: RSSI > -60 好, -70 一般, < -75 差; SNR(RSSI-Noise) > 25 才稳。")"
  warn "$(L "Nearby Wi-Fi scan: Option-click the Wi-Fi menu bar icon, or use Wireless Diagnostics (Option-click the icon → Open Wireless Diagnostics)" "附近 Wi-Fi 扫描: 按住 Option 点菜单栏 Wi-Fi 图标, 或用 '无线诊断'(Option+Wi-Fi图标→打开无线诊断)")"
}

cmd_dns() {
  local d=${1:-}; [ -z "$d" ] && { echo "$(L "Usage: netdoctor dns <domain>" "用法: netdoctor dns <域名>")"; return 1; }
  case "$d" in *[!A-Za-z0-9._-]*|-*) bad "$(L "Invalid domain: $d" "域名无效: $d")"; return 1;; esac
  hdr "$(L "System resolvers (scutil --dns)" "系统解析器 (scutil --dns)")"; scutil --dns | awk '/resolver #|nameserver\[|domain|search domain|if_index/{print "  "$0}' | head -24
  hdr "$(L "System resolution (dscacheutil, the real system path)" "系统解析 (dscacheutil, 走真实系统路径)")"; dscacheutil -q host -a name "$d"
  hdr "$(L "DNS server comparison" "各 DNS 服务器对比")"
  local n_ans=0 n_nx=0 n_all=0 sys_ans=0 st
  for s in "" 1.1.1.1 8.8.8.8 223.5.5.5 119.29.29.29; do
    label=${s:-$(L "system" "系统默认")}
    out=$(dig ${s:+@$s} +tries=1 +time=3 "$d" A 2>&1)
    ans=$(echo "$out" | awk '/^[^;].*IN[ \t]+A[ \t]/{printf "%s ", $NF}')
    t=$(echo "$out" | awk '/Query time/{print $4" ms"}')
    st=$(echo "$out" | sed -n 's/.*status: \([A-Z]*\).*/\1/p' | head -1)
    n_all=$((n_all+1))
    if [ -n "$ans" ]; then n_ans=$((n_ans+1)); [ -z "$s" ] && sys_ans=1; fi
    [ "$st" = NXDOMAIN ] && n_nx=$((n_nx+1))
    printf '  %-12s %-10s %s\n' "$label" "${t:-$(L "timeout" "超时")}" "${ans:-$([ "$st" = NXDOMAIN ] && L "(NXDOMAIN: no such domain)" "(NXDOMAIN: 域名不存在)" || L "(no answer)" "(无结果)")}"
  done
  if [ "$n_nx" -ge 3 ] && [ "$n_ans" -eq 0 ]; then
    bad "$(L "$d does not exist (NXDOMAIN from most servers); check the spelling" "$d 不存在 (多数服务器返回 NXDOMAIN), 检查拼写")"; return 1
  elif [ "$n_ans" -eq 0 ]; then
    bad "$(L "No server returned an A record for $d (no network, DNS blocked, or the name has no IPv4 address)" "没有服务器返回 $d 的 A 记录 (没网、DNS 被拦截, 或该域名没有 IPv4 地址)")"; return 1
  elif [ "$sys_ans" -eq 0 ]; then
    warn "$(L "The system default DNS failed, but public servers answered: your DNS setting or ISP resolver is the problem (try: netdoctor fixdns)" "系统默认 DNS 解析失败, 但公共服务器正常: 问题在你的 DNS 设置或运营商解析器 (可试: netdoctor fixdns)")"; return 1
  else
    ok "$(L "$d resolves ($n_ans of $n_all servers answered)" "$d 解析正常 ($n_all 个服务器中 $n_ans 个有结果)")"
  fi
  echo "$(L "Tip: big differences between servers, or a failing system default → ISP hijacking or a DNS config problem; try netdoctor fixdns." "提示: 各家结果差异大/系统默认失败 → 运营商劫持或 DNS 配置问题; 可 netdoctor fixdns。")"
}

# 主机名能否被系统解析 (用 ping 的解析结果, 与系统解析器一致; IP 直接视为可解析)
cannot_resolve() {
  case "$1" in *:*) return 1;; esac   # IPv6 字面量: macOS 的 ping 只认 IPv4, 不能用它判断
  case "$1" in *[!0-9.]*) ;; *) return 1;; esac
  # 只有 AAAA (纯 IPv6) 的主机 ping 解析不了, 所以优先问系统解析器 (dscacheutil 同时返回 A / AAAA)
  if has dscacheutil; then [ -z "$(dscacheutil -q host -a name "$1" 2>/dev/null)" ]; return; fi
  ping -c 1 -t 1 "$1" 2>&1 | grep -qi 'cannot resolve\|unknown host'
}

cmd_route() {
  local h=${1:-}; [ -z "$h" ] && { echo "$(L "Usage: netdoctor route <host>" "用法: netdoctor route <主机>")"; return 1; }
  if cannot_resolve "$h"; then bad "$(L "Cannot resolve $h; check the host name or DNS (try: netdoctor dns $h)" "无法解析 $h, 检查域名或 DNS (可试: netdoctor dns $h)")"; return 1; fi
  hdr "$(L "Route selection (which interface/VPN the traffic uses)" "路由选择 (流量走哪块网卡/VPN)")"; route -n get "$h" 2>&1 | awk '/destination|gateway|interface/'
  hdr "$(L "Path" "路径")"
  if has mtr && priv mtr -rwbzc 20 "$h"; then :
  else
    has mtr && warn "$(L "mtr needs admin rights; falling back to traceroute" "mtr 需要管理员权限, 已改用 traceroute")"
    traceroute -w 2 -q 1 -m 20 "$h"
    has mtr || warn "$(L "brew install mtr gives per-hop loss statistics" "brew install mtr 可得到逐跳丢包统计")"
  fi
}

cmd_ping() { local h=${1:-}; [ -z "$h" ] && { echo "$(L "Usage: netdoctor ping <host> [count]" "用法: netdoctor ping <主机> [次数]")"; return 1; }; ping -c "${2:-20}" "$h"; }

cmd_port() {
  [ $# -lt 2 ] && { echo "$(L "Usage: netdoctor port <host> <port>" "用法: netdoctor port <主机> <端口>")"; return 1; }
  case "$2" in ''|*[!0-9]*) bad "$(L "Port must be a number between 1 and 65535" "端口必须是 1-65535 的数字")"; return 1;; esac
  if [ "$2" -lt 1 ] || [ "$2" -gt 65535 ]; then bad "$(L "Port must be a number between 1 and 65535" "端口必须是 1-65535 的数字")"; return 1; fi
  if nc -vz -G 5 "$1" "$2" 2>&1; then ok "$(L "$1:$2 open" "$1:$2 开放")"
  else bad "$(L "$1:$2 unreachable (closed / firewall / routing)" "$1:$2 不通 (关闭/防火墙/路由)")"; return 1; fi
}

cmd_http() {
  local u=${1:-}; [ -z "$u" ] && { echo "$(L "Usage: netdoctor http <URL>" "用法: netdoctor http <URL>")"; return 1; }
  local fmt
  if [ "$ZH" = 1 ]; then fmt='
  HTTP 状态      %{http_code}  (重定向 %{num_redirects} 次)
  远端 IP        %{remote_ip}:%{remote_port}
  DNS 解析       %{time_namelookup}s
  TCP 连接       %{time_connect}s
  TLS 握手完成   %{time_appconnect}s
  首字节(TTFB)   %{time_starttransfer}s
  总耗时         %{time_total}s
  下载速度       %{speed_download} B/s
'
  else fmt='
  HTTP status     %{http_code}  (%{num_redirects} redirects)
  Remote IP       %{remote_ip}:%{remote_port}
  DNS lookup      %{time_namelookup}s
  TCP connect     %{time_connect}s
  TLS handshake   %{time_appconnect}s
  First byte      %{time_starttransfer}s
  Total           %{time_total}s
  Download speed  %{speed_download} B/s
'
  fi
  local res
  if ! res=$(curl -sS -o /dev/null -L -m 30 -w "$fmt
@@%{http_code}" "$u"); then
    printf '%s\n' "${res%@@*}"
    bad "$(L "Request failed; investigate with: curl -v $u" "请求失败, 加 -v 排查: curl -v $u")"; return 1
  fi
  printf '%s\n' "${res%@@*}"
  local code=${res##*@@}
  case "$code" in
    2*) ok "$(L "HTTP $code: the server answered normally" "HTTP $code: 服务器响应正常")";;
    3*) warn "$(L "HTTP $code: still a redirect after following the limit; check the Location header" "HTTP $code: 跟随重定向后仍是跳转, 检查 Location 头")"; return 1;;
    4*) bad "$(L "HTTP $code: the network works but the server rejected the request (check the URL, login or permissions)" "HTTP $code: 网络是通的, 但服务器拒绝了请求 (检查网址、登录或权限)")"; return 1;;
    5*) bad "$(L "HTTP $code: the network works but the server has a problem (try again later or contact the site)" "HTTP $code: 网络是通的, 但服务器自身出错 (稍后重试或联系站点)")"; return 1;;
    *) warn "$(L "Unexpected HTTP status: $code" "异常的 HTTP 状态码: $code")"; return 1;;
  esac
}

# 主机名是否匹配证书里的名字 (精确匹配, 或 *.example.com 恰好匹配一级子域名)
host_matches() {
  local h n; h=$(echo "$1" | tr 'A-Z' 'a-z'); shift
  for n in "$@"; do
    n=$(echo "$n" | tr 'A-Z' 'a-z')
    case "$n" in
      \*.*) [ "$h" != "${h#*.}" ] && [ "${h#*.}" = "${n#*.}" ] && return 0;;
      *) [ "$h" = "$n" ] && return 0;;
    esac
  done
  return 1
}

cmd_tls() {
  local h=${1:-}; local p=${2:-443}; [ -z "$h" ] && { echo "$(L "Usage: netdoctor tls <host> [port]" "用法: netdoctor tls <主机> [端口]")"; return 1; }
  # s_client 默认不校验主机名 (证书是别的域名的也会显示 Verification: OK)。OpenSSL 支持 -verify_hostname;
  # 系统自带的 LibreSSL 不支持, 那种情况下下面自己比对 SAN。
  local vh="" native=0 isip=0 target="$h:$p" sni="-servername $h"
  case "$h" in
    # IPv6 字面量: 不该发 SNI; OpenSSL 的 -connect 要方括号, 系统自带的 LibreSSL 不认方括号 (直接写 ::1:443)
    *:*) isip=1; sni=""; openssl s_client -help 2>&1 | grep -q -- -verify_hostname && target="[$h]:$p";;
    *[!0-9.]*) ;;
    *) isip=1;;
  esac
  if [ "$isip" = 0 ] && openssl s_client -help 2>&1 | grep -q -- -verify_hostname; then vh="-verify_hostname $h"; native=1; fi
  local out; out=$(echo | openssl s_client -connect "$target" $sni $vh 2>&1)
  echo "$out" | grep -E 'Protocol|Cipher|Verif|verify|depth=|errno|error' | head -12
  local cert; cert=$(echo "$out" | openssl x509 2>/dev/null)
  if [ -z "$cert" ]; then bad "$(L "No certificate received ($h:$p unreachable or not a TLS service)" "未取得证书 ($h:$p 不可达或非 TLS 服务)")"; return 1; fi
  local rc=0
  echo "$out" | grep -qE 'Verification error|Verify return code: [1-9]' && rc=1
  echo "$cert" | openssl x509 -noout -subject -issuer -dates
  local san; san=$(echo "$cert" | openssl x509 -noout -text | grep -A1 'Subject Alternative Name' | sed 's/^ */SAN: /;/Subject Alternative/d')
  echo "$san"
  if [ "$native" = 0 ] && [ "$isip" = 0 ]; then
    case "$h" in *)
      local names; names=$(echo "$san" | tr ',' '\n' | sed -n 's/^[ ]*\(SAN: \)\{0,1\}DNS://p')
      [ -z "$names" ] && names=$(echo "$cert" | openssl x509 -noout -subject | sed -n 's/.*CN *= *\([^,/]*\).*/\1/p')
      # shellcheck disable=SC2086
      if ! host_matches "$h" $names; then
        bad "$(L "Hostname mismatch: the certificate is not valid for $h" "主机名不匹配: 该证书不适用于 $h")"; rc=1
      fi;;
    esac
  fi
  if has testssl; then echo "$(L "Full audit: testssl $h:$p" "完整体检: testssl $h:$p")"; fi
  return $rc
}

cmd_mtu() {
  local h=${1:-1.1.1.1} s
  case "$h" in *:*) bad "$(L "MTU probing supports IPv4 only (the system ping cannot send IPv6 with the DF bit)" "MTU 探测只支持 IPv4 (系统 ping 无法发送带 DF 位的 IPv6 包)")"; return 1;; esac
  if cannot_resolve "$h"; then bad "$(L "Cannot resolve $h; check the host name or DNS (try: netdoctor dns $h)" "无法解析 $h, 检查域名或 DNS (可试: netdoctor dns $h)")"; return 1; fi
  hdr "$(L "Path MTU probe -> $h (DF bit)" "路径 MTU 探测 -> $h (DF 位)")"
  for s in 1472 1452 1432 1412 1372 1272 1172; do
    if ping -c 1 -t 3 -D -s "$s" "$h" >/dev/null 2>&1; then
      ok "$(L "Payload $s passed → MTU ≈ $((s+28))" "载荷 $s 通过 → MTU ≈ $((s+28))")"; return; fi
    printf "  $(L "Payload %s lost" "载荷 %s 丢失")\n" "$s"
  done
  bad "$(L "All failed; the target may block ICMP" "均失败; 目标可能禁 ICMP")"; return 1
}

cmd_speed() {
  if ! has networkQuality; then
    bad "$(L "Requires macOS 12+ (networkQuality)" "需要 macOS 12+ (networkQuality)")"
    if has speedtest-cli; then speedtest-cli; else return 1; fi
    return
  fi
  # 边跑边显示 (网页 / App 里测试要 20-30 秒, 不能到最后才一次性出现), 同时留一份用来解析结论
  local tmp rc out; tmp=$(mktemp)
  networkQuality -v 2>&1 | tee "$tmp"; rc=${PIPESTATUS[0]}
  out=$(cat "$tmp"); rm -f "$tmp"
  [ "$rc" -eq 0 ] || {
    bad "$(L "networkQuality failed (often a temporary problem reaching Apple's test server; try again, or check the clock / proxy with: netdoctor doctor)" "networkQuality 执行失败 (多半是暂时连不上 Apple 的测速服务器; 请重试, 或用 netdoctor doctor 检查时钟 / 代理)")"; return 1; }
  speed_verdict "$out"
}

# 解析 networkQuality 的摘要, 给出结论: 带宽够不够、上传 / 下载时延是否因缓冲膨胀 (bufferbloat) 而飙升。
# 响应性单位是 RPM (每分钟往返次数): >= 1000 很好, 300-999 一般, < 300 差 (视频会议、游戏会卡)。
speed_verdict() {
  local t=$1 dl ul dr ur
  dl=$(printf '%s\n' "$t" | sed -n 's/^Downlink capacity: *\([0-9.]*\) Mbps.*/\1/p' | head -1)
  ul=$(printf '%s\n' "$t" | sed -n 's/^Uplink capacity: *\([0-9.]*\) Mbps.*/\1/p' | head -1)
  dr=$(printf '%s\n' "$t" | sed -n 's/^Downlink [Rr]esponsiveness:.*|  *\([0-9]*\) RPM.*/\1/p' | head -1)
  ur=$(printf '%s\n' "$t" | sed -n 's/^Uplink [Rr]esponsiveness:.*|  *\([0-9]*\) RPM.*/\1/p' | head -1)
  # 有的 macOS / 网络下只给一行总的 "Responsiveness: Medium (68 milliseconds | 879 RPM)", 不分上下行
  local fig single=""
  if [ -z "$dr$ur" ]; then
    dr=$(printf '%s\n' "$t" | sed -n 's/^Responsiveness:.*|  *\([0-9]*\) RPM.*/\1/p' | head -1)
    [ -n "$dr" ] && { ur=$dr; single=1; }
  fi
  if [ -n "$single" ]; then fig="$dr RPM"; else fig="$(L "down $dr RPM, up $ur RPM" "下载 $dr RPM, 上传 $ur RPM")"; fi
  echo
  if [ -z "$dr$ur" ]; then
    warn "$(L "Could not read the responsiveness figures, so no bufferbloat verdict (the output format may differ on this macOS)." "读不到响应性数据, 无法判断缓冲膨胀 (这个 macOS 版本的输出格式可能不同)。")"; return 0
  fi
  local worst=$dr; [ -z "$worst" ] && worst=$ur; [ -n "$ur" ] && [ "$ur" -lt "$worst" ] && worst=$ur
  if [ "$worst" -ge 1000 ]; then
    ok "$(L "Responsiveness is good ($fig): the line stays snappy under load." "响应性良好 ($fig): 满载时网络依然流畅。")"
  elif [ "$worst" -ge 300 ]; then
    warn "$(L "Responsiveness is fair ($fig): latency rises noticeably when the line is busy." "响应性一般 ($fig): 线路繁忙时延迟会明显上升。")"
  else
    local dir; dir="$(L "upload" "上传")"; [ -n "$dr" ] && [ "$dr" -lt 300 ] && dir="$(L "download" "下载")"
    [ -n "$dr" ] && [ -n "$ur" ] && [ "$dr" -lt 300 ] && [ "$ur" -lt 300 ] && dir="$(L "upload and download" "上传和下载")"
    [ -n "$single" ] && dir="$(L "network" "网络")"
    bad "$(L "Bufferbloat: latency under $dir load is very high ($fig). Video calls and games will lag while someone is uploading or downloading." "存在缓冲膨胀: $dir 满载时延迟很高 ($fig)。有人上传或下载时, 视频会议和游戏会卡。")"
    echo "$(L "  Fix: enable SQM / smart queue (fq_codel, CAKE) on the router, or cap its speed at about 90% of the figures above." "  办法: 在路由器上启用 SQM / 智能队列 (fq_codel、CAKE), 或把路由器限速设为上面带宽的约 90%。")"
  fi
  if [ -n "$ul" ] && [ -n "$dl" ]; then
    awk -v u="$ul" -v d="$dl" 'BEGIN{ if (u < 5) exit 0; exit 1 }' && warn "$(L "Upload bandwidth is only $ul Mbps: video calls and cloud uploads will be slow." "上传带宽只有 $ul Mbps: 视频会议和云端上传会比较慢。")"
  fi
  return 0
}

cmd_conns() {
  # 没有管理员权限 (无终端且 sudo 无缓存) 时降级为普通权限的 lsof: 只能看到当前用户自己的进程
  local P=priv
  if ! can_priv; then
    P=""; warn "$(L "No administrator rights: only your own processes are listed (run sudo netdoctor conns for all)" "没有管理员权限: 只列出当前用户自己的进程 (用 sudo netdoctor conns 查看全部)")"
  fi
  hdr "$(L "Listening ports" "监听端口")"; $P lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | head -40
  hdr "$(L "Established connections" "已建立连接")"; $P lsof -nP -iTCP -sTCP:ESTABLISHED 2>/dev/null | head -40
  if has nettop; then echo "$(L "Live per-process traffic: nettop -P -d    |   bandwhich (needs sudo)" "实时按进程流量: nettop -P -d    |   bandwhich (需 sudo)")"; fi
}

cmd_proxy() {
  hdr "$(L "System proxy (scutil --proxy)" "系统代理 (scutil --proxy)")"; scutil --proxy
  hdr "$(L "Environment-variable proxy" "环境变量代理")"; env | grep -i -E '^(https?|all|no)_proxy=' || echo "$(L "  (none)" "  (无)")"
  hdr "$(L "VPN / tunnel interfaces" "VPN/隧道网卡")"; ifconfig | awk '/^(utun|ppp|ipsec|tun|tap)[0-9]*:/{print $1}'
  hdr "$(L "Configured VPN services" "已配置的 VPN 服务")"; scutil --nc list 2>/dev/null
  hdr "$(L "Per-service proxy (networksetup)" "各网络服务代理 (networksetup)")"
  networksetup -listallnetworkservices 2>/dev/null | tail -n +2 | grep -v '^\*' | while read -r s; do
    echo "- $s: $(networksetup -getwebproxy "$s" | tr '\n' ' ')"
  done
}

cmd_capture() {
  local f=${1:-}; local out="$HOME/Desktop/cap-$(date +%Y%m%d-%H%M%S).pcap"
  can_priv || { need_admin capture; return 1; }
  echo "$(L "Capturing → $out  (Ctrl-C to stop; open with Wireshark)" "抓包 → $out  (Ctrl-C 结束; 用 Wireshark 打开)")"
  echo "$(L "Filter examples: 'host 1.2.3.4'  'port 53'  'tcp port 443 and host x.com'" "过滤器示例: 'host 1.2.3.4'  'port 53'  'tcp port 443 and host x.com'")"
  if [ -n "$f" ]; then priv tcpdump -i "$(default_if)" -nn -s0 -w "$out" "$f"; else priv tcpdump -i "$(default_if)" -nn -s0 -w "$out"; fi
}

cmd_fixdns() {
  can_priv || { need_admin fixdns; return 1; }
  if priv dscacheutil -flushcache && priv killall -HUP mDNSResponder; then ok "$(L "DNS cache flushed" "DNS 缓存已刷新")"
  else bad "$(L "Flushing the DNS cache failed (wrong password or no admin rights)" "刷新 DNS 缓存失败 (密码错误或没有管理员权限)")"; return 1; fi
}

cmd_tools() {
  hdr "$(L "Built-in" "系统自带")"
  for t in ping traceroute netstat lsof nc curl dig scutil networksetup route tcpdump nettop networkQuality wdutil ifconfig arp dscacheutil system_profiler; do
    has "$t" && ok "$t" || warn "$(L "$t missing" "$t 缺失")"; done
  hdr "$(L "Third-party (brew bundle --file=Brewfile)" "第三方 (brew bundle --file=Brewfile)")"
  for t in mtr iperf3 fping nmap gping trip doggo http tshark termshark ngrep bandwhich iftop testssl speedtest-cli jq; do
    has "$t" && ok "$t" || warn "$(L "$t not installed" "$t 未安装")"; done
}

# 转义成 sed -E 里的字面量
re_escape() { printf '%s' "$1" | sed 's/[][\.*^$/&|(){}+?]/\\&/g'; }

# 报告脱敏: 从标准输入读, 把个人信息换成占位符写到标准输出。
# 隐藏: 公网 IP、全局 IPv6、MAC、Wi-Fi 名称 / BSSID、主机名、搜索域、用户名路径、VPN 隧道地址。
# 保留: 局域网私有地址、网关、公共 DNS 的地址、延迟 / 丢包等诊断数据 (这些发给别人才有用)。
redact_filter() {
  local h hs u rules=()
  h=$(hostname 2>/dev/null); hs=$(hostname -s 2>/dev/null); u=$(id -un 2>/dev/null)
  [ -n "$h" ]  && rules+=(-e "s/$(re_escape "$h")/<hostname>/g")
  [ -n "$hs" ] && rules+=(-e "s/$(re_escape "$hs")/<hostname>/g")
  [ -n "$u" ]  && rules+=(-e "s#/Users/$(re_escape "$u")#/Users/<user>#g")
  # 报告时现取的确切值 (公网 IPv4 / IPv6、Wi-Fi 名称): 不管它们出现在哪一行、什么格式, 都整体替换。
  # 太短的值 (< 3 个字符) 会误伤普通文字, 不处理。
  local lit
  while IFS= read -r lit; do
    [ "${#lit}" -ge 3 ] && rules+=(-e "s/$(re_escape "$lit")/<redacted>/g")
  done <<EOF
${REDACT_LITERALS:-}
EOF
  rules+=(
    -e 's/([0-9A-Fa-f]{1,2}:){5}[0-9A-Fa-f]{1,2}/xx:xx:xx:xx:xx:xx/g'
    -e 's/[A-Za-z0-9-]+\.ts\.net/<tailnet-host>/g'
    -e 's/^( *(Public IP|公网 IP): )\{.*/\1<redacted>/'      # 没装 jq 时是原始 JSON (含城市 / 运营商 / 经纬度)
    -e 's/^( *(Public IP|公网 IP): )[^ ]+/\1<redacted>/'
    -e 's/^ *\{.*"ip".*$/   <redacted>/'
    -e 's/^( *IPv6: ).*/\1<redacted>/'
    -e 's/^( *(Search domains|搜索域): ).*/\1<redacted>/'
    -e 's/^( *(Search domain|搜索域) +)[^ ].*/\1<redacted>/'
    -e 's/^( *(search domain\[[0-9]+\]|domain) *: ).*/\1<redacted>/'
    -e 's/(\] IPv[46]  )[^ ]+/\1<redacted>/'
    -e 's/^   ([0-9]{1,3}\.){3}[0-9]{1,3}(  .*)$/   <redacted>\2/'
    -e 's/^   ([0-9A-Fa-f]{1,4}:){2,}[0-9A-Fa-f:]*$/   <redacted>/'
    -e 's/^   ([0-9A-Fa-f]{1,4}:){2,}[0-9A-Fa-f:]*(  .*)$/   <redacted>\2/'
    -e 's/(inet6 )(f[cd][0-9A-Fa-f:]*|[23][0-9A-Fa-f:]*)/\1<redacted>/'
    -e 's/(inet6 )fe80[0-9A-Fa-f:]*/\1fe80::<redacted>/'   # 老式 EUI-64 的链路本地地址由 MAC 推导, 会间接泄漏 MAC
    -e 's/(Current Wi-Fi Network: ).*/\1<redacted>/'
    -e 's/^( *B?SSID *:).*/\1 <redacted>/'
    -e 's/((utun|ppp|ipsec|tun|tap)[0-9]+)=[0-9.]+/\1=<redacted>/g'
  )
  sed -E "${rules[@]}"
}

cmd_report() {
  local NETDOCTOR_NOSUDO=1   # 输出被重定向到文件, 不要在中途弹出 sudo 密码提示
  local B= G= R= Y= N=       # 报告是纯文本文件: 即使网页 / App 设了 NETDOCTOR_COLOR=1, 也不能把颜色转义码写进去 (动态作用域, 下面调用的函数也生效)
  local redact=0; case "${1:-}" in redact|--redact) redact=1;; esac
  local dir="$HOME/Desktop"; [ -d "$dir" ] && [ -w "$dir" ] || dir="$HOME"   # 没有桌面目录 (或不可写) 就存到主目录
  local f="$dir/netdoctor-report-$(date +%Y%m%d-%H%M%S).txt" gen
  gen=$(mktemp) || { bad "$(L "Could not create a temporary file" "无法创建临时文件")"; return 1; }
  if [ "$redact" = 1 ]; then
    local ssid v; REDACT_LITERALS=""
    ssid=$(networksetup -getairportnetwork "$(wifi_if)" 2>/dev/null | sed -n 's/^Current Wi-Fi Network: //p' | head -1)   # 只认这个前缀: 其他输出是错误提示, 不是 SSID
    [ -n "$ssid" ] && REDACT_LITERALS="$ssid"
    for v in "$(curl -4 -s -m 5 https://api.ip.sb/ip 2>/dev/null)" "$(curl -6 -s -m 5 https://api.ip.sb/ip 2>/dev/null)"; do
      case "$v" in ""|*[!0-9A-Fa-f.:]*) ;; *) REDACT_LITERALS="$REDACT_LITERALS
$v";; esac
    done
  fi
  { echo "netdoctor report $(date)"; uname -a; sw_vers
    cmd_doctor; cmd_overview; cmd_dhcp; cmd_quick; cmd_wifi; cmd_dns apple.com; cmd_ipv6; cmd_proxy; } >"$gen" 2>&1
  if [ "$redact" = 1 ]; then
    { echo "# $(L "Personal info hidden (public IP, MAC, Wi-Fi name, host name, search domains)" "已隐藏个人信息 (公网 IP、MAC、Wi-Fi 名称、主机名、搜索域)")"; redact_filter <"$gen"; } >"$f"
  else
    cat "$gen" >"$f"
  fi
  rm -f "$gen"
  if [ ! -s "$f" ]; then bad "$(L "Could not write the report to $f" "无法写入报告: $f")"; return 1; fi
  ok "$(L "Saved: $f" "已保存: $f")"
  if [ "$redact" = 1 ]; then
    warn "$(L "Personal info was hidden; skim the report once before you share it anyway." "已隐藏个人信息; 分享前仍请快速浏览一遍。")"
  else
    warn "$(L "The report contains your IP addresses, MAC address and Wi-Fi name; check it before you share it (netdoctor report redact hides them)." "报告包含你的 IP 地址、MAC 地址和 Wi-Fi 名称, 分享给别人前请先检查 (netdoctor report redact 可自动隐藏)。")"
  fi
}

# 被当作函数库 source 进来 (自动化测试用): NETDOCTOR_SOURCE_ONLY=1 . ./netdoctor ——只定义函数, 不执行命令分发
[ -n "${NETDOCTOR_SOURCE_ONLY:-}" ] && { return 0 2>/dev/null || exit 0; }

c=${1:-help}; [ $# -gt 0 ] && shift
case "$c" in
  quick|q) cmd_quick;; doctor|diagnose) cmd_doctor;; tcpping) cmd_tcpping "$@";; overview) cmd_overview;; dhcp) cmd_dhcp;; ports) cmd_ports "$@";; dnsbench) cmd_dnsbench "$@";; lan) cmd_lan;; ipv6) cmd_ipv6;; captive) cmd_captive;; wifi) cmd_wifi;; dns) cmd_dns "$@";; route) cmd_route "$@";;
  ping) cmd_ping "$@";; port) cmd_port "$@";; http) cmd_http "$@";; tls) cmd_tls "$@";;
  mtu) cmd_mtu "$@";; speed) cmd_speed;; conns) cmd_conns;; proxy) cmd_proxy;;
  capture) cmd_capture "$@";; fixdns) cmd_fixdns;; report) cmd_report "$@";; tools) cmd_tools;;
  version|-v|--version) echo "netdoctor $VERSION";;
  help|-h|--help) usage;;
  *) warn "$(L "Unknown command: $c (this is netdoctor $VERSION; if the command is in the README, update with: git pull)" "未知命令: $c (当前是 netdoctor $VERSION; 如果 README 里有这个命令, 请先更新: git pull)")"; usage; exit 2;;
esac
